			9
		)

	boxCorner.Parent =
		box

	local value =
		initial

	local function Apply(raw)

		local number =
			tonumber(raw)

		if not number then

			box.Text =
				tostring(value)

			return
		end

		number =
			math.clamp(
				number,
				minimum,
				maximum
			)

		if step
			and step > 0 then

			number =
				math.round(
					number / step
				) * step
		end

		value =
			number

		box.Text =
			tostring(number)

		if callback then
			callback(number)
		end
	end

	box.FocusLost:Connect(
		function()

			Apply(
				box.Text
			)
		end
	)

	return box, Apply
