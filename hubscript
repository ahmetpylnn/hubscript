Calistirici.RenderStepped:Connect(
	function()

		if not AnaPanel
			or not AnaPanel.Visible then

			return
		end

		local kamera =
			Dunya.CurrentCamera

		if not kamera then
			return
		end

		local viewport =
			kamera.ViewportSize

		local genislik =
			AnaPanel.AbsoluteSize.X

		local yukseklik =
			AnaPanel.AbsoluteSize.Y

		local x =
			AnaPanel.Position.X.Offset

		local y =
			AnaPanel.Position.Y.Offset

		local yeniX =
			math.clamp(
				x,
				5,
				math.max(
					5,
					viewport.X -
					genislik -
					5
				)
			)

		local yeniY =
			math.clamp(
				y,
				5,
				math.max(
					5,
					viewport.Y -
					yukseklik -
					5
				)
			)

		if x ~= yeniX
			or y ~= yeniY then

			AnaPanel.Position =
				UDim2.fromOffset(
					yeniX,
					yeniY
				)
		end
	end
)

