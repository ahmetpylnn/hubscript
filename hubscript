--============================================================
-- TELEPORT
--============================================================

local function MouseaIşınlan(
	mouseKonum
)

	if not Karakter
		or not Karakter.Parent
		or not Govde
		or not Govde.Parent then

		KarakterReferanslariniYenile()
	end

	if not Karakter
		or not Govde then

		DurumGuncelle(
			"Teleport • Karakter hazır değil."
		)

		return
	end

	local kamera =
		Dunya.CurrentCamera

	if not kamera then
		return
	end

	-- GetMouseLocation / Viewport farkını gider
	local guiInce,
		ustInce =
		ArayuzHizmeti:GetGuiInset()

	local viewportX =
		mouseKonum.X -
		guiInce.X

	local viewportY =
		mouseKonum.Y -
		guiInce.Y

	local isin =
		kamera:ViewportPointToRay(
			viewportX,
			viewportY,
			0
		)

	local parametre =
		RaycastParams.new()

	parametre.FilterType =
		Enum.RaycastFilterType.Exclude

	parametre.FilterDescendantsInstances = {
		Karakter
	}

	parametre.IgnoreWater =
		true

	local sonuc =
		Dunya:Raycast(
			isin.Origin,
			isin.Direction *
				AYAR.TELEPORT_MESAFE,
			parametre
		)

	if not sonuc then

		DurumGuncelle(
			"Teleport • Yüzey bulunamadı."
		)

		return
	end

	-- Yüzeyin üstüne güvenli çıkış
	local hedefKonum =
		sonuc.Position

	if sonuc.Normal.Y >= 0.6 then

		hedefKonum +=
			Vector3.new(
				0,
				AYAR.TELEPORT_YUKSEKLIK,
				0
			)

	else

		hedefKonum +=
			sonuc.Normal *
			math.max(
				AYAR.TELEPORT_YUKSEKLIK,
				1
			)
	end

	-- Eski hızı sıfırla
	Govde.AssemblyLinearVelocity =
		Vector3.zero

	Govde.AssemblyAngularVelocity =
		Vector3.zero

	-- Mevcut yönü mümkün olduğunca koru
	local bakis =
		Govde.CFrame.LookVector

	local yatayBakis =
		Vector3.new(
			bakis.X,
			0,
			bakis.Z
		)

	if yatayBakis.Magnitude <
		0.001 then

		yatayBakis =
			Vector3.new(
				0,
				0,
				-1
			)
	else

		yatayBakis =
			yatayBakis.Unit
	end

	Karakter:PivotTo(
		CFrame.lookAt(
			hedefKonum,
			hedefKonum +
				yatayBakis
		)
	)

	-- Fizik artık hız vermesin
	Govde.AssemblyLinearVelocity =
		Vector3.zero

	Govde.AssemblyAngularVelocity =
		Vector3.zero

	DurumGuncelle(
		"Teleport başarılı • " ..
		math.floor(
			hedefKonum.X
		) ..
		", " ..
		math.floor(
			hedefKonum.Y
		) ..
		", " ..
		math.floor(
			hedefKonum.Z
		)
	)
end

