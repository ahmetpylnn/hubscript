--============================================================

function V31:ClearCache()
    if self.State.Scanning then
        self.State.Scanning = false
    end

    table.clear(self.Cache.Entries)
    self.Cache.Queue = {}
    self.Cache.QueueIndex = 1
    self.Cache.DirtyQueue = {}
    self.Cache.DirtyIndex = 1
    self.Cache.Dirty = setmetatable({}, { __mode = "k" })
    self.Cache.Queued = setmetatable({}, { __mode = "k" })

    for key in pairs(self.Cache.Counts) do
        self.Cache.Counts[key] = 0
    end

    self.State.CacheCount = 0
    self.State.ScanProgress = 0
    self.State.ScanComplete = false
end

--============================================================
-- PERFORMANCE PRESETS
--============================================================

function V31:ApplyPerformancePreset(mode)
    if mode == "LOW" then
        self.Config.WorldScan.InitialBudget = 120
        self.Config.WorldScan.MinBudget = 40
        self.Config.WorldScan.MaxBudget = 300
        self.Config.ESP.UpdateRate = 10
        self.Config.WorldScan.KeepRemovedEntries = false
        self.Config.ESP.Skeleton = false
        self.Config.ESP.Tracer = false

    elseif mode == "HIGH" then
        self.Config.WorldScan.InitialBudget = 450
        self.Config.WorldScan.MinBudget = 100
        self.Config.WorldScan.MaxBudget = 1200
        self.Config.ESP.UpdateRate = 30
        self.Config.WorldScan.KeepRemovedEntries = false

    else
        self.Config.WorldScan.InitialBudget = 300
        self.Config.WorldScan.MinBudget = 60
        self.Config.WorldScan.MaxBudget = 1000
        self.Config.ESP.UpdateRate = 20
        self.Config.WorldScan.KeepRemovedEntries = false
    end

    self.State.ScanBudget = self.Config.WorldScan.InitialBudget
end

