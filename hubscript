local function AyniTakimMi(
	oyuncu
)

	if not AYAR.TAKIM_KONTROLU then
		return false
	end

	if not YerelOyuncu.Team then
		return false
	end

	if not oyuncu.Team then
		return false
	end

	return YerelOyuncu.Team ==
		oyuncu.Team
end

--============================================================
-- MESAFE
--============================================================

local function MesafeAl(
	pozisyon
)

	if not Govde then
		return math.huge
	end

	return (
		Govde.Position -
		pozisyon
	).Magnitude
end

--============================================================
-- EKRAN MESAFESI
--============================================================

local function EkranMesafesiAl(
	parca
)

	local kamera =
		Dunya.CurrentCamera

	if not kamera
		or not parca then

		return math.huge,
			false
	end

	local nokta,
		ekranda =
		kamera:WorldToViewportPoint(
			parca.Position
		)

	if nokta.Z <= 0 then
		return math.huge,
			false
	end

	local merkez =
		kamera.ViewportSize / 2

	local fark =
		(
			Vector2.new(
				nokta.X,
				nokta.Y
			) -
			merkez
		).Magnitude

	return fark,
		ekranda
end

--============================================================
-- GORUS HATTI
--============================================================

local function GorunurMu(
	oyuncu,
	parca
)

	if not AYAR.GORUS_KONTROLU then
		return true
	end

	local kamera =
		Dunya.CurrentCamera

	if not kamera
		or not parca then

		return false
	end

	local karakter =
		KarakterAl(
			oyuncu
		)

	if not karakter then
		return false
	end

	local yon =
		parca.Position -
		kamera.CFrame.Position

	if yon.Magnitude <= 0.001 then
		return true
	end

	local parametre =
		RaycastParams.new()

	parametre.FilterType =
		Enum.RaycastFilterType.Exclude

	parametre.FilterDescendantsInstances = {
		Karakter,
		karakter,
	}

	parametre.IgnoreWater =
		true

	local sonuc =
		Dunya:Raycast(
			kamera.CFrame.Position,
			yon,
			parametre
		)

	if not sonuc then
		return true
	end

	return sonuc.Instance:IsDescendantOf(
		karakter
	)
end

--============================================================
-- AIM HEDEF GECERLI
--============================================================

local function AimHedefGecerli(
	oyuncu,
	parca
)

	if not oyuncu
		or not parca then

		return false
	end

	if not YasiyorMu(oyuncu) then
		return false
	end

	if AyniTakimMi(oyuncu) then
		return false
	end

	if not parca.Parent then
		return false
	end

	if not Govde then
		return false
	end

	local mesafe =
		MesafeAl(
			parca.Position
		)

	if mesafe >
		AYAR.AIM_MESAFE then

		return false
	end

	if AYAR.AIM_FOV > 0 then

		local ekranMesafesi,
			ekranda =
			EkranMesafesiAl(
				parca
			)

		if not ekranda then
			return false
		end

		if ekranMesafesi >
			AYAR.AIM_FOV then

			return false
		end
	end

	if not GorunurMu(
		oyuncu,
		parca
	) then

		return false
	end

	return true
end

--============================================================
-- EN IYI HEDEF
--============================================================

local function EnIyiHedefiBul()

	if not Govde then
		return nil, nil
	end

	local enIyiOyuncu = nil
	local enIyiParca = nil

	local enIyiMesafe =
		math.huge

	local enIyiEkran =
		math.huge

	local kamera =
		Dunya.CurrentCamera

	for _, oyuncu in ipairs(
		Oyuncular:GetPlayers()
	) do

		if oyuncu ~=
			YerelOyuncu then

			local parca =
				AimParcasiAl(
					oyuncu
				)

			if parca
				and AimHedefGecerli(
					oyuncu,
					parca
				) then

				local mesafe =
					MesafeAl(
						parca.Position
					)

				local ekranMesafesi =
					math.huge

				if kamera then

					ekranMesafesi =
						EkranMesafesiAl(
							parca
						)
				end

				if AYAR.AIM_MODU ==
					"Ekran Merkezi" then

					if ekranMesafesi <
						enIyiEkran then

						enIyiEkran =
							ekranMesafesi

						enIyiMesafe =
							mesafe

						enIyiOyuncu =
							oyuncu

						enIyiParca =
							parca
					end

				else

					if mesafe <
						enIyiMesafe then

						enIyiMesafe =
							mesafe

						enIyiEkran =
							ekranMesafesi

						enIyiOyuncu =
							oyuncu

						enIyiParca =
							parca
					end
				end
			end
		end
	end

	return enIyiOyuncu,
		enIyiParca
end

