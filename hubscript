local function StopGod()

	if GodConnection then

		GodConnection:Disconnect()

		GodConnection = nil
	end
end

local function RestoreCollision()

	for part, oldValue in pairs(
		CollisionMemory
	) do

		if part
			and part.Parent then

			part.CanCollide =
				oldValue
		end
	end

	table.clear(
		CollisionMemory
	)
end

local function StopFly()

	if FlyVelocity then

		SafeDestroy(
			FlyVelocity
		)

		FlyVelocity = nil
	end

	if FlyOrientation then

		SafeDestroy(
			FlyOrientation
		)

		FlyOrientation = nil
	end

	if FlyAttachment then

		SafeDestroy(
			FlyAttachment
		)

		FlyAttachment = nil
	end

	if Humanoid then

		Humanoid.AutoRotate =
			OriginalAutoRotate
	end
end

