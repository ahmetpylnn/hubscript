--============================================================
-- AIM LOOP
--============================================================

Calistirici:BindToRenderStep(
	"OyuncuKontrol_Aim",
	Enum.RenderPriority.Camera.Value + 50,
	function(deltaTime)

		if not Durum.Aim then

			FovGuncelle()

			return
		end

		local kamera =
			Dunya.CurrentCamera

		if not kamera
			or not Govde then

			return
		end

		AimSayaci +=
			deltaTime

		AimTaramaSayaci +=
			deltaTime

		AimKontrolSayaci +=
			deltaTime

		--====================================================
		-- MEVCUT HEDEF
		--====================================================

		if AimHedefi
			and AimParcasi
			and AimKontrolSayaci >=
				0.03 then

			AimKontrolSayaci =
				0

			local yeniParca =
				AimParcasiAl(
					AimHedefi
				)

			if yeniParca
				and AimHedefGecerli(
					AimHedefi,
					yeniParca
				) then

				AimParcasi =
					yeniParca

			else

				AimTemizle()
			end
		end

		--====================================================
		-- YENI HEDEF
		--====================================================

		if not AimHedefi
			or not AimParcasi
			or AimTaramaSayaci >=
				AYAR.AIM_DEGISIM then

			AimTaramaSayaci =
				0

			local oyuncu,
				parca =
				EnIyiHedefiBul()

			if oyuncu
				and parca then

				AimHedefi =
					oyuncu

				AimParcasi =
					parca

				AimSayaci =
					0

			else

				AimTemizle()

				DurumGuncelle(
					"Aim aktif • Uygun oyuncu bulunamadi.",
					0.5
				)

				return
			end
		end

		if not AimHedefi
			or not AimParcasi then

			return
		end

		--====================================================
		-- HEDEF POZISYONU
		--====================================================

		local hedefKonum =
			TahminliPozisyon(
				AimParcasi
			)

		if not hedefKonum then
			return
		end

		hedefKonum +=
			Vector3.new(
				0,
				AYAR.AIM_YUKSEKLIK,
				0
			)

		--====================================================
		-- KAMERA
		--====================================================

		local kameraKonum =
			kamera.CFrame.Position

		local fark =
			hedefKonum -
			kameraKonum

		if fark.Magnitude <=
			0.001 then

			return
		end

		local hedefCFrame =
			CFrame.lookAt(
				kameraKonum,
				hedefKonum
			)

		local yumusaklik =
			math.clamp(
				AYAR.AIM_YUMUSAKLIK,
				0.01,
				1
			)

		if yumusaklik >= 1 then

			kamera.CFrame =
				hedefCFrame

		else

			local alpha =
				math.clamp(
					yumusaklik *
					12 *
					deltaTime,
					0,
					1
				)

			kamera.CFrame =
				kamera.CFrame:Lerp(
					hedefCFrame,
					alpha
				)
		end

		--====================================================
		-- STATUS
		--====================================================

		local mesafe =
			math.floor(
				MesafeAl(
					AimParcasi.Position
				)
			)

		DurumGuncelle(
			"AIM AKTIF  •  " ..
			AimHedefi.Name ..
			"  •  " ..
			tostring(
				mesafe
			) ..
			" studs"
		)

		FovGuncelle()
	end
)

--============================================================
-- FLY LOOP
--============================================================

Calistirici:BindToRenderStep(
	"OyuncuKontrol_Fly",
	Enum.RenderPriority.Character.Value + 10,
	function()

		if not Durum.Fly then
			return
		end

		if not Govde
			or not Govde.Parent then

			return
		end

		if not FlyHiz
			or not FlyYon then

			if not FlyBaslat() then
				return
			end
		end

		local kamera =
			Dunya.CurrentCamera

		if not kamera then
			return
		end

		local yon =
			Vector3.zero

		if Giris:IsKeyDown(
			Enum.KeyCode.W
		) then

			yon +=
				kamera.CFrame.LookVector
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.S
		) then

			yon -=
				kamera.CFrame.LookVector
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.A
		) then

			yon -=
				kamera.CFrame.RightVector
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.D
		) then

			yon +=
				kamera.CFrame.RightVector
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.Space
		) then

			yon +=
				Vector3.yAxis
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.LeftShift
		)
		or
		Giris:IsKeyDown(
			Enum.KeyCode.RightShift
		) then

			yon -=
				Vector3.yAxis
		end

		if yon.Magnitude > 0 then

			yon =
				yon.Unit
		end

		FlyHiz.VectorVelocity =
			yon *
			AYAR.UCUS_HIZI

		local bakis =
			kamera.CFrame.LookVector

		local yatay =
			Vector3.new(
				bakis.X,
				0,
				bakis.Z
			)

		if yatay.Magnitude >
			0.001 then

			yatay =
				yatay.Unit

			FlyYon.CFrame =
				CFrame.lookAt(
					Vector3.zero,
					yatay
				)
		end
	end
)

