-- FLY RENDER
--============================================================

Calistirici:BindToRenderStep(
	"OyuncuKontrol_Fly",
	Enum.RenderPriority.Character.Value + 10,
	function()

		if not Durum.Fly then
			return
		end

		if not Govde
			or not Govde.Parent then

			return
		end

		if not FlyHiz
			or not FlyYon then

			if not FlyBaslat() then
				return
			end
		end

		local kamera =
			Dunya.CurrentCamera

		if not kamera then
			return
		end

		local yon =
			Vector3.zero

		if Giris:IsKeyDown(
			Enum.KeyCode.W
		) then

			yon +=
				kamera.CFrame.LookVector
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.S
		) then

			yon -=
				kamera.CFrame.LookVector
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.A
		) then

			yon -=
				kamera.CFrame.RightVector
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.D
		) then

			yon +=
				kamera.CFrame.RightVector
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.Space
		) then

			yon +=
				Vector3.yAxis
		end

		if Giris:IsKeyDown(
			Enum.KeyCode.LeftShift
		)
		or Giris:IsKeyDown(
			Enum.KeyCode.RightShift
		) then

			yon -=
				Vector3.yAxis
		end

		if yon.Magnitude > 0 then

			yon =
				yon.Unit
		end

		FlyHiz.VectorVelocity =
			yon *
			AYAR.UCUS_HIZI

		local bakis =
			kamera.CFrame.LookVector

		local yatay =
			Vector3.new(
				bakis.X,
				0,
				bakis.Z
			)

		if yatay.Magnitude >
			0.001 then

			yatay =
				yatay.Unit

			FlyYon.CFrame =
				CFrame.lookAt(
					Vector3.zero,
					yatay
				)
		end
	end
)

