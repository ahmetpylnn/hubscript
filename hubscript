--============================================================

local function KarakterAl(
	oyuncu
)

	if not oyuncu then
		return nil
	end

	local karakter =
		oyuncu.Character

	if not karakter then
		return nil
	end

	if not karakter.Parent then
		return nil
	end

	return karakter
end

--============================================================
-- HUMANOID AL
--============================================================

local function HumanoidAl(
	oyuncu
)

	local karakter =
		KarakterAl(
			oyuncu
		)

	if not karakter then
		return nil
	end

	return karakter:FindFirstChildOfClass(
		"Humanoid"
	)
end

--============================================================
-- ROOT AL
--============================================================

local function GovdeAl(
	oyuncu
)

	local karakter =
		KarakterAl(
			oyuncu
		)

	if not karakter then
		return nil
	end

	local govde =
		karakter:FindFirstChild(
			"HumanoidRootPart"
		)

	if govde
		and govde:IsA("BasePart") then

		return govde
	end

	return nil
end

--============================================================
-- AIM PARCASI AL
--============================================================

local function AimParcasiAl(
	oyuncu
)

	local karakter =
		KarakterAl(
			oyuncu
		)

	if not karakter then
		return nil
	end

	local tercih =
		karakter:FindFirstChild(
			AYAR.AIM_PARCA
		)

	if tercih
		and tercih:IsA("BasePart") then

		return tercih
	end

	local yedekler = {

		"Head",
		"HumanoidRootPart",
		"UpperTorso",
		"Torso",
		"LowerTorso",
	}

	for _, ad in ipairs(
		yedekler
	) do

		local parca =
			karakter:FindFirstChild(
				ad
			)

		if parca
			and parca:IsA("BasePart") then

			return parca
		end
	end

	return karakter:FindFirstChildWhichIsA(
		"BasePart",
		true
	)
end

--============================================================
-- YASIYOR MU
--============================================================

local function YasiyorMu(
	oyuncu
)

	if not oyuncu then
		return false
	end

	if oyuncu ==
		YerelOyuncu then

		return false
	end

	local humanoid =
		HumanoidAl(
			oyuncu
		)

	local parca =
		AimParcasiAl(
			oyuncu
		)

	if not humanoid
		or not parca then

		return false
	end

	return humanoid.Health > 0
end

