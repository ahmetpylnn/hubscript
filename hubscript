--============================================================
-- SAFE HELPERS
--============================================================

local function V31Safe(fn, fallback)
    local ok, result = pcall(fn)
    if ok then
        return result
    end
    return fallback
end

local function V31Destroy(instance)
    if instance then
        pcall(function()
            instance:Destroy()
        end)
    end
end

local function V31Clamp(value, minimum, maximum)
    return math.clamp(value, minimum, maximum)
end

local function V31IsAliveHumanoid(humanoid)
    return humanoid and humanoid.Parent and humanoid.Health > 0
end

local function V31GetCharacter(player)
    if not player then
        return nil
    end
    local character = player.Character
    if character and character.Parent then
        return character
    end
    return nil
end

local function V31GetHumanoid(model)
    if not model then
        return nil
    end
    if model:IsA("Humanoid") then
        return model
    end
    if model:IsA("Model") then
        return model:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

local function V31GetRoot(model)
    if not model then
        return nil
    end

    local preferred = {
        "HumanoidRootPart",
        "PrimaryPart",
        "UpperTorso",
        "Torso",
        "Head",
    }

    for _, name in ipairs(preferred) do
        local part = model:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then
            return part
        end
    end

    if model:IsA("Model") and model.PrimaryPart then
        return model.PrimaryPart
    end

    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function V31GetAimPart(model)
    if not model then
        return nil
    end

    local preference = V31.Config.Aim.Part
    local names

    if preference == "Head" then
        names = { "Head", "UpperTorso", "HumanoidRootPart", "Torso", "LowerTorso" }
    elseif preference == "Torso" then
        names = { "UpperTorso", "Torso", "HumanoidRootPart", "Head", "LowerTorso" }
    else
        names = { "HumanoidRootPart", "UpperTorso", "Torso", "Head", "LowerTorso" }
    end

    for _, name in ipairs(names) do
        local part = model:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then
            return part
        end
    end

    return V31GetRoot(model)
end

local function V31GetLocalRoot()
    if not Karakter or not Karakter.Parent then
        return nil
    end
    if Govde and Govde.Parent then
        return Govde
    end
    return V31GetRoot(Karakter)
end

local function V31DistanceTo(position)
    local root = V31GetLocalRoot()
    if not root then
        return math.huge
    end
    return (root.Position - position).Magnitude
end

local function V31NameMatches(name)
    if type(name) ~= "string" then
        return false
    end
    local lower = string.lower(name)
    local keywords = {
        "target", "enemy", "boss", "monster", "mob", "npc", "dummy",
        "zombie", "bot", "loot", "item", "crate", "chest", "objective",
        "goal", "capture", "flag", "coin", "pickup", "collectible", "training",
    }
    for _, keyword in ipairs(keywords) do
        if string.find(lower, keyword, 1, true) then
            return true
        end
    end
    return false
end

local function V31HasTag(instance, tag)
    return V31Safe(function()
        return V31Collection:HasTag(instance, tag)
    end, false)
end

local function V31HasAttribute(instance, names)
    if not instance then
        return false
    end
    for _, name in ipairs(names) do
        local value = V31Safe(function()
            return instance:GetAttribute(name)
        end, nil)
        if value == true then
            return true
        end
    end
    return false
end

local function V31IsPlayerCharacter(instance)
    if not instance then
        return false
    end
    for _, player in ipairs(V31Players:GetPlayers()) do
        if player.Character == instance then
            return true
        end
    end
    return false
end

--============================================================
-- CACHE CLASSIFICATION
--============================================================

function V31:Classify(instance)
    if not instance then
        return nil
    end

    local meta = {
        Instance = instance,
        Name = instance.Name,
        ClassName = instance.ClassName,
        Type = "Other",
        Part = nil,
        Humanoid = nil,
        Player = nil,
        Team = nil,
        Alive = true,
        Position = nil,
    }

    if instance:IsA("BasePart") then
        meta.Type = "Part"
        meta.Part = instance
        meta.Position = instance.Position
    elseif instance:IsA("Model") then
        meta.Type = "Model"
        meta.Part = V31GetRoot(instance)
        meta.Humanoid = V31GetHumanoid(instance)
        if meta.Humanoid then
            meta.Type = "NPC"
            meta.Alive = meta.Humanoid.Health > 0
        end
        local pivot = V31Safe(function()
            return instance:GetPivot()
        end, nil)
        if pivot then
            meta.Position = pivot.Position
        end
    end

    if V31IsPlayerCharacter(instance) then
        meta.Type = "PlayerCharacter"
        for _, player in ipairs(V31Players:GetPlayers()) do
            if player.Character == instance then
                meta.Player = player
                meta.Team = player.Team
                meta.Alive = V31IsAliveHumanoid(meta.Humanoid)
                break
            end
        end
    end

    if instance:IsA("Tool") then
        meta.Type = "Tool"
    end

    local loot = V31HasTag(instance, "Loot")
        or V31HasAttribute(instance, { "Loot", "IsLoot", "Collectible" })

    local objective = V31HasTag(instance, "Objective")
        or V31HasAttribute(instance, { "Objective", "IsObjective", "Goal" })

    local targetable = V31HasTag(instance, "AimTarget")
        or V31HasAttribute(instance, { "AimTarget", "Targetable", "Target" })

    if loot then
        meta.Type = "Loot"
    elseif objective then
        meta.Type = "Objective"
    elseif targetable then
        meta.Type = "TargetObject"
    elseif (meta.Type == "Part" or meta.Type == "Model" or meta.Type == "Other")
        and V31NameMatches(instance.Name)
        and not V31IsPlayerCharacter(instance) then
        meta.Type = "NamedObject"
    end

    return meta
end

--============================================================
-- CACHE INDEXING
--============================================================

local function V31IncrementType(typeName)
    if typeName == "PlayerCharacter" then
        V31.Cache.Counts.Players += 1
    elseif typeName == "NPC" then
        V31.Cache.Counts.NPCs += 1
    elseif typeName == "Loot" then
        V31.Cache.Counts.Loot += 1
    elseif typeName == "Objective" then
        V31.Cache.Counts.Objectives += 1
    elseif typeName == "TargetObject" or typeName == "NamedObject" then
        V31.Cache.Counts.Targets += 1
    elseif typeName == "Tool" then
        V31.Cache.Counts.Tools += 1
    elseif typeName == "Folder" then
        V31.Cache.Counts.Folders += 1
    end
end

local function V31DecrementMeta(meta)
    if not meta then
        return
    end

    if meta.ClassName == "Part"
        or meta.Instance:IsA("BasePart") then
        V31.Cache.Counts.BaseParts = math.max(0, V31.Cache.Counts.BaseParts - 1)
    end

    if meta.Instance:IsA("Model") then
        V31.Cache.Counts.Models = math.max(0, V31.Cache.Counts.Models - 1)
    end

    if meta.Humanoid then
        V31.Cache.Counts.Humanoids = math.max(0, V31.Cache.Counts.Humanoids - 1)
    end

    if meta.Type == "PlayerCharacter" then
        V31.Cache.Counts.Players = math.max(0, V31.Cache.Counts.Players - 1)
    elseif meta.Type == "NPC" then
        V31.Cache.Counts.NPCs = math.max(0, V31.Cache.Counts.NPCs - 1)
    elseif meta.Type == "Loot" then
        V31.Cache.Counts.Loot = math.max(0, V31.Cache.Counts.Loot - 1)
    elseif meta.Type == "Objective" then
        V31.Cache.Counts.Objectives = math.max(0, V31.Cache.Counts.Objectives - 1)
    elseif meta.Type == "TargetObject" or meta.Type == "NamedObject" then
        V31.Cache.Counts.Targets = math.max(0, V31.Cache.Counts.Targets - 1)
    elseif meta.Type == "Tool" then
        V31.Cache.Counts.Tools = math.max(0, V31.Cache.Counts.Tools - 1)
    elseif meta.Type == "Folder" then
        V31.Cache.Counts.Folders = math.max(0, V31.Cache.Counts.Folders - 1)
    end
end

function V31:Index(instance)
    if not instance then
        return nil
    end

    local existing = self.Cache.Entries[instance]
    if existing then
        return existing
    end

    local meta = self:Classify(instance)
    if not meta then
        return nil
    end

    self.Cache.Entries[instance] = meta
    self.Cache.Counts.Total += 1

    if instance:IsA("BasePart") then
        self.Cache.Counts.BaseParts += 1
    end

    if instance:IsA("Model") then
        self.Cache.Counts.Models += 1
    end

    if meta.Humanoid then
        self.Cache.Counts.Humanoids += 1
    end

    V31IncrementType(meta.Type)

    self.State.CacheCount = self.Cache.Counts.Total
    return meta
end

function V31:Unindex(instance)
    if not instance then
        return
    end

    local meta = self.Cache.Entries[instance]
    if not meta then
        return
    end

    V31DecrementMeta(meta)

    if not self.Config.WorldScan.KeepRemovedEntries then
        self.Cache.Entries[instance] = nil
        self.Cache.Counts.Total = math.max(0, self.Cache.Counts.Total - 1)
    end

    self.State.CacheCount = self.Cache.Counts.Total
end

function V31:Queue(instance)
    if not instance then
        return
    end
    if self.Cache.Queued[instance] then
        return
    end
    self.Cache.Queued[instance] = true
    table.insert(self.Cache.Queue, instance)
end

function V31:StartScan()
    self.Cache.Queue = {}
    self.Cache.QueueIndex = 1
    self.Cache.Queued = setmetatable({}, { __mode = "k" })

    self.State.Scanning = true
    self.State.ScanComplete = false
    self.State.ScanProgress = 0
    self.State.ScanProcessed = 0
    self.State.ScanQueued = 0
    self.State.ScanBudget = self.Config.WorldScan.InitialBudget

    if self.Config.WorldScan.ScanWorkspace then
        self:Queue(V31Workspace)
    end

    if self.Config.WorldScan.ScanReplicatedStorage then
        self:Queue(V31ReplicatedStorage)
    end

    if self.Config.WorldScan.ScanLighting then
        self:Queue(V31Lighting)
    end

    if self.Config.WorldScan.ScanSoundService then
        self:Queue(V31SoundService)
    end

    if self.Config.WorldScan.ScanReplicatedFirst then
        self:Queue(V31ReplicatedFirst)
    end

    self.State.ScanQueued = #self.Cache.Queue
end

function V31:GetAdaptiveBudget()
    local fps = self.State.RenderFPS
    local current = self.State.ScanBudget

    if fps < 30 then
        current = math.floor(current * 0.55)
    elseif fps < 45 then
        current = math.floor(current * 0.75)
    elseif fps > 110 then
        current = math.floor(current * 1.18)
    elseif fps > 80 then
        current = math.floor(current * 1.06)
    end

    return V31Clamp(
        current,
        self.Config.WorldScan.MinBudget,
        self.Config.WorldScan.MaxBudget
    )
end

function V31:ScanStep()
    if not self.State.Scanning then
        return
    end

    local budget = self:GetAdaptiveBudget()
    self.State.ScanBudget = budget

    local processed = 0
    local started = os.clock()

    while processed < budget
        and self.Cache.QueueIndex <= #self.Cache.Queue do

        local instance = self.Cache.Queue[self.Cache.QueueIndex]
        self.Cache.QueueIndex += 1
        processed += 1

        if instance and instance.Parent then
            self:Index(instance)

            local children = V31Safe(function()
                return instance:GetChildren()
            end, nil)

            if children then
                for _, child in ipairs(children) do
                    self:Queue(child)
                end
            end
        end
    end

    self.State.ScanProcessed += processed
    self.State.ScanQueued = #self.Cache.Queue
    self.State.ScanFrameTime = os.clock() - started

    local total = #self.Cache.Queue
    local done = math.min(self.Cache.QueueIndex - 1, total)

    if total > 0 then
        self.State.ScanProgress = V31Clamp(done / total, 0, 1)
    else
        self.State.ScanProgress = 1
    end

    if self.Cache.QueueIndex > #self.Cache.Queue then
        self.State.Scanning = false
        self.State.ScanComplete = true
        self.State.ScanProgress = 1
    end
end

function V31:MarkDirty(instance)
    if not instance then
        return
    end
    if self.Cache.Dirty[instance] then
        return
    end
    self.Cache.Dirty[instance] = true
    table.insert(self.Cache.DirtyQueue, instance)
end

function V31:ProcessDirty(limit)
    limit = math.max(1, limit or 120)
    local processed = 0

    while processed < limit
        and self.Cache.DirtyIndex <= #self.Cache.DirtyQueue do

        local instance = self.Cache.DirtyQueue[self.Cache.DirtyIndex]
        self.Cache.DirtyIndex += 1
        processed += 1

        self.Cache.Dirty[instance] = nil

        if instance and instance.Parent then
            local previous = self.Cache.Entries[instance]
            if previous then
                V31DecrementMeta(previous)
                self.Cache.Entries[instance] = nil
                self.Cache.Counts.Total = math.max(0, self.Cache.Counts.Total - 1)
            end
            self:Index(instance)
        end
    end

    if self.Cache.DirtyIndex > 256
        and self.Cache.DirtyIndex > (#self.Cache.DirtyQueue / 2) then

        local remaining = {}

        for i = self.Cache.DirtyIndex, #self.Cache.DirtyQueue do
            table.insert(remaining, self.Cache.DirtyQueue[i])
        end

        self.Cache.DirtyQueue = remaining
        self.Cache.DirtyIndex = 1
    end
end

function V31:InstallCacheSignals()
    for _, connection in ipairs(self.Cache.Connections) do
        V31Safe(function()
            connection:Disconnect()
        end)
    end
    table.clear(self.Cache.Connections)

    local roots = {
        V31Workspace,
        V31ReplicatedStorage,
        V31Lighting,
        V31SoundService,
        V31ReplicatedFirst,
    }

    for _, root in ipairs(roots) do
        if root then
            table.insert(self.Cache.Connections, root.DescendantAdded:Connect(function(instance)
                self:Index(instance)
                self:MarkDirty(instance)
            end))

            table.insert(self.Cache.Connections, root.DescendantRemoving:Connect(function(instance)
                self:Unindex(instance)
            end))
        end
    end
end

--============================================================
-- TARGET ENGINE
--============================================================

local function V31IsAllowedPlayer(player)
    if not player or player == YerelOyuncu then
        return false
    end

    local character = V31GetCharacter(player)
    if not character then
        return false
    end

    local humanoid = V31GetHumanoid(character)
    if not V31IsAliveHumanoid(humanoid) then
        return false
    end

    if AYAR and AYAR.TAKIM_KONTROLU then
        if YerelOyuncu.Team
            and player.Team
            and YerelOyuncu.Team == player.Team then
            return false
        end
    end

    return true
end

local function V31ScreenDistance(part)
    local camera = V31Workspace.CurrentCamera
    if not camera or not part then
        return math.huge, false
    end

    local point, visible = camera:WorldToViewportPoint(part.Position)
    if point.Z <= 0 then
        return math.huge, false
    end

    local center = Vector2.new(
        camera.ViewportSize.X * 0.5,
        camera.ViewportSize.Y * 0.5
    )

    return (
        Vector2.new(point.X, point.Y) - center
    ).Magnitude, visible
end

local function V31HasLineOfSight(part)
    if not V31.Config.Aim.LineOfSight then
        return true
    end

    local camera = V31Workspace.CurrentCamera
    if not camera or not part then
        return false
    end

    local direction = part.Position - camera.CFrame.Position
    if direction.Magnitude <= 0.01 then
        return true
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = { Karakter }
    params.IgnoreWater = true

    local result = V31Workspace:Raycast(
        camera.CFrame.Position,
        direction,
        params
    )

    if not result then
        return true
    end

    return result.Instance:IsDescendantOf(part.Parent)
end

local function V31TargetVisibleInFov(part)
    if not V31.Config.Aim.FovEnabled then
        return true
    end

    local distance, visible = V31ScreenDistance(part)
    return visible and distance <= V31.Config.Aim.FovPixels
end

local function V31CandidateFromPlayer(player)
    if not V31IsAllowedPlayer(player) then
        return nil
    end

    local character = V31GetCharacter(player)
    local part = character and V31GetAimPart(character)
    local humanoid = character and V31GetHumanoid(character)

    if not character or not part or not V31IsAliveHumanoid(humanoid) then
        return nil
    end

    local distance = V31DistanceTo(part.Position)
    if V31.Config.Aim.MaxDistance > 0
        and distance > V31.Config.Aim.MaxDistance then
        return nil
    end

    if not V31TargetVisibleInFov(part) then
        return nil
    end

    if not V31HasLineOfSight(part) then
        return nil
    end

    return {
        Target = player,
        Part = part,
        Kind = "PLAYER",
        Distance = distance,
        Screen = V31ScreenDistance(part),
        Health = humanoid.Health,
        MaxHealth = math.max(humanoid.MaxHealth, 1),
    }
end

local function V31CandidateFromNPC(model)
    if not model or not model:IsA("Model") then
        return nil
    end

    if model == Karakter or V31IsPlayerCharacter(model) then
        return nil
    end

    local humanoid = V31GetHumanoid(model)
    local part = V31GetAimPart(model)

    if not humanoid or not part or not V31IsAliveHumanoid(humanoid) then
        return nil
    end

    local distance = V31DistanceTo(part.Position)
    if V31.Config.Aim.MaxDistance > 0
        and distance > V31.Config.Aim.MaxDistance then
        return nil
    end

    if not V31TargetVisibleInFov(part) then
        return nil
    end

    if not V31HasLineOfSight(part) then
        return nil
    end

    return {
        Target = model,
        Part = part,
        Kind = "NPC",
        Distance = distance,
        Screen = V31ScreenDistance(part),
        Health = humanoid.Health,
        MaxHealth = math.max(humanoid.MaxHealth, 1),
    }
end

local function V31CandidateFromObject(meta)
    if not meta or not meta.Instance or not meta.Instance.Parent then
        return nil
    end

    if meta.Type ~= "Loot"
        and meta.Type ~= "Objective"
        and meta.Type ~= "TargetObject"
        and meta.Type ~= "NamedObject" then
        return nil
    end

    local part = meta.Part or V31GetRoot(meta.Instance)
    if not part then
        return nil
    end

    local distance = V31DistanceTo(part.Position)
    if V31.Config.Aim.MaxDistance > 0
        and distance > V31.Config.Aim.MaxDistance then
        return nil
    end

    if not V31TargetVisibleInFov(part) then
        return nil
    end

    if not V31HasLineOfSight(part) then
        return nil
    end

    return {
        Target = meta.Instance,
        Part = part,
        Kind = meta.Type,
        Distance = distance,
        Screen = V31ScreenDistance(part),
        Health = 1,
        MaxHealth = 1,
    }
end

function V31:GetCandidates()
    table.clear(self.TargetCache)

    local source = self.Config.Aim.Source

    if source == "Players"
        or source == "Players + NPC"
        or source == "Everything" then

        for _, player in ipairs(V31Players:GetPlayers()) do
            local candidate = V31CandidateFromPlayer(player)
            if candidate then
                table.insert(self.TargetCache, candidate)
            end
        end
    end

    if source == "Players + NPC"
        or source == "NPC"
        or source == "Everything" then

        for instance, meta in pairs(self.Cache.Entries) do
            if instance and instance.Parent and meta.Type == "NPC" then
                local candidate = V31CandidateFromNPC(instance)
                if candidate then
                    table.insert(self.TargetCache, candidate)
                end
            end
        end
    end

    if source == "Everything" then
        for instance, meta in pairs(self.Cache.Entries) do
            if instance and instance.Parent then
                local candidate = V31CandidateFromObject(meta)
                if candidate then
                    table.insert(self.TargetCache, candidate)
                end
            end
        end
    end

    return self.TargetCache
end

function V31:ScoreCandidate(candidate)
    local mode = self.Config.Aim.Priority

    if mode == "Screen" then
        return 1000000 / math.max(candidate.Screen, 1)
    elseif mode == "Low Health" then
        local ratio = candidate.Health / math.max(candidate.MaxHealth, 1)
        return (1 - ratio) * 700000 + 100000 / math.max(candidate.Distance, 1)
    elseif mode == "Smart" then
        local distanceScore = 150000 / math.max(candidate.Distance, 1)
        local screenScore = 100000 / math.max(candidate.Screen, 10)
        local visibleBonus = V31HasLineOfSight(candidate.Part) and 70000 or 0
        local sameTargetBonus = self.State.CurrentTarget == candidate.Target and 45000 or 0
        return distanceScore + screenScore + visibleBonus + sameTargetBonus
    else
        return 100000000 / math.max(candidate.Distance, 1)
    end
end

function V31:SelectTarget()
    local candidates = self:GetCandidates()
    local best = nil
    local bestScore = -math.huge

    for _, candidate in ipairs(candidates) do
        local score = self:ScoreCandidate(candidate)
        if score > bestScore then
            bestScore = score
            best = candidate
        end
    end

    return best
end

function V31:PredictedPosition(part)
    if not part then
        return nil
    end

    local position = part.Position

    if self.Config.Aim.Prediction then
        position += part.AssemblyLinearVelocity * self.Config.Aim.PredictionTime
    end

    if self.Config.Aim.Height ~= 0 then
        position += Vector3.new(0, self.Config.Aim.Height, 0)
    end

    return position
end

function V31:ClearTarget()
    self.State.CurrentTarget = nil
    self.State.CurrentTargetPart = nil
    self.State.CurrentTargetKind = nil
    self.State.CurrentTargetDistance = math.huge
end

function V31:AimStep(dt)
    if not self.Config.Aim.Enabled then
        return
    end

    if not self.Config.Aim.AutoSwitch
        and self.State.CurrentTarget
        and self.State.CurrentTargetPart then
        local valid = true
        if self.State.CurrentTarget:IsA("Player") then
            valid = V31IsAllowedPlayer(self.State.CurrentTarget)
        elseif not self.State.CurrentTarget.Parent then
            valid = false
        end
        if not valid then
            self:ClearTarget()
        end
    end

    self._aimTimer = (self._aimTimer or 0) + dt

    local target = self.State.CurrentTarget
    local part = target and V31GetAimPart(target.Character or target)

    if self.Config.Aim.Sticky and target and part then
        local distance = V31DistanceTo(part.Position)
        local maxDistance = self.Config.Aim.MaxDistance
        local fovOk = V31TargetVisibleInFov(part)
        local losOk = V31HasLineOfSight(part)

        if maxDistance > 0 and distance > maxDistance then
            self:ClearTarget()
        elseif not fovOk or not losOk then
            self:ClearTarget()
        else
            self.State.CurrentTargetPart = part
        end
    end

    if not self.State.CurrentTarget
        or not self.State.CurrentTargetPart
        or self._aimTimer >= self.Config.Aim.SwitchDelay then

        local selected = self:SelectTarget()

        if selected then
            local changed = self.State.CurrentTarget ~= selected.Target
            self.State.CurrentTarget = selected.Target
            self.State.CurrentTargetPart = selected.Part
            self.State.CurrentTargetKind = selected.Kind
            self.State.CurrentTargetDistance = selected.Distance

            if changed then
                self.State.TargetSwitches += 1
                self.State.LastTargetChange = os.clock()
            end

            self._aimTimer = 0
        elseif self.Config.Aim.AutoSwitch then
            self:ClearTarget()
        end
    end

    local currentTarget = self.State.CurrentTarget
    local currentPart = self.State.CurrentTargetPart

    if not currentTarget or not currentPart then
        return
    end

    local camera = V31Workspace.CurrentCamera
    if not camera then
        return
    end

    local position = self:PredictedPosition(currentPart)
    if not position then
        return
    end

    local desired = CFrame.lookAt(
        camera.CFrame.Position,
        position
    )

    local smooth = V31Clamp(
        self.Config.Aim.Smooth,
        0,
        1
    )

    if smooth >= 1 then
        camera.CFrame = desired
    else
        camera.CFrame = camera.CFrame:Lerp(desired, smooth)
    end
end

