	)


	local top =
		NesneOlustur(
			"Frame",
			ana,
			{
				Size =
					UDim2.fromOffset(
						16,
						16
					),

				Position =
					UDim2.fromOffset(
						3,
						3
					),

				BackgroundColor3 =
					Renk.Gri,

				BorderSizePixel =
					0,
			}
		)


	KoseEkle(
		top,
		20
	)


	local aktif =
		baslangic == true


	local function Guncelle(
		yeni,
		cagir
	)

		aktif =
			yeni == true


		if aktif then

			ana.BackgroundColor3 =
				Renk.Kirmizi


			top.Position =
				UDim2.new(
					1,
					-19,
					0.5,
					-8
				)


			top.BackgroundColor3 =
