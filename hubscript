--============================================================
local function AH3_TargetIsPlayer(target)
    return typeof(target) == "Instance" and target:IsA("Player")
end

local function AH3_TargetModel(target)
    if AH3_TargetIsPlayer(target) then
        return target.Character
    end
    if typeof(target) == "Instance" then
        if target:IsA("Model") then
            return target
        end
        if target:IsA("BasePart") then
            return target:FindFirstAncestorOfClass("Model")
                or target.Parent
        end
    end
    return nil
end

local function AH3_TargetPart(target)
    if AH3_TargetIsPlayer(target) then
        local character = target.Character
        if not character then return nil end
        return AH3_GetBestPartFromModel(character)
    end
    if typeof(target) == "Instance" then
        if target:IsA("BasePart") then return target end
        if target:IsA("Model") then return AH3_GetBestPartFromModel(target) end
    end
    return nil
end

local function AH3_TargetHealth(target)
    local model = AH3_TargetModel(target)
    local humanoid = model and model:FindFirstChildOfClass("Humanoid")
    if humanoid then
        return humanoid.Health, humanoid.MaxHealth
    end
    return 1, 1
end

local function AH3_TargetAlive(target)
    local health = AH3_TargetHealth(target)
    return health > 0
end

local function AH3_TargetTeamAllowed(target)
    if not AH3_TargetIsPlayer(target) then
        return true
    end
    if not AH3_Config.Target.AllowSameTeam then
        if target.Team and YerelOyuncu.Team and target.Team == YerelOyuncu.Team then
            return false
        end
    end
    return true
end

local function AH3_TargetDistance(part)
    if not Govde or not part then
        return math.huge
    end
    return (Govde.Position - part.Position).Magnitude
end

local function AH3_TargetScreenDistance(part)
    local camera = Dunya.CurrentCamera
    if not camera or not part then
        return math.huge, false
    end
    local point, visible = camera:WorldToViewportPoint(part.Position)
    if point.Z <= 0 then
        return math.huge, false
    end
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    local distance = (Vector2.new(point.X, point.Y) - center).Magnitude
    return distance, visible
end

local function AH3_LineOfSight(part, target)
    if not AH3_Config.Target.LineOfSight then
        return true
    end
    local camera = Dunya.CurrentCamera
    if not camera or not part then return false end
    local direction = part.Position - camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = {}
    if Karakter then table.insert(ignore, Karakter) end
    params.FilterDescendantsInstances = ignore
    params.IgnoreWater = true
    local result = Dunya:Raycast(camera.CFrame.Position, direction, params)
    if not result then return true end
    local model = AH3_TargetModel(target)
    if model and result.Instance:IsDescendantOf(model) then return true end
    return result.Instance == part
end

local function AH3_TargetAllowed(target, part)
    if not target or not part then return false end
    if not target.Parent and not AH3_TargetIsPlayer(target) then return false end
    if not AH3_TargetAlive(target) then return false end
    if not AH3_TargetTeamAllowed(target) then return false end
    local distance = AH3_TargetDistance(part)
    if AH3_Config.Target.MaxDistance > 0 and distance > AH3_Config.Target.MaxDistance then return false end
    local screenDistance, visible = AH3_TargetScreenDistance(part)
    if AH3_Config.Target.FovEnabled and AH3_Config.Target.FovPixels > 0 then
        if not visible or screenDistance > AH3_Config.Target.FovPixels then return false end
    end
    if AH3_Config.Target.PreferOnScreen and not visible then
        return false
    end
    if AH3_Config.Target.LineOfSight and not AH3_LineOfSight(part, target) then return false end
    return true
end

local function AH3_PlayerCandidates()
    local result = {}
    if not AH3_Config.Target.Players then return result end
    for _, player in ipairs(Oyuncular:GetPlayers()) do
        if player ~= YerelOyuncu then
            local part = AH3_TargetPart(player)
            if part and AH3_TargetAllowed(player, part) then
                local hp, maxHp = AH3_TargetHealth(player)
                local distance = AH3_TargetDistance(part)
                local screen, visible = AH3_TargetScreenDistance(part)
                table.insert(result, {
                    Target = player,
                    Part = part,
                    Kind = "PLAYER",
                    Distance = distance,
                    Screen = screen,
                    Visible = visible,
                    Health = hp,
                    MaxHealth = maxHp,
                })
            end
        end
    end
    return result
end

local function AH3_NPCCandidates()
    local result = {}
    if not AH3_Config.Target.NPCs then return result end
    for instance, meta in pairs(AH3_Cache.Entries) do
        if instance and instance.Parent and meta.Type == "NPC" and meta.Humanoid then
            local part = AH3_TargetPart(instance)
            if part and AH3_TargetAllowed(instance, part) then
                local hp, maxHp = AH3_TargetHealth(instance)
                local distance = AH3_TargetDistance(part)
                local screen, visible = AH3_TargetScreenDistance(part)
                table.insert(result, {
                    Target = instance,
                    Part = part,
                    Kind = "NPC",
                    Distance = distance,
                    Screen = screen,
                    Visible = visible,
                    Health = hp,
                    MaxHealth = maxHp,
                })
            end
        end
    end
    return result
end

local function AH3_ObjectCandidates()
    local result = {}
    if not AH3_Config.Target.TaggedObjects and not AH3_Config.Target.AttributeObjects and not AH3_Config.Target.NameMatchedObjects then return result end
    for instance, meta in pairs(AH3_Cache.Entries) do
        if instance and instance.Parent then
            local validType = meta.Type == "TARGET_OBJECT" or meta.Type == "NAMED_OBJECT"
            if validType then
                local part = AH3_TargetPart(instance)
                if part and AH3_TargetAllowed(instance, part) then
                    local distance = AH3_TargetDistance(part)
                    local screen, visible = AH3_TargetScreenDistance(part)
                    table.insert(result, {
                        Target = instance,
                        Part = part,
                        Kind = "OBJECT",
                        Distance = distance,
                        Screen = screen,
                        Visible = visible,
                        Health = 1,
                        MaxHealth = 1,
                    })
                end
            end
        end
    end
    return result
end

local function AH3_AllCandidates()
    local all = {}
    for _, candidate in ipairs(AH3_PlayerCandidates()) do table.insert(all, candidate) end
    for _, candidate in ipairs(AH3_NPCCandidates()) do table.insert(all, candidate) end
    for _, candidate in ipairs(AH3_ObjectCandidates()) do table.insert(all, candidate) end
    return all
end

