function V31:StopFreecam()
    if not self.State.Freecam then
        return
    end

    local camera = V31Workspace.CurrentCamera
    self.State.Freecam = false

    if camera then
        camera.CameraType = self._cameraType or Enum.CameraType.Custom
        camera.CameraSubject = self._cameraSubject or Humanoid
        if self._cameraCFrame then
            camera.CFrame = self._cameraCFrame
        end
    end

    V31Input.MouseBehavior = self._mouseBehavior or Enum.MouseBehavior.Default
end

function V31:StartFreecam()
    if self.State.Freecam then
        return
    end

    local camera = V31Workspace.CurrentCamera
    if not camera then
        return
    end

    self._cameraType = camera.CameraType
    self._cameraSubject = camera.CameraSubject
    self._cameraCFrame = camera.CFrame
    self._mouseBehavior = V31Input.MouseBehavior

    self.State.Freecam = true
    self.FreecamPosition = camera.CFrame.Position

    local look = camera.CFrame.LookVector
    self.FreecamYaw = math.atan2(-look.X, -look.Z)
    self.FreecamPitch = math.asin(V31Clamp(look.Y, -1, 1))

    camera.CameraType = Enum.CameraType.Scriptable
    V31Input.MouseBehavior = Enum.MouseBehavior.LockCenter
end

function V31:UpdateFreecam(dt)
    if not self.State.Freecam then
        return
    end

    local camera = V31Workspace.CurrentCamera
    if not camera then
        return
    end

    local delta = V31Input:GetMouseDelta()

    self.FreecamYaw -= delta.X * self.Config.Camera.FreecamSensitivity
    self.FreecamPitch -= delta.Y * self.Config.Camera.FreecamSensitivity
    self.FreecamPitch = V31Clamp(
        self.FreecamPitch,
        -math.rad(89),
        math.rad(89)
    )

    local rotation = CFrame.fromEulerAnglesYXZ(
        self.FreecamPitch,
        self.FreecamYaw,
        0
    )

    local move = Vector3.zero

    if V31Input:IsKeyDown(Enum.KeyCode.W) then
        move += rotation.LookVector
    end
    if V31Input:IsKeyDown(Enum.KeyCode.S) then
        move -= rotation.LookVector
    end
    if V31Input:IsKeyDown(Enum.KeyCode.A) then
        move -= rotation.RightVector
    end
    if V31Input:IsKeyDown(Enum.KeyCode.D) then
        move += rotation.RightVector
    end
    if V31Input:IsKeyDown(Enum.KeyCode.Space) then
        move += Vector3.yAxis
    end
    if V31Input:IsKeyDown(Enum.KeyCode.LeftShift) then
        move -= Vector3.yAxis
    end

    if move.Magnitude > 0 then
        move = move.Unit
    end

    self.FreecamPosition +=
        move * self.Config.Camera.FreecamSpeed * dt

    camera.CFrame =
        CFrame.new(self.FreecamPosition) * rotation
end

