end

local function AH3_CycleTargetPriority()
    local order = {"Nearest", "Screen", "Low Health", "Smart"}
    local index = table.find(order, AH3_Config.Target.Priority) or 1
    index = index + 1
    if index > #order then index = 1 end
    AH3_Config.Target.Priority = order[index]
    BildirimGoster("Target Priority", AH3_Config.Target.Priority)
end

local function AH3_CycleTargetPart()
    local order = {"Head", "Torso", "Root"}
    local index = table.find(order, AH3_Config.Target.Part) or 1
    index = index + 1
    if index > #order then index = 1 end
    AH3_Config.Target.Part = order[index]
    BildirimGoster("Target Part", AH3_Config.Target.Part)
end

local function AH3_TogglePrediction()
    AH3_Config.Target.Prediction = not AH3_Config.Target.Prediction
    AH3_SyncOriginalAimSettings()
end

local function AH3_SetFov(value)
    AYAR.AIM_FOV = math.clamp(value, 0, 600)
    AH3_Config.Target.FovPixels = AYAR.AIM_FOV
    AH3_UpdateFovRing()
end

local function AH3_SetUiScale(value)
    AH3_Config.UI.Scale = math.clamp(value, 0.72, 1.05)
    AH3_ApplyCompactScale()
end

