local function KarakterAl(
	Oyuncu
)

	if not Oyuncu then
		return nil
	end

	local karakter =
		Oyuncu.Character

	if not karakter then
		return nil
	end

	if not karakter.Parent then
		return nil
	end

	return karakter
end

local function HumanoidAl(
	Oyuncu
)

	local karakter =
		KarakterAl(
			Oyuncu
		)

	if not karakter then
		return nil
	end

	return karakter:FindFirstChildOfClass(
		"Humanoid"
	)
end

local function GovdeAl(
	Oyuncu
)

	local karakter =
		KarakterAl(
			Oyuncu
		)

	if not karakter then
		return nil
	end

	local govde =
		karakter:FindFirstChild(
			"HumanoidRootPart"
		)

	if govde
		and govde:IsA("BasePart") then

		return govde
	end

	return nil
end

--============================================================
-- HEDEF PARÇASI
--============================================================

local function AimParcasiAl(
	Oyuncu
)

	local karakter =
		KarakterAl(
			Oyuncu
		)

	if not karakter then
		return nil
	end

	-- Öncelikli seçim
	local secilen =
		karakter:FindFirstChild(
			AYAR.AIM_PARCA
		)

	if secilen
		and secilen:IsA("BasePart") then

		return secilen
	end

	-- Yedekler
	local yedekler = {

		"Head",
		"HumanoidRootPart",
		"UpperTorso",
		"Torso",
		"LowerTorso",
	}

	for _, ad in ipairs(
		yedekler
	) do

		local parca =
			karakter:FindFirstChild(
				ad
			)

		if parca
			and parca:IsA("BasePart") then

			return parca
		end
	end

	return karakter:FindFirstChildWhichIsA(
		"BasePart",
		true
	)
end

--============================================================
-- YAŞIYOR MU
--============================================================

local function YasiyorMu(
	Oyuncu
)

	if not Oyuncu
		or Oyuncu == YerelOyuncu then

		return false
	end

	local humanoid =
		HumanoidAl(
			Oyuncu
		)

	local parca =
		AimParcasiAl(
			Oyuncu
		)

	if not humanoid
		or not parca then

		return false
	end

	if humanoid.Health <= 0 then
		return false
	end

	return true
end

--============================================================
-- AYNI TAKIM
--============================================================

local function AyniTakimMi(
	Oyuncu
)

	if not AYAR.TAKIM_KONTROLU then
		return false
	end

	if not YerelOyuncu.Team then
		return false
	end

	if not Oyuncu.Team then
		return false
	end

	return YerelOyuncu.Team ==
		Oyuncu.Team
end

--============================================================
-- GEÇERLİ HEDEF
--============================================================

local function HedefGecerliMi(
	Oyuncu,
	Parca
)

	if not Oyuncu
		or not Parca then

		return false
	end

	if not YasiyorMu(Oyuncu) then
		return false
	end

	if AyniTakimMi(Oyuncu) then
		return false
	end

	if not Parca.Parent then
		return false
	end

	if not Govde then
		return false
	end

	local mesafe =
		(
			Govde.Position -
			Parca.Position
		).Magnitude

	if mesafe >
		AYAR.AIM_MESAFE then

		return false
	end

	-- FOV
	if AYAR.AIM_FOV > 0 then

		local kamera =
			Dunya.CurrentCamera

		if not kamera then
			return false
		end

		local nokta,
			ekranda =
			kamera:WorldToViewportPoint(
				Parca.Position
			)

		if not ekranda
			or nokta.Z <= 0 then

			return false
		end

		local merkez =
			kamera.ViewportSize / 2

		local fark =
			(
				Vector2.new(
					nokta.X,
					nokta.Y
				) -
				merkez
			).Magnitude

		if fark >
			AYAR.AIM_FOV then

			return false
		end
	end

	-- Görüş hattı
	if AYAR.GORUS_KONTROLU then

		local kamera =
			Dunya.CurrentCamera

		if not kamera then
			return false
		end

		local yon =
			Parca.Position -
			kamera.CFrame.Position

		local parametre =
			RaycastParams.new()

		parametre.FilterType =
			Enum.RaycastFilterType.Exclude

		parametre.FilterDescendantsInstances = {
			Karakter,
			KarakterAl(Oyuncu)
		}

		parametre.IgnoreWater = true

		local sonuc =
			Dunya:Raycast(
				kamera.CFrame.Position,
				yon,
				parametre
			)

		if sonuc then

			if not sonuc.Instance:IsDescendantOf(
				KarakterAl(Oyuncu)
			) then

				return false
			end
		end
	end

	return true
end

--============================================================
-- EN YAKIN HEDEF
--============================================================

local function EnIyiHedefiBul()

	if not Govde then
		return nil, nil
	end

	local EnIyiOyuncu = nil
	local EnIyiParca = nil

	local EnIyiMesafe =
		math.huge

	local EnIyiEkran =
		math.huge

	local kamera =
		Dunya.CurrentCamera

	for _, Oyuncu in ipairs(
		Oyuncular:GetPlayers()
	) do

		if Oyuncu ~= YerelOyuncu then

			local parca =
				AimParcasiAl(
					Oyuncu
				)

			if parca
				and HedefGecerliMi(
					Oyuncu,
					parca
				) then

				local mesafe =
					(
						Govde.Position -
						parca.Position
					).Magnitude

				local ekranMesafesi =
					math.huge

				if kamera then

					local nokta,
						ekranda =
						kamera:WorldToViewportPoint(
							parca.Position
						)

					if ekranda then

						local merkez =
							kamera.ViewportSize / 2

						ekranMesafesi =
							(
								Vector2.new(
									nokta.X,
									nokta.Y
								) -
								merkez
							).Magnitude

					end
				end

				if AYAR.AIM_MODU ==
					"Ekran Merkezi" then

					if ekranMesafesi <
						EnIyiEkran then

						EnIyiEkran =
							ekranMesafesi

						EnIyiMesafe =
							mesafe

						EnIyiOyuncu =
							Oyuncu

						EnIyiParca =
							parca
					end

				else

					if mesafe <
						EnIyiMesafe then

						EnIyiMesafe =
							mesafe

						EnIyiEkran =
							ekranMesafesi

						EnIyiOyuncu =
							Oyuncu

						EnIyiParca =
							parca
					end
				end
			end
		end
	end

	return EnIyiOyuncu,
		EnIyiParca
end

