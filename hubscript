--============================================================
-- TAHMİNLİ HEDEF POZİSYONU
--============================================================

local function TahminliPozisyon(
	Parca
)

	if not Parca then
		return nil
	end

	local pozisyon =
		Parca.Position

	if AYAR.AIM_TAHMIN <= 0 then
		return pozisyon
	end

	return pozisyon +
		(
			Parca.AssemblyLinearVelocity *
			AYAR.AIM_TAHMIN
		)
end

--============================================================
-- ESP SİL
--============================================================

local function ESPSil(
	Oyuncu
)

	local veri =
		ESPNesneleri[Oyuncu]

	if not veri then
		return
	end

	GuvenliSil(
		veri.Vurgula
	)

	GuvenliSil(
		veri.Etiket
	)

	ESPNesneleri[Oyuncu] =
		nil
end

--============================================================
-- ESP EKLE
--============================================================

local function ESPEkle(
	Oyuncu
)

	if Oyuncu ==
		YerelOyuncu then

		return
	end

	if not Durum.ESP then
		return
	end

	if not YasiyorMu(Oyuncu) then
		return
	end

	local karakter =
		KarakterAl(
			Oyuncu
		)

	if not karakter then
		return
	end

	local kafa =
		karakter:FindFirstChild(
			"Head"
		)

	if not kafa
		or not kafa:IsA("BasePart") then

		return
	end

	ESPSil(
		Oyuncu
	)

	--========================================================
	-- VURGULAMA
	--========================================================

	local Vurgula =
		Instance.new(
			"Highlight"
		)

	Vurgula.Name =
		"OyuncuESP"

	Vurgula.Adornee =
		karakter

	Vurgula.FillColor =
		AYAR.ESP_RENK

	Vurgula.OutlineColor =
		Color3.fromRGB(
			255,
			255,
			255
		)

	Vurgula.FillTransparency =
		AYAR.ESP_DOLGU

	Vurgula.OutlineTransparency =
		AYAR.ESP_CIZGI

	Vurgula.DepthMode =
		AYAR.ESP_DUVAR_ARKASI
		and Enum.HighlightDepthMode.AlwaysOnTop
		or Enum.HighlightDepthMode.Occluded

	Vurgula.Parent =
		AnaArayuz

	--========================================================
	-- İSİM ETİKETİ
	--========================================================

	local Etiket = nil

	if AYAR.ESP_ISIM then

		Etiket =
			Instance.new(
				"BillboardGui"
			)

		Etiket.Name =
			"OyuncuESPIsim"

		Etiket.Adornee =
			kafa

		Etiket.Size =
			UDim2.fromOffset(
				220,
				44
			)

		Etiket.StudsOffset =
			Vector3.new(
				0,
				3.2,
				0
			)

		Etiket.AlwaysOnTop =
			true

		Etiket.MaxDistance =
			AYAR.ESP_MESAFE

		Etiket.Parent =
			OyuncuArayuzu

		local Yazi =
			Instance.new(
				"TextLabel"
			)

		Yazi.Size =
			UDim2.fromScale(
				1,
				1
			)

		Yazi.BackgroundTransparency =
			1

		Yazi.TextColor3 =
			AYAR.ESP_RENK

		Yazi.TextStrokeTransparency =
			0

		Yazi.TextStrokeColor3 =
			Color3.fromRGB(
				0,
				0,
				0
			)

		Yazi.Font =
			Enum.Font.GothamBold

		Yazi.TextSize =
			12

		Yazi.TextWrapped =
			false

		local Metin =
			Oyuncu.DisplayName

		if AYAR.ESP_CAN then

			local humanoid =
				HumanoidAl(
					Oyuncu
				)

			if humanoid then

				Metin =
					Metin ..
					"  |  CAN: " ..
					math.floor(
						humanoid.Health
					)

			end
		end

		Yazi.Text =
			Metin

		Yazi.Parent =
			Etiket
	end

	ESPNesneleri[Oyuncu] = {

		Vurgula =
			Vurgula,

		Etiket =
			Etiket,

		Karakter =
			karakter,
	}
end

--============================================================
-- ESP YENİLE
--============================================================

local function ESPYenile()

	for Oyuncu in pairs(
		ESPNesneleri
	) do

		ESPSil(
			Oyuncu
		)
	end

	if not Durum.ESP then
		return
	end

	for _, Oyuncu in ipairs(
		Oyuncular:GetPlayers()
	) do

		if Oyuncu ~=
			YerelOyuncu then

			ESPEkle(
				Oyuncu
			)
		end
	end
end

--============================================================
-- GOD
--============================================================

local function GodDurdur()

	if GodBaglantisi then

		GodBaglantisi:Disconnect()

		GodBaglantisi =
			nil
	end
end

local function GodBaslat()

	GodDurdur()

	if not Humanoid then
		return false
	end

	if not Karakter then
		return false
	end

	Humanoid.MaxHealth =
		math.max(
			Humanoid.MaxHealth,
			100000
		)

	Humanoid.Health =
		Humanoid.MaxHealth

	GodBaglantisi =
		Humanoid.HealthChanged:Connect(
			function()

				if not Durum.God then
					return
				end

				if not Humanoid
					or Humanoid.Health <= 0 then

					return
				end

				if Humanoid.Health <
					Humanoid.MaxHealth then

					Humanoid.Health =
						Humanoid.MaxHealth
				end
			end
		)

	return true
end

