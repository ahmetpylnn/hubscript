	return true
end

--============================================================
-- APPLY STATES
--============================================================

local function ApplyActiveStates()

	if not Humanoid then
		return
	end

	if State.Speed then

		Humanoid.WalkSpeed =
			CONFIG.SPEED
	end

	if State.Jump then

		if Humanoid.UseJumpPower then

			Humanoid.JumpPower =
				CONFIG.JUMP

		else

			Humanoid.JumpHeight =
				CONFIG.JUMP
		end
	end

	if State.God then
		StartGod()
	end

	if State.Fly then
		StartFly()
	end
end

