--============================================================
local function AH3_SearchWorld(query, limit)
    local results = {}
    if type(query) ~= "string" or query == "" then
        return results
    end
    local lower = string.lower(query)
    limit = math.max(1, limit or 50)
    for instance, meta in pairs(AH3_Cache.Entries) do
        if instance and instance.Parent then
            if string.find(string.lower(meta.Name), lower, 1, true) then
                table.insert(results, {
                    Instance = instance,
                    Meta = meta,
                    Distance = AH3_DistanceToInstance(instance),
                })
                if #results >= limit then
                    break
                end
            end
        end
    end
    table.sort(results, function(a, b)
        return a.Distance < b.Distance
    end)
    return results
end

AH3_API.SearchWorld = AH3_SearchWorld

