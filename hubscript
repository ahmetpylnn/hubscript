--============================================================
-- LAUNCHER SÜRÜKLEME
--============================================================

local LauncherSurukleniyor =
	false

local LauncherHareketEtti =
	false

local LauncherBaslangicFare =
	nil

local LauncherBaslangicKonum =
	nil


Baslatici.InputBegan:Connect(
	function(
		girdi
	)

		if
			girdi.UserInputType ==
				Enum.UserInputType.MouseButton1
			or
			girdi.UserInputType ==
				Enum.UserInputType.Touch
		then


			LauncherSurukleniyor =
				true


			LauncherHareketEtti =
				false


			LauncherBaslangicFare =
				girdi.Position


			LauncherBaslangicKonum =
				Baslatici.Position

		end

	end
)


Giris.InputChanged:Connect(
	function(
		girdi
	)

		if not LauncherSurukleniyor then

			return
		end


		if
			girdi.UserInputType ~=
				Enum.UserInputType.MouseMovement
			and
			girdi.UserInputType ~=
				Enum.UserInputType.Touch
		then

			return

		end


		local fark =
			girdi.Position -
			LauncherBaslangicFare


		if fark.Magnitude > 5 then

			LauncherHareketEtti =
				true

		end


		local kamera =
			Dunya.CurrentCamera


		if not kamera then

			return

		end


		local viewport =
			kamera.ViewportSize


		local genislik =
			Baslatici.AbsoluteSize.X


		local yukseklik =
			Baslatici.AbsoluteSize.Y


		local x =
			LauncherBaslangicKonum.X.Offset
			+
			fark.X


		local y =
			LauncherBaslangicKonum.Y.Offset
			+
			fark.Y


		x =
			math.clamp(
				x,
				5,
				math.max(
					5,
					viewport.X
					-
					genislik
					-
					5
				)
			)


		y =
			math.clamp(
				y,
				5,
				math.max(
					5,
					viewport.Y
					-
					yukseklik
					-
					5
				)
			)


		Baslatici.Position =
			UDim2.fromOffset(
				x,
				y
			)

	end
)


Giris.InputEnded:Connect(
	function(
		girdi
	)

		if not LauncherSurukleniyor then

			return

		end


		if
			girdi.UserInputType ==
				Enum.UserInputType.MouseButton1
			or
			girdi.UserInputType ==
				Enum.UserInputType.Touch
		then


			LauncherSurukleniyor =
				false


			if not LauncherHareketEtti then

				AnaPanel.Visible =
					true

				Baslatici.Visible =
					false


