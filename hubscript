--============================================================
-- CTRL
--============================================================

UserInputService.InputBegan:Connect(function(
	input,
	processed
)

	if processed then
		return
	end

	if input.KeyCode ==
		Enum.KeyCode.LeftControl
		or
		input.KeyCode ==
			Enum.KeyCode.RightControl then

		SetVisible(
			not Main.Visible
		)
	end
end)

