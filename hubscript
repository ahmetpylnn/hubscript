local function AH3_SetLine(frame, a, b, thickness, color)
    if not frame then return end
    local delta = b - a
    local length = delta.Magnitude
    if length <= 0.01 then frame.Visible = false return end
    frame.Visible = true
    frame.BackgroundColor3 = color or AYAR.ESP_RENK
    frame.Size = UDim2.fromOffset(length, thickness or 2)
    frame.Position = UDim2.fromOffset((a.X + b.X) / 2, (a.Y + b.Y) / 2)
    frame.Rotation = math.deg(math.atan2(delta.Y, delta.X))
end

local function AH3_HideFrames(frames)
    for _, frame in ipairs(frames or {}) do frame.Visible = false end
end

local function AH3_ProjectPart(camera, part)
    if not part then return nil, false end
    local point, visible = camera:WorldToViewportPoint(part.Position)
    if point.Z <= 0 then return nil, false end
    return Vector2.new(point.X, point.Y), visible
end

local function AH3_GetBox2D(camera, character)
    local ok, cframe, size = pcall(function()
        return character:GetBoundingBox()
    end)
    if not ok or not cframe or not size then return nil end
    local half = size / 2
    local corners = {
        Vector3.new(-half.X, -half.Y, -half.Z),
        Vector3.new(-half.X, -half.Y, half.Z),
        Vector3.new(-half.X, half.Y, -half.Z),
        Vector3.new(-half.X, half.Y, half.Z),
        Vector3.new(half.X, -half.Y, -half.Z),
        Vector3.new(half.X, -half.Y, half.Z),
        Vector3.new(half.X, half.Y, -half.Z),
        Vector3.new(half.X, half.Y, half.Z),
    }
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local visibleCount = 0
    for _, corner in ipairs(corners) do
        local point, visible = camera:WorldToViewportPoint(cframe:PointToWorldSpace(corner))
        if point.Z > 0 then
            visibleCount += 1
            minX = math.min(minX, point.X)
            minY = math.min(minY, point.Y)
            maxX = math.max(maxX, point.X)
            maxY = math.max(maxY, point.Y)
        end
    end
    if visibleCount == 0 then return nil end
    return {
        Left = minX,
        Top = minY,
        Right = maxX,
        Bottom = maxY,
    }
end

local function AH3_UpdateBox(visual, box, color)
    if not visual or not box then return end
    local topLeft = Vector2.new(box.Left, box.Top)
    local topRight = Vector2.new(box.Right, box.Top)
    local bottomLeft = Vector2.new(box.Left, box.Bottom)
    local bottomRight = Vector2.new(box.Right, box.Bottom)
    AH3_SetLine(visual.Box[1], topLeft, topRight, 2, color)
    AH3_SetLine(visual.Box[2], topRight, bottomRight, 2, color)
    AH3_SetLine(visual.Box[3], bottomRight, bottomLeft, 2, color)
    AH3_SetLine(visual.Box[4], bottomLeft, topLeft, 2, color)
end

