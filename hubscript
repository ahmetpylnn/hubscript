local function AH3_DistanceToInstance(instance)
    if not instance or not Govde then
        return math.huge
    end
    local position = AH3_GetPivotPosition(instance)
    if not position then
        return math.huge
    end
    return (Govde.Position - position).Magnitude
end

local function AH3_GetWithinRadius(radius, kind)
    local results = {}
    radius = math.max(0, radius or 0)
    for instance, meta in pairs(AH3_Cache.Entries) do
        if instance and instance.Parent then
            if not kind or meta.Type == kind then
                local distance = AH3_DistanceToInstance(instance)
                if radius <= 0 or distance <= radius then
                    table.insert(results, {
                        Instance = instance,
                        Meta = meta,
                        Distance = distance,
                    })
                end
            end
        end
    end
    table.sort(results, function(a, b)
        return a.Distance < b.Distance
    end)
    return results
end

local function AH3_GetNearestOfKind(kind)
    local results = AH3_GetWithinRadius(0, kind)
    return results[1]
end

