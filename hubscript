--============================================================
-- KARAKTER YUKLE
--============================================================

local function KarakterYukle(
	yeniKarakter
)

	Karakter =
		yeniKarakter

	Humanoid =
		yeniKarakter:WaitForChild(
			"Humanoid",
			10
		)

	Govde =
		yeniKarakter:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not Humanoid
		or not Govde then

		return
	end

