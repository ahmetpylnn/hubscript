--============================================================
-- GOD START
--============================================================

local function StartGod()

	StopGod()

	if not Humanoid
		or not Character then

		return false
	end

	Humanoid.MaxHealth =
		math.max(
			Humanoid.MaxHealth,
			100000
		)

	Humanoid.Health =
		Humanoid.MaxHealth

	GodConnection =
		Humanoid.HealthChanged:Connect(
			function()

				if not State.God then
					return
				end

				if not Humanoid
					or Humanoid.Health <= 0 then

					return
				end

				if Humanoid.Health <
					Humanoid.MaxHealth then

					Humanoid.Health =
						Humanoid.MaxHealth
				end
			end
		)

	return true
end

