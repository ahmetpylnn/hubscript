local AH3_LastFrameClock = os.clock()
local AH3_FpsAccum = 0
local AH3_FpsFrames = 0
local AH3_LastDiag = os.clock()
local AH3_LastWorldUpdate = 0

Calistirici:BindToRenderStep("AHMET_HUB_V3_CAMERA", Enum.RenderPriority.Camera.Value + 60, function(dt)
    AH3_State.LastFrameDt = dt
    local instantFps = 1 / math.max(dt, 1 / 240)
    AH3_FpsAccum += instantFps
    AH3_FpsFrames += 1
    if AH3_FpsFrames >= 12 then
        AH3_State.RenderFPS = AH3_FpsAccum / AH3_FpsFrames
        AH3_FpsAccum = 0
        AH3_FpsFrames = 0
    end
    AH3_UpdateFovRing()
end)

Calistirici.Heartbeat:Connect(function(dt)
    local scanStarted = os.clock()
    AH3_ScanStep()
    AH3_PushHistory(AH3_Diagnostics.Scan, os.clock() - scanStarted)
    AH3_State.CacheCount = AH3_Cache.Counts.Total
    if os.clock() - AH3_LastWorldUpdate >= AH3_Config.ESP.UpdateInterval then
        AH3_LastWorldUpdate = os.clock()
        local start = os.clock()
        AH3_UpdatePlayerESP()
        AH3_UpdateWorldESP()
        AH3_PushHistory(AH3_Diagnostics.ESP, os.clock() - start)
    end
end)

