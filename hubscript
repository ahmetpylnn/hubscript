function V31:EnableFullbright()
    if self._originalLighting then
        return
    end

    self._originalLighting = {
        Brightness = V31Lighting.Brightness,
        ClockTime = V31Lighting.ClockTime,
        FogEnd = V31Lighting.FogEnd,
        GlobalShadows = V31Lighting.GlobalShadows,
        Ambient = V31Lighting.Ambient,
        OutdoorAmbient = V31Lighting.OutdoorAmbient,
    }

    V31Lighting.Brightness = 3
    V31Lighting.ClockTime = 14
    V31Lighting.FogEnd = 100000
    V31Lighting.GlobalShadows = false
    V31Lighting.Ambient = Color3.fromRGB(255, 255, 255)
    V31Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
end

function V31:DisableFullbright()
    local saved = self._originalLighting
    if not saved then
        return
    end

    V31Lighting.Brightness = saved.Brightness
    V31Lighting.ClockTime = saved.ClockTime
    V31Lighting.FogEnd = saved.FogEnd
    V31Lighting.GlobalShadows = saved.GlobalShadows
    V31Lighting.Ambient = saved.Ambient
    V31Lighting.OutdoorAmbient = saved.OutdoorAmbient

    self._originalLighting = nil
end

