    for _, attributeName in ipairs(AH3_ObjectTargetAttributes) do
        local value = AH3_SafeCall(function()
            return instance:GetAttribute(attributeName)
        end, nil)
        if value ~= nil then
            values[attributeName] = value
        end
    end
    return values
end

