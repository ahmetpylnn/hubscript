function FovGuncelle()

	if not FovCemberi then

		return
	end


	local kamera =
		Dunya.CurrentCamera


	if kamera then

		local inset =
			ArayuzHizmeti:GetGuiInset()


		local merkezX =
			inset.X +
			kamera.ViewportSize.X / 2


		local merkezY =
			inset.Y +
			kamera.ViewportSize.Y / 2


		FovCemberi.Position =
			UDim2.fromOffset(
				merkezX,
				merkezY
			)

	end


	FovCemberi.Size =
		UDim2.fromOffset(
			math.max(
				2,
				AYAR.AIM_FOV * 2
			),
			math.max(
				2,
				AYAR.AIM_FOV * 2
			)
		)


	FovCemberi.Visible =
		(
			Durum.Aim
			and
			AYAR.FOV_GOSTER
			and
			AYAR.AIM_FOV > 0
		)


	local cizgi =
		FovCemberi:FindFirstChild(
			"FovCizgisi"
		)


	if cizgi then

		cizgi.Thickness =
			AYAR.FOV_KALINLIK


		cizgi.Transparency =
			AYAR.FOV_SEFFAFLIK


		cizgi.Color =
			Renk.Kirmizi

	end

end


