local AH3_PerfMode = "Balanced"

local function AH3_ApplyPerfMode(mode)
    if mode == "Low" then
        AH3_PerfMode = "Low"
        AH3_Config.WorldScan.MinBudget = 45
        AH3_Config.WorldScan.InitialBudget = 110
        AH3_Config.WorldScan.MaxBudget = 260
        AH3_Config.ESP.UpdateInterval = 1 / 20
        AH3_Config.ESP.MaxWorldVisuals = 35
        AH3_Config.ESP.Skeleton = false
        AH3_Config.ESP.Tracer = false
    elseif mode == "High" then
        AH3_PerfMode = "High"
        AH3_Config.WorldScan.MinBudget = 180
        AH3_Config.WorldScan.InitialBudget = 650
        AH3_Config.WorldScan.MaxBudget = 1800
        AH3_Config.ESP.UpdateInterval = 1 / 45
        AH3_Config.ESP.MaxWorldVisuals = 120
    else
        AH3_PerfMode = "Balanced"
        AH3_Config.WorldScan.MinBudget = 90
        AH3_Config.WorldScan.InitialBudget = 420
        AH3_Config.WorldScan.MaxBudget = 1400
        AH3_Config.ESP.UpdateInterval = 1 / 30
        AH3_Config.ESP.MaxWorldVisuals = 80
    end
    BildirimGoster("Performance", AH3_PerfMode)
end

