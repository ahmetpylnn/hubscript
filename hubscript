-- TELEPORT
--============================================================

local Mouse =
	LocalPlayer:GetMouse()

local function MouseOverPanel()

	local x =
		Mouse.X

	local y =
		Mouse.Y

	local objects =
		PlayerGui:GetGuiObjectsAtPosition(
			x,
			y
		)

	for _, object in ipairs(
		objects
	) do

		if object.Visible
			and object:IsDescendantOf(
				Main
			) then

			return true
		end
	end

	return false
end

local function GetTeleportRay()

	local ok, unitRay =
		pcall(function()

			return Mouse.UnitRay
		end)

	if ok
		and unitRay then

		return unitRay.Origin,
			unitRay.Direction
	end

	local camera =
		Workspace.CurrentCamera

	if not camera then
		return nil, nil
	end

	local mousePosition =
		UserInputService:GetMouseLocation()

	local ray =
		camera:ScreenPointToRay(
			mousePosition.X,
			mousePosition.Y
		)

	return ray.Origin,
		ray.Direction
end

local function Teleport()

	if not Character
		or not Character.Parent
		or not RootPart
		or not RootPart.Parent then

		RefreshCharacter()
	end

	if not Character
		or not RootPart then

		Status.Text =
			"Teleport: karakter hazır değil."

		return
	end

	local origin,
		direction =
		GetTeleportRay()

	if not origin
		or not direction then

		Status.Text =
			"Teleport: mouse ray alınamadı."

		return
	end

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		Character
	}

	params.IgnoreWater =
		true

	local rayDirection =
		direction.Unit *
		CONFIG.TELEPORT_DISTANCE

	local result =
		Workspace:Raycast(
			origin,
			rayDirection,
			params
		)

	if not result then

		Status.Text =
			"Teleport: yüzey bulunamadı."

		return
	end

	local height =
		CONFIG.TELEPORT_HEIGHT

	if Humanoid then

		height =
			math.max(
				height,

				Humanoid.HipHeight +
				RootPart.Size.Y *
				0.5 +
				0.25
			)
	end

	local targetPosition

	if result.Normal.Y >= 0.6 then

		targetPosition =
			result.Position +
			Vector3.new(
				0,
				height,
				0
			)

	else

		targetPosition =
			result.Position +
			result.Normal *
			height
	end

	RootPart.AssemblyLinearVelocity =
		Vector3.zero

	RootPart.AssemblyAngularVelocity =
		Vector3.zero

	Character:PivotTo(
		CFrame.new(
			targetPosition
		)
	)

	RootPart.AssemblyLinearVelocity =
		Vector3.zero

	RootPart.AssemblyAngularVelocity =
		Vector3.zero

	Status.Text =
		"Teleport başarılı.\n" ..
		"X: " ..
		math.floor(
			targetPosition.X
		) ..
		"  Y: " ..
		math.floor(
			targetPosition.Y
		) ..
		"  Z: " ..
		math.floor(
			targetPosition.Z
		)
end

--============================================================
-- TELEPORT TOGGLE
--============================================================

TeleportButton.MouseButton1Click:Connect(
	function()

		State.Teleport =
			not State.Teleport

		SetTeleport(
			State.Teleport
		)

		if State.Teleport then

			Status.Text =
				"TELEPORT AKTİF\n" ..
				"Haritada sol tıkla."

		else

			Status.Text =
				"Teleport kapalı."
		end
	end
)

--============================================================
-- WORLD CLICK
--============================================================

Mouse.Button1Down:Connect(
	function()

		if not State.Teleport then
			return
		end

		if MouseOverPanel() then
			return
		end

		Teleport()
	end
)

--============================================================
-- RESPAWN
--============================================================

Respawn.MouseButton1Click:Connect(
	function()

		if Humanoid
			and Humanoid.Parent then

			Humanoid.Health = 0

		else

			RefreshCharacter()

			if Humanoid then
				Humanoid.Health = 0
			end
		end
	end
)

