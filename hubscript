local function StopGod()

	if GodConnection then

		GodConnection:Disconnect()

		GodConnection = nil
	end
end

local function StopFly()

	if FlyVelocity then

		FlyVelocity:Destroy()

		FlyVelocity = nil
	end

	if FlyGyro then

		FlyGyro:Destroy()

		FlyGyro = nil
	end
end

local function RestoreCollision()

	for part, oldValue in pairs(
		CollisionMemory
	) do

		if part and part.Parent then

			part.CanCollide =
				oldValue
		end
	end

	table.clear(
		CollisionMemory
	)
end

--============================================================
-- APPLY ACTIVE STATES
--============================================================

local function GetSpeedRemote()

	if SpeedRemote
		and SpeedRemote.Parent then

		return SpeedRemote
	end

	SpeedRemote =
		ReplicatedStorage:FindFirstChild(
			"SpeedControl"
		)

	return SpeedRemote
end

local function StartGod()

	StopGod()

	if not Humanoid
		or not Character then

		return
	end

	Humanoid.MaxHealth =
		math.max(
			Humanoid.MaxHealth,
			100000
		)

	Humanoid.Health =
		Humanoid.MaxHealth

	GodConnection =
		Humanoid.HealthChanged:Connect(
			function()

				if not State.God then
					return
				end

				if Humanoid
					and Humanoid.Health > 0
					and Humanoid.Health <
						Humanoid.MaxHealth then

					Humanoid.Health =
						Humanoid.MaxHealth
				end
			end
		)
end

local function StartFly()

	StopFly()

	if not RootPart then
		return false
	end

	FlyVelocity =
		Instance.new("BodyVelocity")

	FlyVelocity.MaxForce =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	FlyVelocity.Velocity =
		Vector3.zero

	FlyVelocity.Parent =
		RootPart

	FlyGyro =
		Instance.new("BodyGyro")

	FlyGyro.MaxTorque =
		Vector3.new(
			math.huge,
			math.huge,
			math.huge
		)

	FlyGyro.P =
		50000

	FlyGyro.CFrame =
		RootPart.CFrame

	FlyGyro.Parent =
		RootPart

	return true
end

local function ApplyActiveStates()

	if not Humanoid then
		return
	end

	-- SPEED
	if State.Speed then

		local remote =
			GetSpeedRemote()

		if remote then

			pcall(function()

				remote:FireServer(
					"Start",
					CONFIG.SPEED
				)
			end)
		end

		Humanoid.WalkSpeed =
			CONFIG.SPEED
	end

	-- JUMP
	if State.Jump then

		if Humanoid.UseJumpPower then

			Humanoid.JumpPower =
				CONFIG.JUMP

		else

			Humanoid.JumpHeight =
				CONFIG.JUMP
		end
	end

	-- FLY
	if State.Fly then

		StartFly()
	end

	-- GOD
	if State.God then

		StartGod()
	end
end

