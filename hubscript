--============================================================
-- SURUKLENEBILIR OBJE
--============================================================

local function Suruklenebilir(
	tutulabilir,
	hedef
)

	local surukleniyor =
		false

	local suruklemeGirdisi =
		nil

	local suruklemeBaslangici =
		nil

	local hedefBaslangici =
		nil

	tutulabilir.InputBegan:Connect(
		function(
			girdi
		)

			if girdi.UserInputType ==
				Enum.UserInputType.MouseButton1
				or
				girdi.UserInputType ==
					Enum.UserInputType.Touch then

				surukleniyor =
					true

				suruklemeBaslangici =
					girdi.Position

				hedefBaslangici =
					hedef.Position

				suruklemeGirdisi =
					girdi
			end
		end
	)

	Giris.InputChanged:Connect(
		function(
			girdi
		)

			if not surukleniyor then
				return
			end

			if girdi.UserInputType ~=
				Enum.UserInputType.MouseMovement
				and
				girdi.UserInputType ~=
					Enum.UserInputType.Touch then

				return
			end

			local fark =
				girdi.Position -
				suruklemeBaslangici

			local kamera =
				Dunya.CurrentCamera

			local viewport =
				kamera
				and kamera.ViewportSize
				or Vector2.new(
					1920,
					1080
				)

			local genislik =
				hedef.AbsoluteSize.X

			local yukseklik =
				hedef.AbsoluteSize.Y

			local x =
				hedefBaslangici.X.Offset +
				fark.X

			local y =
				hedefBaslangici.Y.Offset +
				fark.Y

			x =
				math.clamp(
					x,
					5,
					math.max(
						5,
						viewport.X -
						genislik -
						5
					)
				)

			y =
				math.clamp(
					y,
					5,
					math.max(
						5,
						viewport.Y -
						yukseklik -
						5
					)
				)

			hedef.Position =
				UDim2.fromOffset(
					x,
					y
				)
		end
	)

	Giris.InputEnded:Connect(
		function(
			girdi
		)

			if not surukleniyor then
				return
			end

			if girdi ==
				suruklemeGirdisi
				or
				girdi.UserInputType ==
					Enum.UserInputType.MouseButton1
				or
				girdi.UserInputType ==
					Enum.UserInputType.Touch then

				surukleniyor =
					false

				suruklemeGirdisi =
					nil
			end
		end
	)
end

