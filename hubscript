Calistirici:BindToRenderStep(
	"AHMET_HUB_AIM",
	Enum.RenderPriority.Camera.Value + 50,
	function(
		deltaTime
	)

		FovGuncelle()


		if not Durum.Aim then

			return

		end


		local kamera =
			Dunya.CurrentCamera


		if not kamera
			or not Govde then

			return

		end


		AimTaramaSayaci +=
			deltaTime


		AimKontrolSayaci +=
			deltaTime


		--======================================================
		-- MEVCUT HEDEF
		--======================================================

		if
			AimHedefi
			and
			AimParcasi
			and
			AimKontrolSayaci >= 0.03
		then


			AimKontrolSayaci =
				0


			local yeniParca =
				AimParcasiBul(
					AimHedefi
				)


			if
				yeniParca
				and
				AimHedefGecerli(
					AimHedefi,
					yeniParca
				)
			then


				AimParcasi =
					yeniParca


			else


				AimTemizle()

			end

		end


		--======================================================
		-- YENİ HEDEF
		--======================================================

		if
			not AimHedefi
			or
			not AimParcasi
			or
			AimTaramaSayaci >=
				AYAR.AIM_DEGISIM
		then


			AimTaramaSayaci =
				0


			local hedef,
				parca =
				EnIyiHedefiBul()


			if
				hedef
				and
				parca
			then


				AimHedefi =
					hedef


				AimParcasi =
					parca


			else


				AimTemizle()

				return

			end

		end


		if not AimHedefi
			or not AimParcasi then

			return
		end


		--======================================================
		-- HEDEF POZİSYONU
		--======================================================

		local hedefKonum =
			TahminliPozisyon(
				AimParcasi
			)


		if not hedefKonum then

			return
		end


		hedefKonum +=
			Vector3.new(
				0,
				AYAR.AIM_YUKSEKLIK,
				0
			)


		local kameraKonumu =
			kamera.CFrame.Position


		local fark =
			hedefKonum -
			kameraKonumu


		if fark.Magnitude <=
			0.001 then

			return

		end


		local hedefCFrame =
			CFrame.lookAt(
				kameraKonumu,
				hedefKonum
			)


		local yumusaklik =
			Sinirla(
				AYAR.AIM_YUMUSAKLIK,
				0.01,
				1
			)


		local alpha =
			1 -
			math.exp(
				-yumusaklik
				*
				12
				*
				deltaTime
			)


		alpha =
			Sinirla(
				alpha,
				0,
				1
			)


		kamera.CFrame =
			kamera.CFrame:Lerp(
				hedefCFrame,
				alpha
			)


		--======================================================
		-- HEDEF YAZISI
		--======================================================

		local mesafe =
			math.floor(
				OyuncuMesafesiAl(
					AimHedefi
				)
			)


		if HedefYazisi then

			HedefYazisi.Text =
				"Hedef: "
				..
				AimHedefi.DisplayName
				..
				"  •  "
				..
				tostring(
					mesafe
				)
				..
				" studs"

		end

	end
)


