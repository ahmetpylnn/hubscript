				)

			return
		end

		sayi =
			math.clamp(
				sayi,
				minimum,
				maksimum
			)

		if artis > 0 then

			sayi =
				math.round(
					sayi / artis
				) *
				artis
		end

		if minimum < 1
			and artis < 1 then

