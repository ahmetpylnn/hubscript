--============================================================
-- AIMLOCK HELPERS
--============================================================

local function GetRoot(player)

	if not player then
		return nil
	end

	local character =
		player.Character

	if not character then
		return nil
	end

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if root
		and root:IsA("BasePart") then

		return root
	end

	return nil
end

local function GetHumanoid(player)

	if not player then
		return nil
	end

	local character =
		player.Character

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass(
		"Humanoid"
	)
end

local function SameTeam(player)

	if not CONFIG.TEAM_CHECK then
		return false
	end

	if not LocalPlayer.Team then
		return false
	end

	if not player.Team then
		return false
	end

	return LocalPlayer.Team ==
		player.Team
end

local function HasLineOfSight(player)

	if not CONFIG.LOS_CHECK then
		return true
	end

	local camera =
		Workspace.CurrentCamera

	local root =
		GetRoot(player)

	if not camera
		or not root then

		return false
	end

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		Character,
		player.Character
	}

	params.IgnoreWater =
		true

	local result =
		Workspace:Raycast(
			camera.CFrame.Position,
			root.Position -
				camera.CFrame.Position,
			params
		)

	return result == nil
end

local function Recent(player)

	for _, p in ipairs(
		AimHistory
	) do

		if p == player then
			return true
		end
	end

	return false
end

local function Remember(player)

	if not player then
		return
	end

	table.insert(
		AimHistory,
		1,
		player
	)

	while #AimHistory >
		CONFIG.AIM_MEMORY do

		table.remove(
			AimHistory
		)
	end
end

--============================================================
-- GET TARGET
--============================================================

local function GetTarget()

	if not RootPart then
		return nil, nil
	end

	local candidates = {}
	local fallback = {}

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer
			and player.Character
			and not SameTeam(player) then

			local hum =
				GetHumanoid(player)

			local root =
				GetRoot(player)

			if hum
				and root
				and hum.Health > 0 then

				local distance =
					(
						RootPart.Position -
						root.Position
					).Magnitude

				if distance <=
					CONFIG.AIM_DISTANCE then

					if HasLineOfSight(
						player
					) then

						local data = {
							Player = player,
							Part = root
						}

						table.insert(
							fallback,
							data
						)

						if not Recent(
							player
						) then

							table.insert(
								candidates,
								data
							)
						end
					end
				end
			end
		end
	end

	-- Önce memory'de olmayanları dene.
	-- Hiç yoksa fallback havuzunu kullan.
	local pool

	if #candidates > 0 then
		pool = candidates
	else
		pool = fallback
	end

	if #pool == 0 then
		return nil, nil
	end

	local selected =
		pool[
			math.random(
				1,
				#pool
			)
		]

	Remember(
		selected.Player
	)

	return selected.Player,
		selected.Part
end

