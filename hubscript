--============================================================
local function AH3_GetWorldDistanceVisualCandidates()
    local candidates = {}
    for instance, meta in pairs(AH3_Cache.Entries) do
        if instance and instance.Parent then
            local interesting =
                (meta.Type == "NPC" and AH3_Config.ESP.NPCs)
                or (meta.Type == "LOOT" and AH3_Config.ESP.Loot)
                or (meta.Type == "OBJECTIVE" and AH3_Config.ESP.Objectives)
                or (meta.Type == "TARGET_OBJECT" and AH3_Config.Target.TaggedObjects)
            if interesting then
                local distance = AH3_DistanceToInstance(instance)
                table.insert(candidates, {
                    Instance = instance,
                    Meta = meta,
                    Distance = distance,
                })
            end
        end
    end
    table.sort(candidates, function(a, b)
        return a.Distance < b.Distance
    end)
    return candidates
end

local function AH3_LimitedWorldESPUpdate()
    if not Durum.ESP or not AH3_Config.ESP.Enabled then
        for instance in pairs(AH3_WorldVisuals) do
            AH3_DestroyWorldVisual(instance)
        end
        return
    end

    local list = AH3_GetWorldDistanceVisualCandidates()
    local keep = {}
    local limit = AH3_Config.ESP.MaxWorldVisuals

    for i = 1, math.min(#list, limit) do
        local item = list[i]
        keep[item.Instance] = true
        local visual = AH3_CreateWorldVisual(item.Instance, item.Meta)
        if visual and visual.Label then
            visual.Label.Text = item.Meta.Type .. ": " .. item.Meta.Name .. "  [" .. tostring(math.floor(item.Distance)) .. "]"
        end
    end

    for instance in pairs(AH3_WorldVisuals) do
        if not keep[instance] then
            AH3_DestroyWorldVisual(instance)
        end
    end
end

AH3_UpdateWorldESP = AH3_LimitedWorldESPUpdate

