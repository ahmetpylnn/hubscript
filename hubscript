function AH3_API.NearestLoot()
    local entries = AH3_FindCachedByType("LOOT")
    local best = nil
    local bestDistance = math.huge
    for _, meta in ipairs(entries) do
        local part = meta.Part or AH3_GetBestPartFromModel(meta.Instance)
        local distance = part and AH3_TargetDistance(part) or math.huge
        if distance < bestDistance then
            bestDistance = distance
            best = meta.Instance
        end
    end
    return best, bestDistance
end

