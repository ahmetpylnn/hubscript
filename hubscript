local function V31CreateLine(parent)
    local frame = Instance.new("Frame")
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.BorderSizePixel = 0
    frame.BackgroundColor3 = Color3.fromRGB(235, 70, 76)
    frame.Visible = false
    frame.Parent = parent
    return frame
end

local function V31UpdateLine(frame, a, b, thickness)
    if not frame then
        return
    end

    local delta = b - a
    local length = delta.Magnitude

    frame.Size = UDim2.fromOffset(
        length,
        thickness or 2
    )

    frame.Position = UDim2.fromOffset(
        (a.X + b.X) * 0.5,
        (a.Y + b.Y) * 0.5
    )

    frame.Rotation = math.deg(
        math.atan2(
            delta.Y,
            delta.X
        )
    )

    frame.Visible = true
end

local function V31HideLine(frame)
    if frame then
        frame.Visible = false
    end
end

local function V31CreateBox(parent)
    return {
        V31CreateLine(parent),
        V31CreateLine(parent),
        V31CreateLine(parent),
        V31CreateLine(parent),
    }
end

local function V31DestroyLines(lines)
    if not lines then
        return
    end
    for _, line in ipairs(lines) do
        V31Destroy(line)
    end
end

local function V31GetBox(character, camera)
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local head = character and character:FindFirstChild("Head")

    if not root or not head then
        return nil
    end

    local topWorld = head.Position + Vector3.new(0, 0.8, 0)
    local bottomWorld = root.Position - Vector3.new(0, 3, 0)

    local top = camera:WorldToViewportPoint(topWorld)
    local bottom = camera:WorldToViewportPoint(bottomWorld)

    if top.Z <= 0 or bottom.Z <= 0 then
        return nil
    end

    local height = math.abs(bottom.Y - top.Y)
    local width = math.max(10, height * 0.45)

    return {
        left = top.X - width * 0.5,
        right = top.X + width * 0.5,
        top = top.Y,
        bottom = bottom.Y,
    }
end

local function V31MakeBillboard(character, color)
    local head = character and character:FindFirstChild("Head")
    if not head then
        return nil
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "AHMET_HUB_V31_INFO"
    billboard.Adornee = head
    billboard.Size = UDim2.fromOffset(180, 58)
    billboard.StudsOffset = Vector3.new(0, 3.2, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 0
    billboard.Parent = head

    local background = Instance.new("Frame")
    background.Size = UDim2.fromScale(1, 1)
    background.BackgroundColor3 = Color3.fromRGB(7, 7, 7)
    background.BackgroundTransparency = 0.20
    background.BorderSizePixel = 0
    background.Parent = billboard

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = background

    local stroke = Instance.new("UIStroke")
    stroke.Color = color
    stroke.Thickness = 1
    stroke.Transparency = 0.15
    stroke.Parent = background

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -12, 1, -8)
    label.Position = UDim2.fromOffset(6, 4)
    label.BackgroundTransparency = 1
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.5
    label.Font = Enum.Font.GothamBold
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.TextYAlignment = Enum.TextYAlignment.Center
    label.TextWrapped = true
    label.Parent = background

    return {
        Billboard = billboard,
        Label = label,
        Stroke = stroke,
    }
end

function V31:GetESPColor(player)
    if player and self.Config.ESP.Team and player.Team then
        return player.Team.TeamColor.Color
    end
    return Color3.fromRGB(235, 70, 76)
end

function V31:CreatePlayerESP(player)
    if not player or player == YerelOyuncu then
        return
    end

    local character = V31GetCharacter(player)
    if not character then
        return
    end

    local humanoid = V31GetHumanoid(character)
    local root = V31GetRoot(character)
    if not humanoid or not root or not V31IsAliveHumanoid(humanoid) then
        return
    end

    self:DestroyPlayerESP(player)

    local visual = {
        Player = player,
        Character = character,
        Lines = {},
    }

    local overlay = self.UI.ESPOverlay
    local color = self:GetESPColor(player)

    if self.Config.ESP.Box then
        visual.Box = V31CreateBox(overlay)
    end

    if self.Config.ESP.Tracer then
        visual.Tracer = V31CreateLine(overlay)
    end

    if self.Config.ESP.Highlight then
        local highlight = Instance.new("Highlight")
        highlight.Name = "AHMET_HUB_V31_ESP"
        highlight.Adornee = character
        highlight.FillColor = color
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.65
        highlight.OutlineTransparency = 0
        highlight.DepthMode = self.Config.ESP.Wall
            and Enum.HighlightDepthMode.AlwaysOnTop
            or Enum.HighlightDepthMode.Occluded
        highlight.Parent = character
        visual.Highlight = highlight
    end

    if self.Config.ESP.Skeleton then
        visual.Skeleton = {}
        for _ = 1, 15 do
            table.insert(visual.Skeleton, V31CreateLine(overlay))
        end
    end

    if self.Config.ESP.Name
        or self.Config.ESP.Health
        or self.Config.ESP.Distance
        or self.Config.ESP.Team then

        visual.Info = V31MakeBillboard(character, color)
    end

    self.ESP[player] = visual
    self.State.ESPVisualCount = self.State.ESPVisualCount + 1
end

function V31:DestroyPlayerESP(player)
    local visual = self.ESP[player]
    if not visual then
        return
    end

    if visual.Highlight then
        V31Destroy(visual.Highlight)
    end

    if visual.Info and visual.Info.Billboard then
        V31Destroy(visual.Info.Billboard)
    end

    if visual.Box then
        V31DestroyLines(visual.Box)
    end

    V31Destroy(visual.Tracer)

    if visual.Skeleton then
        V31DestroyLines(visual.Skeleton)
    end

    self.ESP[player] = nil
    self.State.ESPVisualCount = math.max(0, self.State.ESPVisualCount - 1)
end

local skeletonPairsR15 = {
    { "Head", "UpperTorso" },
    { "UpperTorso", "LowerTorso" },
    { "UpperTorso", "LeftUpperArm" },
    { "LeftUpperArm", "LeftLowerArm" },
    { "LeftLowerArm", "LeftHand" },
    { "UpperTorso", "RightUpperArm" },
    { "RightUpperArm", "RightLowerArm" },
    { "RightLowerArm", "RightHand" },
    { "LowerTorso", "LeftUpperLeg" },
    { "LeftUpperLeg", "LeftLowerLeg" },
    { "LeftLowerLeg", "LeftFoot" },
    { "LowerTorso", "RightUpperLeg" },
    { "RightUpperLeg", "RightLowerLeg" },
    { "RightLowerLeg", "RightFoot" },
}

local skeletonPairsR6 = {
    { "Head", "Torso" },
    { "Torso", "Left Arm" },
    { "Left Arm", "Left Leg" },
    { "Torso", "Right Arm" },
    { "Right Arm", "Right Leg" },
    { "Torso", "Left Leg" },
    { "Torso", "Right Leg" },
}

function V31:UpdatePlayerESP(player, visual)
    if not visual then
        return
    end

    local character = V31GetCharacter(player)
    if not character then
        self:DestroyPlayerESP(player)
        return
    end

    local humanoid = V31GetHumanoid(character)
    local root = V31GetRoot(character)
    if not humanoid or not root or not V31IsAliveHumanoid(humanoid) then
        self:DestroyPlayerESP(player)
        return
    end

    local distance = V31DistanceTo(root.Position)
    if self.Config.ESP.MaxDistance > 0
        and distance > self.Config.ESP.MaxDistance then
        if visual.Box then
            for _, line in ipairs(visual.Box) do
                V31HideLine(line)
            end
        end
        V31HideLine(visual.Tracer)
        return
    end

    local camera = V31Workspace.CurrentCamera
    if not camera then
        return
    end

    local color = self:GetESPColor(player)

    if visual.Highlight then
        visual.Highlight.FillColor = color
        visual.Highlight.DepthMode = self.Config.ESP.Wall
            and Enum.HighlightDepthMode.AlwaysOnTop
            or Enum.HighlightDepthMode.Occluded
        visual.Highlight.FillTransparency = 0.65
    end

    if visual.Info and visual.Info.Label then
        local lines = {}

        if self.Config.ESP.Name then
            table.insert(lines, player.DisplayName)
        end

        local details = {}
        if self.Config.ESP.Health then
            table.insert(details,
                "HP " .. math.floor(humanoid.Health) .. "/" .. math.floor(humanoid.MaxHealth))
        end
        if self.Config.ESP.Distance then
            table.insert(details, math.floor(distance) .. " studs")
        end
        if self.Config.ESP.Team and player.Team then
            table.insert(details, player.Team.Name)
        end

        if #details > 0 then
            table.insert(lines, table.concat(details, "  •  "))
        end

        visual.Info.Label.Text = table.concat(lines, "\n")
        visual.Info.Label.TextColor3 = color
        visual.Info.Stroke.Color = color
    end

    if visual.Box then
        local box = V31GetBox(character, camera)
        if box then
            V31UpdateLine(visual.Box[1], Vector2.new(box.left, box.top), Vector2.new(box.right, box.top), 2)
            V31UpdateLine(visual.Box[2], Vector2.new(box.right, box.top), Vector2.new(box.right, box.bottom), 2)
            V31UpdateLine(visual.Box[3], Vector2.new(box.right, box.bottom), Vector2.new(box.left, box.bottom), 2)
            V31UpdateLine(visual.Box[4], Vector2.new(box.left, box.bottom), Vector2.new(box.left, box.top), 2)
            for _, line in ipairs(visual.Box) do
                line.BackgroundColor3 = color
            end
        else
            for _, line in ipairs(visual.Box) do
                V31HideLine(line)
            end
        end
    end

    if visual.Tracer then
        local rootPoint, visible = camera:WorldToViewportPoint(root.Position)
        if visible and rootPoint.Z > 0 then
            local start = Vector2.new(
                camera.ViewportSize.X * 0.5,
                camera.ViewportSize.Y
            )
            local finish = Vector2.new(rootPoint.X, rootPoint.Y)
            V31UpdateLine(visual.Tracer, start, finish, 2)
            visual.Tracer.BackgroundColor3 = color
        else
            V31HideLine(visual.Tracer)
        end
    end

    if visual.Skeleton then
        local pairsToUse = character:FindFirstChild("UpperTorso")
            and skeletonPairsR15
            or skeletonPairsR6

        for index, pair in ipairs(pairsToUse) do
            local a = character:FindFirstChild(pair[1])
            local b = character:FindFirstChild(pair[2])
            local line = visual.Skeleton[index]

            if line and a and b
                and a:IsA("BasePart")
                and b:IsA("BasePart") then

                local pa, va = camera:WorldToViewportPoint(a.Position)
                local pb, vb = camera:WorldToViewportPoint(b.Position)

                if va and vb and pa.Z > 0 and pb.Z > 0 then
                    V31UpdateLine(
                        line,
                        Vector2.new(pa.X, pa.Y),
                        Vector2.new(pb.X, pb.Y),
                        1
                    )
                    line.BackgroundColor3 = color
                else
                    V31HideLine(line)
                end
            elseif line then
                V31HideLine(line)
            end
        end

        for i = #pairsToUse + 1, #visual.Skeleton do
            V31HideLine(visual.Skeleton[i])
        end
    end
end

function V31:RefreshESP()
    for player in pairs(self.ESP) do
        self:DestroyPlayerESP(player)
    end

    if not self.Config.ESP.Enabled then
        return
    end

    if not self.UI.ESPOverlay then
        return
    end

    if self.Config.ESP.Players then
        for _, player in ipairs(V31Players:GetPlayers()) do
            if player ~= YerelOyuncu then
                self:CreatePlayerESP(player)
            end
        end
    end
end

function V31:UpdateESP()
    if not self.Config.ESP.Enabled then
        return
    end

    for player, visual in pairs(self.ESP) do
        self:UpdatePlayerESP(player, visual)
    end
end

