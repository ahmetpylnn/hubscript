--============================================================

pcall(function()

	RunService:UnbindFromRenderStep(
		"PLAYER_CONTROL_AIM"
	)
end)

RunService:BindToRenderStep(
	"PLAYER_CONTROL_AIM",
	2000,
	function(delta)

		if not State.AimLock then
			return
		end

		local camera =
			Workspace.CurrentCamera

		if not camera
			or not RootPart then

			return
		end

		AimTimer += delta

		local valid = false

		if AimTarget
			and AimPart
			and AimTarget.Character then

			local hum =
				GetHumanoid(
					AimTarget
				)

			local root =
				GetRoot(
					AimTarget
				)

			if hum
				and root
				and hum.Health > 0
				and not SameTeam(
					AimTarget
				)
				and HasLineOfSight(
					AimTarget
				) then

				local distance =
					(
						RootPart.Position -
						root.Position
					).Magnitude

				if distance <=
					CONFIG.AIM_DISTANCE then

					AimPart =
						root

					valid = true
				end
			end
		end

		if not valid
			or AimTimer >=
				CONFIG.AIM_SWITCH then

			AimTimer = 0

			AimTarget,
			AimPart =
				GetTarget()
		end

		if not AimTarget
			or not AimPart then

			Status.Text =
				"AimLock aktif.\n" ..
				"Hedef bulunamadı."

			return
		end

		local targetPosition =
			AimPart.Position +
			Vector3.new(
				0,
				CONFIG.AIM_HEIGHT,
				0
			)

		local targetCFrame =
			CFrame.lookAt(
				camera.CFrame.Position,
				targetPosition
			)

		camera.CFrame =
			camera.CFrame:Lerp(
				targetCFrame,
				CONFIG.AIM_SMOOTH
			)

		Status.Text =
			"AimLock AKTİF\n" ..
			"Hedef: " ..
			AimTarget.Name
	end
)

