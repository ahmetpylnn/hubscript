function V31:RefreshTracker()
    local container = self.UI.TrackerList
    if not container then
        return
    end

    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("Frame") then
            V31Destroy(child)
        end
    end

    for _, player in ipairs(V31Players:GetPlayers()) do
        if player ~= YerelOyuncu then
            local character = V31GetCharacter(player)
            local root = character and V31GetRoot(character)
            local humanoid = character and V31GetHumanoid(character)

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 38)
            row.BackgroundColor3 = Renk.Kart
            row.BorderSizePixel = 0
            row.Parent = container

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 7)
            corner.Parent = row

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, -74, 1, 0)
            label.Position = UDim2.fromOffset(8, 0)
            label.BackgroundTransparency = 1
            label.TextColor3 = Renk.Beyaz
            label.Font = Enum.Font.GothamMedium
            label.TextSize = 9
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = row

            local distanceText = "-"
            if root then
                distanceText = tostring(math.floor(V31DistanceTo(root.Position))) .. "s"
            end

            local hpText = "-"
            if humanoid then
                hpText = tostring(math.floor(humanoid.Health)) .. " HP"
            end

            label.Text = player.DisplayName .. "   •   " .. distanceText .. "   •   " .. hpText

            local tpButton = Instance.new("TextButton")
            tpButton.Size = UDim2.fromOffset(58, 28)
            tpButton.Position = UDim2.new(1, -64, 0.5, -14)
            tpButton.BackgroundColor3 = Renk.KirmiziKoyu2
            tpButton.BorderSizePixel = 0
            tpButton.Text = "GİT"
            tpButton.TextColor3 = Renk.Beyaz
            tpButton.Font = Enum.Font.GothamBold
            tpButton.TextSize = 8
            tpButton.Parent = row

            local tpCorner = Instance.new("UICorner")
            tpCorner.CornerRadius = UDim.new(0, 6)
            tpCorner.Parent = tpButton

            tpButton.Activated:Connect(function()
                local localRoot = V31GetLocalRoot()
                local targetCharacter = V31GetCharacter(player)
                local targetRoot = targetCharacter and V31GetRoot(targetCharacter)
                if localRoot and targetRoot then
                    localRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, -4)
                    BildirimGoster("Tracker", player.Name .. " yanına gidildi.")
                end
            end)
        end
    end
end

