--============================================================
-- KARAKTER YÜKLE
--============================================================

local function KarakterYukle(
	yeniKarakter
)

	Karakter =
		yeniKarakter

	Humanoid =
		yeniKarakter:WaitForChild(
			"Humanoid",
			10
		)

	Govde =
		yeniKarakter:WaitForChild(
			"HumanoidRootPart",
			10
		)

	if not Humanoid
		or not Govde then

		return
	end

	OrijinalHiz =
		Humanoid.WalkSpeed

	OrijinalJumpPowerKullan =
		Humanoid.UseJumpPower

	OrijinalJumpPower =
		Humanoid.JumpPower

	OrijinalJumpHeight =
		Humanoid.JumpHeight

	OrijinalAutoRotate =
		Humanoid.AutoRotate

	if Durum.Hiz then

		Humanoid.WalkSpeed =
			AYAR.HIZ
	end

	if Durum.Ziplama then

		if Humanoid.UseJumpPower then

			Humanoid.JumpPower =
				AYAR.ZIPLAMA

		else

			Humanoid.JumpHeight =
				AYAR.ZIPLAMA
		end
	end

	if Durum.God then
		GodBaslat()
	end

	if Durum.Fly then

		task.defer(
			function()

				if Durum.Fly then
					FlyBaslat()
