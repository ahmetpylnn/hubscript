local function AH3_CycleTargetSource()
    local order = {"Players", "Players + NPC", "NPC", "Everything"}
    local index = table.find(order, AH3_Config.Target.Source) or 1
    index += 1
    if index > #order then index = 1 end
    AH3_Config.Target.Source = order[index]
    BildirimGoster("Target Source", AH3_Config.Target.Source)
    if Durum.Aim then
        AimTemizle()
    end
end

local function AH3_Score(candidate)
    local mode = AH3_Config.Target.Priority
    if mode == "Screen" then
        return 1000000 / math.max(candidate.Screen, 1)
    elseif mode == "Low Health" then
        local ratio = candidate.Health / math.max(candidate.MaxHealth, 1)
        return (1 - ratio) * 500000 + 100000 / math.max(candidate.Distance, 1)
    elseif mode == "Smart" then
        local distanceScore = 120000 / math.max(candidate.Distance, 1)
        local screenScore = 80000 / math.max(candidate.Screen, 10)
        local visibilityBonus = candidate.Visible and 50000 or 0
        return distanceScore + screenScore + visibilityBonus
    else
        return 100000000 / math.max(candidate.Distance, 1)
    end
end

local function AH3_SelectTarget()
    local candidates = AH3_AllCandidates()
    local best = nil
    local bestScore = -math.huge
    for _, candidate in ipairs(candidates) do
        local score = AH3_Score(candidate)
        if AH3_Config.Target.Sticky and AH3_State.CurrentTarget == candidate.Target then
            score += 25000
        end
        if score > bestScore then
            bestScore = score
            best = candidate
        end
    end
    return best
end

local function AH3_PredictedPosition(part)
    if not part then return nil end
    local position = part.Position
    if AH3_Config.Target.Prediction then
        position += part.AssemblyLinearVelocity * AH3_Config.Target.PredictionTime
    end
    position += Vector3.new(0, AH3_Config.Target.Height, 0)
    return position
end

