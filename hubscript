--============================================================
-- AIM RENDER
--============================================================

Calistirici:BindToRenderStep(
	"OyuncuKontrol_Aim",
	Enum.RenderPriority.Camera.Value + 50,
	function(deltaTime)

		if not Durum.Aim then

			FovGuncelle()

			return
		end

		local kamera =
			Dunya.CurrentCamera

		if not kamera
			or not Govde then

			return
		end

		AimSayaci +=
			deltaTime

		AimTaramaSayaci +=
			deltaTime

		AimKontrolSayaci +=
			deltaTime

		--====================================================
		-- MEVCUT HEDEFİ KONTROL
		--====================================================

		if AimHedefi
			and AimParcasi
			and AimKontrolSayaci >=
				0.03 then

			AimKontrolSayaci = 0

			local yeniParca =
				AimParcasiAl(
					AimHedefi
				)

			if yeniParca
				and HedefGecerliMi(
					AimHedefi,
					yeniParca
				) then

				AimParcasi =
					yeniParca

			else

				AimTemizle()
			end
		end

		--====================================================
		-- HEDEF TARAMA
		--====================================================

		if not AimHedefi
			or not AimParcasi
			or AimTaramaSayaci >=
				AYAR.AIM_DEGISIM then

			AimTaramaSayaci = 0

			local oyuncu,
				parca =
				EnIyiHedefiBul()

			if oyuncu
				and parca then

				AimHedefi =
					oyuncu

				AimParcasi =
					parca

				AimSayaci = 0

			else

				AimTemizle()

				DurumGuncelle(
					"Aim aktif • Uygun oyuncu bulunamadı."
				)

				return
			end
		end

		if not AimHedefi
			or not AimParcasi then

			return
		end

		--====================================================
		-- POZİSYON
		--====================================================

		local hedefKonum =
			TahminliPozisyon(
				AimParcasi
			)

		if not hedefKonum then
			return
		end

		hedefKonum +=
			Vector3.new(
				0,
				AYAR.AIM_YUKSEKLIK,
				0
			)

		--====================================================
		-- KAMERA
		--====================================================

		local kameraKonum =
			kamera.CFrame.Position

		local fark =
			hedefKonum -
			kameraKonum

		if fark.Magnitude <=
			0.001 then

			return
		end

		local hedefCFrame =
			CFrame.lookAt(
				kameraKonum,
				hedefKonum
			)

		local yumusaklik =
			math.clamp(
				AYAR.AIM_YUMUSAKLIK,
				0.01,
				1
			)

		if yumusaklik >= 1 then

			kamera.CFrame =
				hedefCFrame

		else

			local alpha =
				math.clamp(
					yumusaklik *
					12 *
					deltaTime,
					0,
					1
				)

			kamera.CFrame =
				kamera.CFrame:Lerp(
					hedefCFrame,
					alpha
				)
		end

		--====================================================
		-- DURUM
		--====================================================

		local mesafe =
			math.floor(
				(
					Govde.Position -
					AimParcasi.Position
				).Magnitude
			)

		DurumGuncelle(
			"AIM AKTİF  •  " ..
			AimHedefi.Name ..
			"  •  " ..
			tostring(
				mesafe
			) ..
			" studs"
		)

		FovGuncelle()
	end
)

