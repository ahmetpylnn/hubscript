local function ESPYenile()

	for oyuncu in pairs(
		ESPNesneleri
	) do

		ESPSil(
			oyuncu
		)
	end

	if not Durum.ESP then
		return
	end

	for _, oyuncu in ipairs(
		Oyuncular:GetPlayers()
	) do

		if oyuncu ~=
			YerelOyuncu then

			ESPEkle(
				oyuncu
			)
		end
	end
end

--============================================================
-- GOD DURDUR
--============================================================

local function GodDurdur()

	if GodBaglantisi then

		GodBaglantisi:Disconnect()

		GodBaglantisi = nil
	end
end

--============================================================
-- GOD BASLAT
--============================================================

local function GodBaslat()

	GodDurdur()

	if not Humanoid
		or not Karakter then

		return false
	end

	Humanoid.MaxHealth =
		math.max(
			Humanoid.MaxHealth,
			100000
		)

	Humanoid.Health =
		Humanoid.MaxHealth

	GodBaglantisi =
		Humanoid.HealthChanged:Connect(
			function()

				if not Durum.God then
					return
				end

				if not Humanoid
					or Humanoid.Health <= 0 then

					return
				end

				if Humanoid.Health <
					Humanoid.MaxHealth then

					Humanoid.Health =
						Humanoid.MaxHealth
				end
			end
		)

	return true
end

