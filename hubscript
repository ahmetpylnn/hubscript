--============================================================
-- TELEPORT
--============================================================

local function TeleportYap(
	ekranKonumu
)

	if not Karakter
		or not Karakter.Parent
		or not Govde
		or not Govde.Parent then

		Karakter =
			YerelOyuncu.Character

		if Karakter then

			Humanoid =
				Karakter:FindFirstChildOfClass(
					"Humanoid"
				)

			Govde =
				Karakter:FindFirstChild(
					"HumanoidRootPart"
				)
		end
	end

	if not Karakter
		or not Govde then

		DurumGuncelle(
			"Teleport • Karakter hazir degil.",
			2
		)

		return
	end

	local kamera =
		Dunya.CurrentCamera

	if not kamera then
		return
	end

	-- Ekran koordinatindan viewport koordinatina
	local ustSolInset =
		ArayuzHizmeti:GetGuiInset()

	local viewportX =
		ekranKonumu.X -
		ustSolInset.X

	local viewportY =
		ekranKonumu.Y -
		ustSolInset.Y

	-- Negatif degerleri engelle
	viewportX =
		math.max(
			0,
			viewportX
		)

	viewportY =
		math.max(
			0,
			viewportY
		)

	local isin =
		kamera:ViewportPointToRay(
			viewportX,
			viewportY,
			0
		)

	local parametre =
		RaycastParams.new()

	parametre.FilterType =
		Enum.RaycastFilterType.Exclude

	parametre.FilterDescendantsInstances = {
		Karakter
	}

	parametre.IgnoreWater =
		true

	local sonuc =
		Dunya:Raycast(
			isin.Origin,
			isin.Direction *
				AYAR.TELEPORT_MESAFE,
			parametre
		)

	if not sonuc then

		DurumGuncelle(
			"Teleport • Yuzey bulunamadi.",
			2
		)

		return
	end

	local hedef =
		sonuc.Position

	if sonuc.Normal.Y >=
		0.6 then

		hedef +=
			Vector3.new(
				0,
				AYAR.TELEPORT_YUKSEKLIK,
				0
			)

	else

		hedef +=
			sonuc.Normal *
			math.max(
				AYAR.TELEPORT_YUKSEKLIK,
				1
			)
	end

	local bakis =
		Govde.CFrame.LookVector

	local yatay =
		Vector3.new(
			bakis.X,
			0,
			bakis.Z
		)

	if yatay.Magnitude <
		0.001 then

		yatay =
			Vector3.new(
				0,
				0,
				-1
			)

	else

		yatay =
			yatay.Unit
	end

	Govde.AssemblyLinearVelocity =
		Vector3.zero

	Govde.AssemblyAngularVelocity =
		Vector3.zero

	Karakter:PivotTo(
		CFrame.lookAt(
			hedef,
			hedef + yatay
		)
	)

	Govde.AssemblyLinearVelocity =
		Vector3.zero

	Govde.AssemblyAngularVelocity =
		Vector3.zero

	DurumGuncelle(
		"Teleport basarili.",
		1.5
	)
end

