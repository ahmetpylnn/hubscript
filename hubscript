-- V3 EVENT-DRIVEN CACHE EXTENSIONS
--============================================================
local AH3_ExtraConnections = {}

local function AH3_ConnectRootEvents(root)
    if not root then
        return
    end
    local ok1, c1 = pcall(function()
        return root.DescendantAdded:Connect(function(instance)
            AH3_IndexInstance(instance)
            AH3_MarkDirty(instance)
        end)
    end)
    if ok1 and c1 then
        table.insert(AH3_ExtraConnections, c1)
    end
    local ok2, c2 = pcall(function()
        return root.DescendantRemoving:Connect(function(instance)
            AH3_UnindexInstance(instance)
            AH3_Dirty[instance] = nil
        end)
    end)
    if ok2 and c2 then
        table.insert(AH3_ExtraConnections, c2)
    end
end

local function AH3_InstallExtraCacheSignals()
    for _, connection in ipairs(AH3_ExtraConnections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(AH3_ExtraConnections)
    AH3_ConnectRootEvents(Dunya)
    AH3_ConnectRootEvents(AH3_SafeCall(function() return game:GetService("ReplicatedStorage") end, nil))
    AH3_ConnectRootEvents(AH3_SafeCall(function() return game:GetService("Lighting") end, nil))
    AH3_ConnectRootEvents(AH3_SafeCall(function() return game:GetService("ReplicatedFirst") end, nil))
    AH3_ConnectRootEvents(AH3_SafeCall(function() return game:GetService("SoundService") end, nil))
end

