			Humanoid:ChangeState(
				Enum.HumanoidStateType.Jumping
			)
		end
	end
)

--============================================================
-- AIMLOCK LOOP
--============================================================

RunService:BindToRenderStep(
	"PLAYER_CONTROL_AIM",
	Enum.RenderPriority.Camera.Value + 100,
	function(deltaTime)

		if not State.AimLock then

			UpdateFOVCircle()

			return
		end

		local camera =
			Workspace.CurrentCamera

		if not camera
			or not RootPart then

			return
		end

		AimTimer +=
			deltaTime

		AimScanTimer +=
			deltaTime

		AimValidationTimer +=
			deltaTime

		--====================================================
		-- CURRENT TARGET VALIDATION
		--====================================================

		if AimTarget
			and AimPart
			and AimValidationTimer >=
				0.03 then

			AimValidationTimer = 0

			local newPart =
				GetAimPart(
					AimTarget
				)

			if newPart
				and IsValidTarget(
					AimTarget,
					newPart
				) then

				AimPart =
					newPart

			else

				ClearAim()
			end
		end

		--====================================================
		-- SEARCH
		--====================================================

		if not AimTarget
			or not AimPart
			or AimScanTimer >=
				CONFIG.AIM_SWITCH then

			AimScanTimer = 0

			local player,
				part =
				FindNearestPlayer()

			if player
				and part then

				if AimTarget ~=
					player then

					AimTimer = 0
				end

				AimTarget =
					player

				AimPart =
					part

			else

				ClearAim()

				SetStatus(
					"Nearest Player Aim aktif.\n" ..
					"Uygun oyuncu bulunamadı."
				)

				return
			end
		end

		if not AimTarget
			or not AimPart then

			return
		end

		--====================================================
		-- TARGET POSITION
		--====================================================

		local targetPosition =
			GetPredictedPosition(
				AimPart
			)

		if not targetPosition then
			return
		end

		targetPosition +=
			Vector3.new(
				0,
				CONFIG.AIM_HEIGHT,
				0
			)

		--====================================================
		-- CAMERA AIM
		--====================================================

		local cameraPosition =
			camera.CFrame.Position

		local difference =
			targetPosition -
			cameraPosition

		if difference.Magnitude <
			0.001 then

			return
		end

		local desired =
			CFrame.lookAt(
				cameraPosition,
				targetPosition
			)

		local smooth =
			math.clamp(
				CONFIG.AIM_SMOOTH,
				0.01,
				1
			)

		camera.CFrame =
			camera.CFrame:Lerp(
				desired,
				smooth
			)

		--====================================================
		-- STATUS
		--====================================================

		local distance =
			math.floor(
				GetDistance(
					AimPart.Position
				)
			)

		local targetName =
			AimTarget.DisplayName
			or AimTarget.Name

		SetStatus(
			"AIMLOCK ACTIVE  •  " ..
			targetName ..
			"  •  " ..
			tostring(
				distance
			) ..
			" studs"
		)

		UpdateFOVCircle()
	end
)

--============================================================
-- TELEPORT RAY
--============================================================

local function GetMouseRay()

	local camera =
		Workspace.CurrentCamera

	if not camera then
		return nil, nil
	end

	local mousePosition =
		UserInputService:GetMouseLocation()

	local ray =
		camera:ViewportPointToRay(
			mousePosition.X,
			mousePosition.Y
		)

	return ray.Origin,
		ray.Direction
end

local function TeleportToMouse()

	if not Character
		or not RootPart then

		RefreshCharacter()

	end

	if not RootPart
		or not Character then

		SetStatus(
			"Teleport: karakter hazır değil."
		)

		return
	end

	local origin,
		direction =
		GetMouseRay()

	if not origin
		or not direction then

		SetStatus(
			"Teleport: mouse ray alınamadı."
		)

		return
	end

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances = {
		Character,
	}

	params.IgnoreWater =
		true

	local result =
		Workspace:Raycast(
			origin,
			direction.Unit *
				CONFIG.TELEPORT_DISTANCE,
			params
		)

	if not result then

		SetStatus(
			"Teleport: yüzey bulunamadı."
		)

		return
	end

	local targetPosition =
		result.Position

	local offset =
		CONFIG.TELEPORT_HEIGHT

	if result.Normal.Y >= 0.6 then

		targetPosition +=
			Vector3.new(
				0,
				offset,
				0
			)

	else

		targetPosition +=
			result.Normal *
			math.max(
				offset,
				1
			)
	end

	RootPart.AssemblyLinearVelocity =
		Vector3.zero

	RootPart.AssemblyAngularVelocity =
		Vector3.zero

	Character:PivotTo(
		CFrame.new(
			targetPosition
		)
	)

	RootPart.AssemblyLinearVelocity =
		Vector3.zero

	RootPart.AssemblyAngularVelocity =
		Vector3.zero

	SetStatus(
		"Teleport başarılı."
	)
end

