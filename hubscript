local function KarakterAl(
	oyuncu
)

	if not oyuncu then
		return nil
	end


	local karakter =
		oyuncu.Character


	if not karakter
		or not karakter.Parent then

		return nil
	end


	return karakter
end


local function HumanoidAl(
	oyuncu
)

	local karakter =
		KarakterAl(
			oyuncu
		)

	if not karakter then
		return nil
	end


	return karakter:FindFirstChildOfClass(
		"Humanoid"
	)

end


local function GovdeAl(
	oyuncu
)

	local karakter =
		KarakterAl(
			oyuncu
		)

	if not karakter then
		return nil
	end


	local govde =
		karakter:FindFirstChild(
			"HumanoidRootPart"
		)


	if govde
		and govde:IsA(
			"BasePart"
		) then

		return govde
	end


	return nil
end


--============================================================
-- AIM PARÇASI
--============================================================

local function AimParcasiBul(
	oyuncu
)

	local karakter =
		KarakterAl(
			oyuncu
		)

	if not karakter then
		return nil
	end


	local tercih =
		AYAR.AIM_PARCA


	local hedefAd


	if tercih == "Baş" then

		hedefAd =
			"Head"

	elseif tercih == "Gövde" then

		hedefAd =
			"HumanoidRootPart"

	else

		hedefAd =
			"Head"

	end


	local hedef =
		karakter:FindFirstChild(
			hedefAd
		)


	if hedef
		and hedef:IsA(
			"BasePart"
		) then

		return hedef
	end


	local yedekler = {

		"Head",

		"HumanoidRootPart",

		"UpperTorso",

		"Torso",

		"LowerTorso",
	}


	for _, ad in ipairs(
		yedekler
	) do

		local parca =
			karakter:FindFirstChild(
				ad
			)

		if parca
			and parca:IsA(
				"BasePart"
			) then

			return parca
		end
	end


	return karakter:FindFirstChildWhichIsA(
		"BasePart",
		true
	)

end


local function YasiyorMu(
	oyuncu
)

	if not oyuncu
		or oyuncu == YerelOyuncu then

		return false
	end


	local humanoid =
		HumanoidAl(
			oyuncu
		)

	local parca =
		AimParcasiBul(
			oyuncu
		)


	if not humanoid
		or not parca then

		return false
	end


	return humanoid.Health > 0
end


