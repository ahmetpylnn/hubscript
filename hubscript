local function SayiSinirla(
	deger,
	minimum,
	maksimum,
	varsayilan
)

	local sayi =
		tonumber(deger)

	if not sayi then
		return varsayilan
	end

	return math.clamp(
		sayi,
		minimum,
		maksimum
	)
end

