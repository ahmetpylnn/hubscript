--============================================================
-- SÜRÜKLEME
--============================================================

local Surukleniyor =
	false

local SuruklemeBaslangic =
	nil

local PanelBaslangic =
	nil

Baslik.InputBegan:Connect(
	function(
		girdi
	)

		if girdi.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			Surukleniyor =
				true

			SuruklemeBaslangic =
				girdi.Position

			PanelBaslangic =
				AnaPanel.Position
		end
	end
)

Giris.InputChanged:Connect(
	function(
		girdi
	)

		if not Surukleniyor then
			return
		end

		if girdi.UserInputType ~=
			Enum.UserInputType.MouseMovement then

			return
		end

		local fark =
			girdi.Position -
			SuruklemeBaslangic

		AnaPanel.Position =
			UDim2.new(
				PanelBaslangic.X.Scale,
				PanelBaslangic.X.Offset +
					fark.X,

				PanelBaslangic.Y.Scale,
				PanelBaslangic.Y.Offset +
					fark.Y
			)
	end
)

Giris.InputEnded:Connect(
	function(
		girdi
	)

		if girdi.UserInputType ==
			Enum.UserInputType.MouseButton1 then

			Surukleniyor =
				false
		end
	end
)

