Giris.InputBegan:Connect(function(girdi, islenmis)
    if islenmis then return end
    if girdi.KeyCode == Enum.KeyCode.F2 then
        if AH3_Tracker then
            AH3_RefreshTracker()
            AH3_Tracker.Visible = not AH3_Tracker.Visible
        end
    elseif girdi.KeyCode == Enum.KeyCode.F3 then
        AH3_Config.ESP.Tracer = not AH3_Config.ESP.Tracer
        BildirimGoster("ESP Tracer", AH3_Config.ESP.Tracer and "AÇIK" or "KAPALI")
    elseif girdi.KeyCode == Enum.KeyCode.F4 then
        AH3_Config.ESP.Box = not AH3_Config.ESP.Box
        BildirimGoster("ESP Box", AH3_Config.ESP.Box and "AÇIK" or "KAPALI")
    elseif girdi.KeyCode == Enum.KeyCode.F5 then
        AH3_CycleTargetPriority()
    elseif girdi.KeyCode == Enum.KeyCode.F6 then
        AH3_CycleTargetPart()
    elseif girdi.KeyCode == Enum.KeyCode.F7 then
        AH3_StartWorldScan()
    elseif girdi.KeyCode == Enum.KeyCode.F8 then
        if AnaPanel then AnaPanel.Visible = not AnaPanel.Visible end
    end
end)

