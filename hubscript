--============================================================
-- GOD
--============================================================

local function GodDurdur()

	if GodBaglantisi then

		GodBaglantisi:Disconnect()

		GodBaglantisi =
			nil

	end

end


local function GodBaslat()

	GodDurdur()


	if not Humanoid then

		return false

	end


	local maksimum =
		Humanoid.MaxHealth


	if maksimum <= 0 then

		maksimum =
			100

	end


	Humanoid.Health =
		maksimum


	GodBaglantisi =
		Humanoid.HealthChanged:Connect(
			function()

				if not Durum.God then

					return
				end


				if not Humanoid
					or
					Humanoid.Health <= 0 then

					return
				end


				if Humanoid.Health <
					Humanoid.MaxHealth then

					Humanoid.Health =
						Humanoid.MaxHealth

				end

			end
		)


	return true
end


--============================================================
-- KARAKTER YÜKLE
--============================================================

local function KarakterYukle(
	yeniKarakter
)

	Karakter =
		yeniKarakter


	Humanoid =
		yeniKarakter:WaitForChild(
			"Humanoid",
			10
		)


	Govde =
		yeniKarakter:WaitForChild(
			"HumanoidRootPart",
			10
		)


	if not Humanoid
		or not Govde then

		return
	end


	OrijinalHiz =
		Humanoid.WalkSpeed


	OrijinalJumpPowerKullan =
		Humanoid.UseJumpPower


	OrijinalJumpPower =
		Humanoid.JumpPower


	OrijinalJumpHeight =
		Humanoid.JumpHeight


	OrijinalAutoRotate =
		Humanoid.AutoRotate


	OrijinalPlatformStand =
		Humanoid.PlatformStand


	-- Hız
	if Durum.Hiz then

		Humanoid.WalkSpeed =
			AYAR.HIZ

	end


	-- Zıplama
	if Durum.Ziplama then

		if Humanoid.UseJumpPower then

			Humanoid.JumpPower =
				AYAR.ZIPLAMA

		else

			Humanoid.JumpHeight =
				AYAR.ZIPLAMA

		end

	end


	-- God
	if Durum.God then

		GodBaslat()

	end


	-- Fly
	if Durum.Fly then

		task.defer(
			function()

				if Durum.Fly
					and Govde
					and Humanoid then

					FlyBaslat()

				end

			end
		)

	end


	-- Noclip
	if Durum.Noclip then

		task.defer(
			function()

				if Durum.Noclip then

					NoclipUygula()

				end

			end
		)

	end


	AimTemizle()


	task.defer(
		function()

			if Durum.ESP then

				ESPYenile()

			end

		end
	)

end


if YerelOyuncu.Character then

	task.spawn(
		function()

			KarakterYukle(
				YerelOyuncu.Character
			)

		end
	)
end


