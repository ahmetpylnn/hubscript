--============================================================
-- PREDICTED POSITION
--============================================================

local function GetPredictedPosition(
	part
)

	if not part then
		return nil
	end

	local position =
		part.Position

	local prediction =
		CONFIG.AIM_PREDICTION

	if prediction <= 0 then
		return position
	end

	return position +
		(
			part.AssemblyLinearVelocity *
			prediction
		)
end

