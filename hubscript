    marker.Anchored = true
    marker.CanCollide = false
    marker.CanTouch = false
    marker.CanQuery = false
    marker.Material = Enum.Material.Neon
    marker.Color = Renk.Kirmizi
    marker.Transparency = 0.15
    marker.Parent = V31Workspace

    table.insert(self.Waypoints, {
        Name = name,
        CFrame = root.CFrame,
        Marker = marker,
    })

    return name
end

function V31:GoToLastWaypoint()
    local root = V31GetLocalRoot()
    local last = self.Waypoints[#self.Waypoints]
    if not root or not last then
        return false
    end

    root.CFrame = last.CFrame
    return true
end

