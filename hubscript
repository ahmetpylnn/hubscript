			top.Position =
				UDim2.fromOffset(
					3,
					3
				)


			top.BackgroundColor3 =
				Renk.Gri

		end


		if cagir ~= false
			and geriCagirma then

			geriCagirma(
				aktif
			)

		end

	end


	ana.Activated:Connect(
		function()

			Guncelle(
				not aktif,
				true
			)

		end
	)


	Guncelle(
		aktif,
		false
	)


	Kontroller[id] = {

		Tur =
			"Toggle",

		Set =
			function(
				deger,
				sessiz
			)

				Guncelle(
					deger,
					not sessiz
				)

			end,

		Get =
			function()

				return aktif

			end,
	}


	return kart
end


