AH3_API.GetWithinRadius = AH3_GetWithinRadius
AH3_API.GetNearestOfKind = AH3_GetNearestOfKind
AH3_API.GetCounts = function()
    local copy = {}
    for key, value in pairs(AH3_Cache.Counts) do
        copy[key] = value
    end
    return copy
end
AH3_API.GetTargetSource = function()
    return AH3_Config.Target.Source
end
AH3_API.SetTargetSource = function(source)
    local valid = {
        Players = true,
        ["Players + NPC"] = true,
        NPC = true,
        Everything = true,
    }
    if not valid[source] then
        return false
    end
    AH3_Config.Target.Source = source
    AimTemizle()
    return true
end

