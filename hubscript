--============================================================
-- V3 CACHE DIRTY QUEUE
--============================================================
local AH3_Dirty = setmetatable({}, { __mode = "k" })
local AH3_DirtyList = {}
local AH3_DirtyCursor = 1

local function AH3_MarkDirty(instance)
    if not instance then
        return
    end
    if AH3_Dirty[instance] then
        return
    end
    AH3_Dirty[instance] = true
    table.insert(AH3_DirtyList, instance)
end

local function AH3_ProcessDirty(limit)
    limit = math.max(1, limit or 120)
    local processed = 0
    while processed < limit and AH3_DirtyCursor <= #AH3_DirtyList do
        local instance = AH3_DirtyList[AH3_DirtyCursor]
        AH3_DirtyCursor += 1
        processed += 1
        AH3_Dirty[instance] = nil
        if instance and instance.Parent then
            local oldMeta = AH3_Cache.Entries[instance]
            if oldMeta then
                AH3_Cache.Entries[instance] = nil
                AH3_Cache.Counts.Total = math.max(0, AH3_Cache.Counts.Total - 1)
            end
            AH3_IndexInstance(instance)
        end
    end
    if AH3_DirtyCursor > 256 and AH3_DirtyCursor > (#AH3_DirtyList / 2) then
        local remaining = {}
        for i = AH3_DirtyCursor, #AH3_DirtyList do
            table.insert(remaining, AH3_DirtyList[i])
        end
        AH3_DirtyList = remaining
        AH3_DirtyCursor = 1
    end
end

local function AH3_GetMeta(instance)
    if not instance then
        return nil
    end
    return AH3_Cache.Entries[instance]
end

local function AH3_RefreshMetadata(instance)
    if not instance or not instance.Parent then
        return nil
    end
    AH3_MarkDirty(instance)
    return AH3_Cache.Entries[instance]
end

