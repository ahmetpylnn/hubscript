local function RemoveESP(player)

	local object =
		ESPObjects[player]

	if not object then
		return
	end

	SafeDestroy(
		object.Highlight
	)

	SafeDestroy(
		object.Billboard
	)

	ESPObjects[player] =
		nil
end

--============================================================
-- ESP ADD
--============================================================

local function AddESP(player)

	if not player
		or player == LocalPlayer then

		return
	end

	if not State.ESP then
		return
	end

	if not IsAlive(player) then
		return
	end

	local character =
		GetCharacter(player)

	if not character then
		return
	end

	local head =
		character:FindFirstChild(
			"Head"
		)

	if not head
		or not head:IsA("BasePart") then

		return
	end

	RemoveESP(player)

	--========================================================
	-- HIGHLIGHT
	--========================================================

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"PlayerControlESP"

	highlight.Adornee =
		character

	highlight.DepthMode =
		CONFIG.ESP_THROUGH_WALLS
		and Enum.HighlightDepthMode.AlwaysOnTop
		or Enum.HighlightDepthMode.Occluded

	highlight.FillColor =
		CONFIG.ESP_COLOR

	highlight.FillTransparency =
		CONFIG.ESP_FILL

	highlight.OutlineColor =
		COLOR.TEXT

	highlight.OutlineTransparency =
		CONFIG.ESP_OUTLINE

	highlight.Parent =
		character

	--========================================================
	-- BILLBOARD
	--========================================================

	local billboard = nil

	if CONFIG.ESP_SHOW_NAMES then

		billboard =
			Instance.new(
				"BillboardGui"
			)

		billboard.Name =
			"PlayerControlESPName"

		billboard.Adornee =
			head

		billboard.Size =
			UDim2.fromOffset(
				220,
				46
			)

		billboard.StudsOffset =
			Vector3.new(
				0,
				3.2,
				0
			)

		billboard.AlwaysOnTop =
			true

		billboard.MaxDistance =
			CONFIG.ESP_DISTANCE

		billboard.Parent =
			PlayerGui

		local label =
			Instance.new(
				"TextLabel"
			)

		label.Size =
			UDim2.fromScale(
				1,
				1
			)

		label.BackgroundTransparency =
			1

		local text =
			player.DisplayName

		if CONFIG.ESP_SHOW_HEALTH then

			local humanoid =
				GetHumanoid(player)

			if humanoid then

				text =
					text ..
					"  |  HP " ..
					math.floor(
						humanoid.Health
					)

			end
		end

		label.Text =
			text

		label.TextColor3 =
			CONFIG.ESP_COLOR

		label.TextStrokeColor3 =
			Color3.fromRGB(
				0,
				0,
				0
			)

		label.TextStrokeTransparency =
			0

		label.Font =
			Enum.Font.GothamBold

		label.TextSize =
			12

		label.Parent =
			billboard
	end

	ESPObjects[player] = {

		Highlight =
			highlight,

		Billboard =
			billboard,

		Character =
			character,
	}
end

--============================================================
-- ESP REFRESH
--============================================================

RefreshESP = function()

	for player in pairs(
		ESPObjects
	) do

		RemoveESP(player)
	end

	if not State.ESP then
		return
	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer then
			AddESP(player)
		end

	end
end

--============================================================
-- ESP UPDATE LOOP
--============================================================

task.spawn(function()

	while true do

		task.wait(0.25)

		if not ScreenGui
			or not ScreenGui.Parent then

			break
		end

		if State.ESP then

			for _, player in ipairs(
				Players:GetPlayers()
			) do

				if player ~= LocalPlayer then

					local character =
						GetCharacter(player)

					local data =
						ESPObjects[player]

					if not character then

						RemoveESP(player)

					elseif not data
						or data.Character
							~= character then

						AddESP(player)

					end
				end
			end
		end
	end
end)

