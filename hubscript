function V31:DestroyWorldVisual(instance)
    local visual = self.WorldVisuals[instance]
    if not visual then
        return
    end

    if visual.Billboard then
        V31Destroy(visual.Billboard)
    end

    if visual.Highlight then
        V31Destroy(visual.Highlight)
    end

    self.WorldVisuals[instance] = nil
    self.State.WorldVisualCount = math.max(0, self.State.WorldVisualCount - 1)
end

function V31:CreateWorldVisual(instance, meta)
    if not instance or not instance.Parent or not meta then
        return
    end

    if meta.Type ~= "Loot"
        and meta.Type ~= "Objective"
        and meta.Type ~= "TargetObject"
        and meta.Type ~= "NamedObject" then
        return
    end

    if self.WorldVisuals[instance] then
        return
    end

    local part = meta.Part or V31GetRoot(instance)
    if not part then
        return
    end

    if self.State.WorldVisualCount >= 100 then
        return
    end

    local color
    local text

    if meta.Type == "Loot" then
        color = Color3.fromRGB(250, 210, 70)
        text = "LOOT  •  " .. meta.Name
    elseif meta.Type == "Objective" then
        color = Color3.fromRGB(80, 180, 255)
        text = "OBJECTIVE  •  " .. meta.Name
    else
        color = Color3.fromRGB(235, 70, 76)
        text = "TARGET  •  " .. meta.Name
    end

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "AHMET_HUB_V31_WORLD"
    billboard.Adornee = part
    billboard.Size = UDim2.fromOffset(170, 30)
    billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    billboard.AlwaysOnTop = true
    billboard.MaxDistance = 0
    billboard.Parent = part

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = text
    label.TextColor3 = color
    label.TextStrokeTransparency = 0.25
    label.Font = Enum.Font.GothamBold
    label.TextSize = 10
    label.TextXAlignment = Enum.TextXAlignment.Center
    label.Parent = billboard

    local highlight = Instance.new("Highlight")
    highlight.Name = "AHMET_HUB_V31_WORLD_HIGHLIGHT"
    highlight.Adornee = instance:IsA("Model") and instance or part
    highlight.FillColor = color
    highlight.FillTransparency = 0.80
    highlight.OutlineColor = color
    highlight.OutlineTransparency = 0.15
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = instance:IsA("Model") and instance or part

    self.WorldVisuals[instance] = {
        Billboard = billboard,
        Highlight = highlight,
        Label = label,
        Type = meta.Type,
    }

    self.State.WorldVisualCount += 1
end

function V31:UpdateWorldESP()
    for instance in pairs(self.WorldVisuals) do
        if not instance or not instance.Parent then
            self:DestroyWorldVisual(instance)
        end
    end

    if not self.Config.ESP.Enabled then
        return
    end

    if self.Config.ESP.Loot
        or self.Config.ESP.Objectives then

        for instance, meta in pairs(self.Cache.Entries) do
            if instance and instance.Parent then
                if meta.Type == "Loot"
                    and self.Config.ESP.Loot then
                    self:CreateWorldVisual(instance, meta)
                elseif meta.Type == "Objective"
                    and self.Config.ESP.Objectives then
                    self:CreateWorldVisual(instance, meta)
                end
            end
        end
    end
end

