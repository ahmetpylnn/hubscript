local function AH3_WorldColor(kind)
    if kind == "LOOT" then return Color3.fromRGB(235, 190, 65) end
    if kind == "OBJECTIVE" then return Color3.fromRGB(90, 170, 255) end
    if kind == "NPC" then return Color3.fromRGB(255, 130, 55) end
