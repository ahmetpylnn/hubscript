local function AH3_CreateWorldVisual(instance, meta)
    if not instance or not instance.Parent or not meta then return nil end
    local old = AH3_WorldVisuals[instance]
    if old and old.Instance == instance then return old end
    local part = meta.Part
    if not part or not part.Parent then return nil end
    local visual = { Instance = instance, Part = part, Kind = meta.Type }
    local color = AH3_WorldColor(meta.Type)
    if AH3_Config.ESP.Highlight and (meta.Type == "NPC" or meta.Type == "TARGET_OBJECT") then
        local highlight = Instance.new("Highlight")
        highlight.Name = "AH3_WorldHighlight"
        highlight.Adornee = meta.Type == "NPC" and instance or (instance:IsA("Model") and instance or part)
        highlight.DepthMode = AH3_Config.ESP.Wall and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
        highlight.FillColor = color
        highlight.FillTransparency = 0.65
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.OutlineTransparency = 0
        highlight.Parent = instance:IsA("Model") and instance or part
        visual.Highlight = highlight
    end
    if meta.Type == "LOOT" or meta.Type == "OBJECTIVE" or meta.Type == "NPC" or meta.Type == "TARGET_OBJECT" or meta.Type == "NAMED_OBJECT" then
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "AH3_WorldInfo"
        billboard.Adornee = part
        billboard.Size = UDim2.fromOffset(160, 34)
        billboard.StudsOffset = Vector3.new(0, 2.4, 0)
        billboard.AlwaysOnTop = true
        billboard.MaxDistance = AYAR.ESP_MESAFE > 0 and AYAR.ESP_MESAFE or 1000000
        billboard.Parent = part
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 = color
        label.TextStrokeTransparency = 0
        label.Font = Enum.Font.GothamBold
        label.TextSize = 10
        label.Text = meta.Type .. ": " .. meta.Name
        label.Parent = billboard
        visual.Billboard = billboard
        visual.Label = label
    end
    AH3_WorldVisuals[instance] = visual
    return visual
end

local function AH3_DestroyWorldVisual(instance)
    local visual = AH3_WorldVisuals[instance]
    if not visual then return end
    if visual.Highlight then visual.Highlight:Destroy() end
    if visual.Billboard then visual.Billboard:Destroy() end
    AH3_WorldVisuals[instance] = nil
end

local function AH3_UpdateWorldESP()
    if not Durum.ESP or not AH3_Config.ESP.Enabled then
        for instance in pairs(AH3_WorldVisuals) do AH3_DestroyWorldVisual(instance) end
        return
    end
    local valid = setmetatable({}, { __mode = "k" })
    for instance, meta in pairs(AH3_Cache.Entries) do
        if instance and instance.Parent then
            local allowed = (meta.Type == "NPC" and AH3_Config.ESP.NPCs)
                or (meta.Type == "LOOT" and AH3_Config.ESP.Loot)
                or (meta.Type == "OBJECTIVE" and AH3_Config.ESP.Objectives)
                or (meta.Type == "TARGET_OBJECT" and AH3_Config.Target.TaggedObjects)
            if allowed then
                valid[instance] = true
                local visual = AH3_CreateWorldVisual(instance, meta)
                if visual and visual.Label and Govde then
                    local distance = AH3_TargetDistance(visual.Part)
                    visual.Label.Text = meta.Type .. ": " .. meta.Name .. "  [" .. tostring(math.floor(distance)) .. "]"
                end
            end
        end
    end
    for instance in pairs(AH3_WorldVisuals) do
        if not valid[instance] then AH3_DestroyWorldVisual(instance) end
    end
end

