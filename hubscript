function AH3_RefreshExplorer(query)
    AH3_CreateExplorer()
    if not AH3_ExplorerList then
        return
    end
    for _, child in ipairs(AH3_ExplorerList:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local results
    if query and query ~= "" then
        results = AH3_SearchWorld(query, 80)
    else
        results = {}
        for instance, meta in pairs(AH3_Cache.Entries) do
            if instance and instance.Parent then
                table.insert(results, {
                    Instance = instance,
                    Meta = meta,
                    Distance = AH3_DistanceToInstance(instance),
                })
            end
        end
        table.sort(results, function(a, b)
            return a.Distance < b.Distance
        end)
        while #results > 80 do
            table.remove(results)
        end
    end

    if AH3_ExplorerStatus then
        AH3_ExplorerStatus.Text = tostring(#results) .. " sonuç  •  cache " .. tostring(AH3_Cache.Counts.Total)
    end

    for _, result in ipairs(results) do
        local meta = result.Meta
        local instance = result.Instance
        local button = Instance.new("TextButton")
        button.Size = UDim2.new(1, 0, 0, 30)
        button.BackgroundColor3 = Renk.Kart
        button.BorderSizePixel = 0
        button.AutoButtonColor = false
        button.Text = meta.Type .. "  •  " .. meta.Name .. "  •  " .. tostring(math.floor(result.Distance))
        button.TextColor3 = Renk.Beyaz2
        button.Font = Enum.Font.GothamMedium
        button.TextSize = 8
        button.TextXAlignment = Enum.TextXAlignment.Left
        button.Parent = AH3_ExplorerList
        KoseEkle(button, 6)

        button.Activated:Connect(function()
            local part = meta.Part or AH3_GetBestPartFromModel(instance)
            if part and Govde then
                Karakter:PivotTo(CFrame.new(part.Position + Vector3.new(0, 4, 0)))
                BildirimGoster("World Cache", meta.Name .. " konumuna gidildi.")
            end
        end)
    end
end

local function AH3_ToggleExplorer()
    AH3_CreateExplorer()
    AH3_Explorer.Visible = not AH3_Explorer.Visible
    if AH3_Explorer.Visible then
        AH3_RefreshExplorer("")
    end
end

