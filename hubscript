    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"},
}

local function AH3_UpdateSkeleton(visual, character, color)
    if not visual then return end
    if not AH3_Config.ESP.Skeleton then
        AH3_HideFrames(visual.Skeleton)
        return
    end
    local index = 1
    local camera = Dunya.CurrentCamera
    if not camera then return end
    for _, pair in ipairs(AH3_SkeletonPairs) do
        local a = character:FindFirstChild(pair[1])
        local b = character:FindFirstChild(pair[2])
        if a and b and a:IsA("BasePart") and b:IsA("BasePart") then
            local pa, va = AH3_ProjectPart(camera, a)
            local pb, vb = AH3_ProjectPart(camera, b)
            if pa and pb and va and vb and visual.Skeleton[index] then
                AH3_SetLine(visual.Skeleton[index], pa, pb, 1, color)
            elseif visual.Skeleton[index] then
                visual.Skeleton[index].Visible = false
            end
            index += 1
        end
    end
    for i = index, #visual.Skeleton do visual.Skeleton[i].Visible = false end
end

local function AH3_UpdateTracer(visual, root, color)
    if not visual or not visual.Tracer then return end
    if not AH3_Config.ESP.Tracer then visual.Tracer.Visible = false return end
    local camera = Dunya.CurrentCamera
    if not camera then visual.Tracer.Visible = false return end
    local point, visible = AH3_ProjectPart(camera, root)
    if not point or not visible then visual.Tracer.Visible = false return end
    local viewport = camera.ViewportSize
    local start = Vector2.new(viewport.X / 2, viewport.Y)
    AH3_SetLine(visual.Tracer, start, point, 1, color)
end

local function AH3_PlayerColor(player)
    if AH3_Config.ESP.Team and player.Team then
        return player.Team.TeamColor.Color
    end
    return AYAR.ESP_RENK
end

local function AH3_UpdateOnePlayerESP(player)
    if player == YerelOyuncu then return end
    if not AH3_Config.ESP.Players then
        AH3_DestroyVisual(player)
        return
    end
    local character = player.Character
    if not character then
        AH3_DestroyVisual(player)
        return
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root or humanoid.Health <= 0 then
        AH3_DestroyVisual(player)
        return
    end
    local visual = AH3_PlayerVisuals[player] or AH3_NewVisual(player)
    if not visual then return end
    local distance = AH3_TargetDistance(root)
    if AH3_Config.ESP.MaxDistance > 0 and distance > AH3_Config.ESP.MaxDistance then
        AH3_HideFrames(visual.Box)
        visual.Tracer.Visible = false
        AH3_HideFrames(visual.Skeleton)
        return
    end
    local color = AH3_PlayerColor(player)
    if AH3_Config.ESP.Box then
        local camera = Dunya.CurrentCamera
        local box = camera and AH3_GetBox2D(camera, character)
        if box then AH3_UpdateBox(visual, box, color) else AH3_HideFrames(visual.Box) end
    else
        AH3_HideFrames(visual.Box)
    end
    AH3_UpdateTracer(visual, root, color)
    AH3_UpdateSkeleton(visual, character, color)
end

local function AH3_UpdatePlayerESP()
    if not Durum.ESP or not AH3_Config.ESP.Enabled then
        for player in pairs(AH3_PlayerVisuals) do AH3_DestroyVisual(player) end
        return
    end
    for _, player in ipairs(Oyuncular:GetPlayers()) do
        if player ~= YerelOyuncu then AH3_UpdateOnePlayerESP(player) end
    end
end

