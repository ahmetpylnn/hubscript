--============================================================
-- AIM GEÇERLİLİK
--============================================================

local function AimHedefGecerli(
	oyuncu,
	parca
)

	if not oyuncu
		or not parca then

		return false
	end


	if not YasiyorMu(
		oyuncu
	) then

		return false
	end


	if AyniTakimMi(
		oyuncu
	) then

		return false
	end


	if not parca.Parent
		or not Govde then

		return false
	end


	local mesafe =
		OyuncuMesafesiAl(
			oyuncu
		)


	if mesafe >
		AYAR.AIM_MESAFE then

		return false
	end


	-- FOV KISITLAMASI YALNIZCA AÇIKSA UYGULANIR
	if AYAR.AIM_FOV_KISITLI
		and AYAR.AIM_FOV > 0 then


		local ekranMesafesi,
			ekranda =
			EkranMesafesiAl(
				parca
			)


		if not ekranda then

			return false
		end


		if ekranMesafesi >
			AYAR.AIM_FOV then

			return false
		end
	end


	if not GorunurMu(
		oyuncu,
		parca
	) then

		return false
	end


	return true
end


--============================================================
-- EN UYGUN HEDEF
--============================================================

local function EnIyiHedefiBul()

	if not Govde then

		return nil,
			nil

	end


	local enOyuncu =
		nil

	local enParca =
		nil


	local enMesafe =
		math.huge

	local enEkran =
		math.huge


	local kamera =
		Dunya.CurrentCamera


	for _, oyuncu in ipairs(
		Oyuncular:GetPlayers()
	) do


		if oyuncu ~=
			YerelOyuncu then


			local parca =
				AimParcasiBul(
					oyuncu
				)


			if parca
				and AimHedefGecerli(
					oyuncu,
					parca
				) then


				local mesafe =
					OyuncuMesafesiAl(
						oyuncu
					)


				local ekran =
					math.huge


				if kamera then

					ekran =
						EkranMesafesiAl(
							parca
						)

				end


				if AYAR.AIM_MODU ==
					"Ekran Merkezi" then


					if ekran <
						enEkran then


						enEkran =
							ekran

						enMesafe =
							mesafe

						enOyuncu =
							oyuncu

						enParca =
							parca

					end


				else


					if mesafe <
						enMesafe then


						enMesafe =
							mesafe

						enEkran =
							ekran

						enOyuncu =
							oyuncu

						enParca =
							parca

					end

				end

			end

		end

	end


	return enOyuncu,
		enParca
end


