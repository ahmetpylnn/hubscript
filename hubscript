--============================================================
-- ESP BİLGİLERİ
--============================================================

local function ESPBilgileriniGuncelle()

	if not Durum.ESP then

		return
	end


	for oyuncu,
		veri in pairs(
			ESPNesneleri
		) do


		if not oyuncu.Parent
			or not veri.Karakter
			or not veri.Karakter.Parent then

			ESPSil(
				oyuncu
			)

			continue
		end


		local humanoid =
			HumanoidAl(
				oyuncu
			)


		local parca =
			AimParcasiBul(
				oyuncu
			)


		if not humanoid
			or not parca then

			continue
		end


		if veri.Isim then

			veri.Isim.Visible =
				AYAR.ESP_ISIM

		end


		if veri.Bilgi then

			local metin =
				""


			if AYAR.ESP_CAN then

				metin =
					"CAN: "
					..
					tostring(
						math.floor(
							humanoid.Health
						)
					)

			end


			if AYAR.ESP_MESAFE_YAZ then

				local mesafe =
					math.floor(
						MesafeAl(
							parca.Position
						)
					)


				if #metin > 0 then

					metin =
						metin
						..
						"  •  "
						..
						tostring(
							mesafe
						)
						..
						" studs"

				else

					metin =
						tostring(
							mesafe
						)
						..
						" studs"

				end

			end


			veri.Bilgi.Text =
				metin

		end


		if veri.CanDolgu then

			local oran =
				0


			if humanoid.MaxHealth > 0 then

				oran =
					math.clamp(
						humanoid.Health /
							humanoid.MaxHealth,
						0,
						1
					)

			end


			veri.CanDolgu.Size =
				UDim2.new(
					oran,
					0,
					1,
					0
				)


			veri.CanDolgu.BackgroundColor3 =
				AYAR.ESP_RENK

		end


		if veri.Vurgula then

			veri.Vurgula.FillColor =
				AYAR.ESP_RENK

			veri.Vurgula.FillTransparency =
				AYAR.ESP_DOLGU

			veri.Vurgula.DepthMode =
				AYAR.ESP_DUVAR_ARKASI
				and
				Enum.HighlightDepthMode.AlwaysOnTop
				or
				Enum.HighlightDepthMode.Occluded

		end


		if veri.Etiket then

			veri.Etiket.MaxDistance =
				AYAR.ESP_MESAFE > 0
				and
				AYAR.ESP_MESAFE
				or
				1000000

		end

	end
end


--============================================================
-- NOCLIP
--============================================================

local function NoclipKapat()

	for parca,
		eskiDeger in pairs(
			Carpismalar
		) do


		if parca
			and parca.Parent then

			parca.CanCollide =
				eskiDeger

		end
	end


	table.clear(
		Carpismalar
	)

end


local function NoclipUygula()

	if not Karakter then

		return
	end


	for _, parca in ipairs(
		Karakter:GetDescendants()
	) do


		if parca:IsA(
			"BasePart"
		) then


			if Carpismalar[
				parca
			] == nil then

				Carpismalar[
					parca
				] =
					parca.CanCollide

			end


			parca.CanCollide =
				false

		end

	end

end


