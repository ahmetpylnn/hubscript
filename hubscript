--============================================================
-- AIM TAHMİNİ
--============================================================

local function TahminliPozisyon(
	parca
)

	if not parca then

		return nil
	end


	local pozisyon =
		parca.Position


	if AYAR.AIM_TAHMIN <= 0 then

		return pozisyon
	end


	return pozisyon +
		(
			parca.AssemblyLinearVelocity
			*
			AYAR.AIM_TAHMIN
		)

end


