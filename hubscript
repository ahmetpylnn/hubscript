function V31:MakeToggle(parent, text, getter, setter)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -2, 0, 34)
    button.BackgroundColor3 = Renk.Kart
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Font = Enum.Font.GothamBold
    button.TextSize = 9
    button.TextColor3 = Renk.Beyaz2
    button.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    local function update()
        local active = getter()
        button.BackgroundColor3 = active
            and Renk.YesilKoyu
            or Renk.Kart
        button.Text = text .. "    " .. (active and "ON" or "OFF")
    end

    button.Activated:Connect(function()
        setter(not getter())
        update()
    end)

    update()
    return button
end

function V31:MakeCycle(parent, text, values, getter, setter)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -2, 0, 34)
    button.BackgroundColor3 = Renk.Kart
    button.BorderSizePixel = 0
    button.AutoButtonColor = false
    button.Font = Enum.Font.GothamBold
    button.TextSize = 9
    button.TextColor3 = Renk.Beyaz2
    button.Parent = parent

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = button

    local function update()
        button.Text = text .. "    " .. tostring(getter())
    end

    button.Activated:Connect(function()
        local current = getter()
        local index = table.find(values, current) or 1
        index += 1
        if index > #values then
            index = 1
        end
        setter(values[index])
        update()
    end)

    update()
    return button
end

