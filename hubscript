local function AH3_SafeCall(fn, fallback)
    local ok, result = pcall(fn)
    if ok then
        return result
    end
    return fallback
end

local function AH3_IsPlayerCharacter(instance)
    if not instance then
        return false
    end
    for _, player in ipairs(Oyuncular:GetPlayers()) do
        if player.Character == instance then
            return true
        end
    end
    return false
end

local function AH3_GetPivotPosition(instance)
    if not instance then
        return nil
    end
    if instance:IsA("BasePart") then
        return instance.Position
    end
    if instance:IsA("Model") then
        local ok, pivot = pcall(function()
            return instance:GetPivot()
        end)
        if ok and pivot then
            return pivot.Position
        end
    end
    return nil
end

local function AH3_NameLooksRelevant(name)
    if type(name) ~= "string" then
        return false
    end
    local lower = string.lower(name)
    for _, keyword in ipairs(AH3_NameKeywords) do
        if string.find(lower, keyword, 1, true) then
            return true
        end
    end
    return false
end

local function AH3_HasTag(instance, tag)
    if not instance then
        return false
    end
    return AH3_SafeCall(function()
        return CollectionService:HasTag(instance, tag)
    end, false)
end

local function AH3_HasBoolAttribute(instance, names)
    if not instance then
        return false
    end
    for _, name in ipairs(names) do
        local value = AH3_SafeCall(function()
            return instance:GetAttribute(name)
        end, nil)
        if value == true then
            return true
        end
    end
    return false
end

local function AH3_GetHumanoid(instance)
    if not instance then
        return nil
    end
    if instance:IsA("Humanoid") then
        return instance
    end
    if instance:IsA("Model") then
        return instance:FindFirstChildOfClass("Humanoid")
    end
    return nil
end

local function AH3_GetBestPartFromModel(model)
    if not model then
        return nil
    end
    local desired = {
        AH3_Config.Target.Part == "Head" and "Head" or nil,
        AH3_Config.Target.Part == "Torso" and "UpperTorso" or nil,
        AH3_Config.Target.Part == "Root" and "HumanoidRootPart" or nil,
        "Head",
        "UpperTorso",
        "HumanoidRootPart",
        "Torso",
        "LowerTorso",
        "PrimaryPart",
        "Target",
        "Hitbox",
        "Center",
        "Core",
    }
    for _, name in ipairs(desired) do
        if name then
            local part = model:FindFirstChild(name, true)
            if part and part:IsA("BasePart") then
                return part
            end
        end
    end
    if model:IsA("Model") and model.PrimaryPart then
        return model.PrimaryPart
    end
    return model:FindFirstChildWhichIsA("BasePart", true)
end

local function AH3_Classify(instance)
    local meta = {
        Instance = instance,
        ClassName = instance.ClassName,
        Name = instance.Name,
        Type = "Other",
        Position = AH3_GetPivotPosition(instance),
        Humanoid = nil,
        Part = nil,
        Player = nil,
        Alive = true,
        Team = nil,
    }

    if instance:IsA("BasePart") then
        meta.Type = "Part"
        meta.Part = instance
    end

    if instance:IsA("Model") then
        meta.Type = "Model"
        meta.Part = AH3_GetBestPartFromModel(instance)
        meta.Humanoid = instance:FindFirstChildOfClass("Humanoid")
        if meta.Humanoid then
            meta.Type = "NPC"
            meta.Alive = meta.Humanoid.Health > 0
        end
    end

    local playerCharacter = AH3_IsPlayerCharacter(instance)
    if playerCharacter then
        meta.Type = "PLAYER_CHARACTER"
        for _, player in ipairs(Oyuncular:GetPlayers()) do
            if player.Character == instance then
                meta.Player = player
                meta.Team = player.Team
                break
            end
        end
    end

    if instance:IsA("Tool") then
        meta.Type = "TOOL"
    end

    local isLoot = AH3_HasTag(instance, "Loot")
        or AH3_HasBoolAttribute(instance, {"Loot", "IsLoot", "Collectible"})
    local isObjective = AH3_HasTag(instance, "Objective")
        or AH3_HasBoolAttribute(instance, {"Objective", "IsObjective", "Goal"})
    local isTarget = AH3_HasTag(instance, "AimTarget")
        or AH3_HasBoolAttribute(instance, {"AimTarget", "Targetable", "Target"})

    if isLoot then
        meta.Type = "LOOT"
    elseif isObjective then
        meta.Type = "OBJECTIVE"
    elseif isTarget then
        meta.Type = "TARGET_OBJECT"
    elseif meta.Type == "Other" or meta.Type == "Part" or meta.Type == "Model" then
        if AH3_NameLooksRelevant(instance.Name) and not playerCharacter then
            meta.Type = "NAMED_OBJECT"
        end
    end

    return meta
end

local function AH3_IndexInstance(instance)
    if not instance then
        return nil
    end
    if AH3_Cache.Entries[instance] then
        return AH3_Cache.Entries[instance]
    end
    local meta = AH3_Classify(instance)
    AH3_Cache.Entries[instance] = meta
    AH3_Cache.Counts.Total += 1
    if meta.ClassName == "Part" or instance:IsA("BasePart") then
        AH3_Cache.Counts.BasePart += 1
    end
    if instance:IsA("Model") then
        AH3_Cache.Counts.Model += 1
    end
    if meta.Humanoid then
        AH3_Cache.Counts.HumanoidModel += 1
        if meta.Type == "NPC" then
            AH3_Cache.Counts.NPC += 1
        end
    end
    if meta.Type == "PLAYER_CHARACTER" then
        AH3_Cache.Counts.PlayerCharacter += 1
    elseif meta.Type == "LOOT" then
        AH3_Cache.Counts.Loot += 1
    elseif meta.Type == "OBJECTIVE" then
        AH3_Cache.Counts.Objective += 1
    elseif meta.Type == "TARGET_OBJECT" or meta.Type == "NAMED_OBJECT" then
        AH3_Cache.Counts.Target += 1
    elseif meta.Type == "TOOL" then
        AH3_Cache.Counts.Tool += 1
    end
    if instance:IsA("Folder") then
        AH3_Cache.Counts.Folder += 1
    end
    return meta
end

local function AH3_UnindexInstance(instance)
    if not instance then
        return
    end
    local meta = AH3_Cache.Entries[instance]
    if not meta then
        return
    end
    if not AH3_Config.WorldScan.KeepRemovedEntries then
        AH3_Cache.Entries[instance] = nil
        AH3_Cache.Counts.Total = math.max(0, AH3_Cache.Counts.Total - 1)
    end
end

local function AH3_QueueRoot(root)
    if not root then
        return
    end
    if AH3_Cache.Queued[root] then
        return
    end
    AH3_Cache.Queued[root] = true
    table.insert(AH3_Cache.Queue, root)
end

local function AH3_QueueChildren(instance)
    local children = AH3_SafeCall(function()
        return instance:GetChildren()
    end, nil)
    if not children then
        return
    end
    for _, child in ipairs(children) do
        AH3_QueueRoot(child)
    end
end

local function AH3_StartWorldScan()
    AH3_Cache.Queue = {}
    AH3_Cache.QueueIndex = 1
    AH3_Cache.Queued = setmetatable({}, { __mode = "k" })
    AH3_State.Scanning = true
    AH3_State.ScanComplete = false
    AH3_State.ScanStartedAt = os.clock()
    AH3_State.ScanProcessed = 0
    AH3_State.ScanQueued = 0
    AH3_State.ScanBudget = AH3_Config.WorldScan.InitialBudget
    AH3_QueueRoot(Dunya)
    if AH3_Config.WorldScan.ScanReplicatedStorage then
        local rs = AH3_SafeCall(function() return game:GetService("ReplicatedStorage") end, nil)
        AH3_QueueRoot(rs)
    end
    if AH3_Config.WorldScan.ScanLighting then
        AH3_QueueRoot(game:GetService("Lighting"))
    end
    AH3_QueueRoot(AH3_SafeCall(function() return game:GetService("ReplicatedFirst") end, nil))
    AH3_QueueRoot(AH3_SafeCall(function() return game:GetService("SoundService") end, nil))
    AH3_State.ScanQueued = #AH3_Cache.Queue
end

local function AH3_AdaptiveBudget()
    local fps = AH3_State.RenderFPS
    local current = AH3_State.ScanBudget
    if fps < 35 then
        current = math.max(AH3_Config.WorldScan.MinBudget, math.floor(current * 0.60))
    elseif fps < 50 then
        current = math.max(AH3_Config.WorldScan.MinBudget, math.floor(current * 0.80))
    elseif fps > 110 then
        current = math.min(AH3_Config.WorldScan.MaxBudget, math.floor(current * 1.20))
    elseif fps > 80 then
        current = math.min(AH3_Config.WorldScan.MaxBudget, math.floor(current * 1.08))
    end
    return math.clamp(current, AH3_Config.WorldScan.MinBudget, AH3_Config.WorldScan.MaxBudget)
end

local function AH3_ScanStep()
    if not AH3_State.Scanning then
        return
    end
    local budget = AH3_AdaptiveBudget()
    AH3_State.ScanBudget = budget
    local processed = 0
    local started = os.clock()
    while processed < budget and AH3_Cache.QueueIndex <= #AH3_Cache.Queue do
        local instance = AH3_Cache.Queue[AH3_Cache.QueueIndex]
        AH3_Cache.QueueIndex += 1
        processed += 1
        if instance and instance.Parent then
            AH3_IndexInstance(instance)
            AH3_QueueChildren(instance)
        end
    end
    AH3_State.ScanProcessed += processed
    AH3_State.ScanQueued = #AH3_Cache.Queue
    AH3_State.ScanFrameTime = os.clock() - started
    AH3_State.LastScanAt = os.clock()
    if AH3_Cache.QueueIndex > #AH3_Cache.Queue then
        AH3_State.Scanning = false
        AH3_State.ScanComplete = true
        AH3_State.ScanFinishedAt = os.clock()
    end
end

local function AH3_GetCacheProgress()
    local total = #AH3_Cache.Queue
    local done = math.min(AH3_Cache.QueueIndex - 1, total)
    if total <= 0 then
        return 1
    end
    return math.clamp(done / total, 0, 1)
end

local function AH3_InstallCacheSignals()
    for _, connection in ipairs(AH3_Cache.Connections) do
        pcall(function() connection:Disconnect() end)
    end
    table.clear(AH3_Cache.Connections)
    if AH3_Config.WorldScan.ScanWorkspace then
        table.insert(AH3_Cache.Connections, Dunya.DescendantAdded:Connect(function(instance)
            AH3_IndexInstance(instance)
            AH3_State.CacheCount = AH3_Cache.Counts.Total
        end))
        table.insert(AH3_Cache.Connections, Dunya.DescendantRemoving:Connect(function(instance)
            AH3_UnindexInstance(instance)
            AH3_State.CacheCount = AH3_Cache.Counts.Total
        end))
    end
end

