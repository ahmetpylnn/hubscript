function V31:InstallPlayerSignals()
    table.insert(self.Connections, V31Players.PlayerAdded:Connect(function(player)
        self.State.PlayerCount = #V31Players:GetPlayers()

        player.CharacterAdded:Connect(function(character)
            task.defer(function()
                self:Index(character)
                if self.Config.ESP.Enabled then
                    self:CreatePlayerESP(player)
                end
            end)
        end)
    end))

    table.insert(self.Connections, V31Players.PlayerRemoving:Connect(function(player)
        self:DestroyPlayerESP(player)
        self.State.PlayerCount = math.max(0, #V31Players:GetPlayers() - 1)
        if self.State.CurrentTarget == player then
            self:ClearTarget()
        end
    end))

    for _, player in ipairs(V31Players:GetPlayers()) do
        if player ~= YerelOyuncu then
            player.CharacterAdded:Connect(function(character)
                task.defer(function()
                    self:Index(character)
                    if self.Config.ESP.Enabled then
                        self:CreatePlayerESP(player)
                    end
                end)
            end)
        end
    end
end

--============================================================
-- ORIGINAL CHARACTER HOOK
--============================================================

function V31:InstallCharacterHook()
    table.insert(self.Connections, YerelOyuncu.CharacterAdded:Connect(function()
        task.wait(0.15)
        self:ClearTarget()
        self:StopFreecam()
        self.State.CurrentTarget = nil
        self.State.Starting = false
        if self.Config.WorldScan.Enabled then
            self:StartScan()
        end
        if self.Config.ESP.Enabled then
            self:RefreshESP()
        end
    end))
end

--============================================================
-- CAMERA FOV / RENDER
--============================================================

function V31:ApplyCameraFOV()
    local camera = V31Workspace.CurrentCamera
    if camera and not self.State.Freecam then
        camera.FieldOfView = self.Config.Camera.FOV
    end
end

--============================================================
-- STATUS
--============================================================

function V31:UpdateStatus()
    local label = self.UI.StatusLabel
    if not label then
        return
    end

    local targetName = "Yok"
    if self.State.CurrentTarget then
        targetName = self.State.CurrentTarget.Name
    end

    local targetType = self.State.CurrentTargetKind or "-"
    local cacheStatus = self.State.Scanning
        and (math.floor(self.State.ScanProgress * 100) .. "%")
        or (self.State.ScanComplete and "Hazır" or "Bekliyor")

    label.Text = string.format(
        "FPS: %.0f\nCACHE: %d  •  TARAMA: %s  •  BÜTÇE: %d\nHEDEF: %s  •  TİP: %s\nESP: %d  •  WAYPOINT: %d",
        self.State.RenderFPS,
        self.State.CacheCount,
        cacheStatus,
        self.State.ScanBudget,
        targetName,
        targetType,
        self.State.ESPVisualCount,
        #self.Waypoints
    )
end

--============================================================
-- STARTUP ANIMATION
--============================================================

function V31:Startup()
    self.State.Starting = true

    if not self.Config.UI.StartupAnimation then
        self.State.Starting = false
        self.State.StartupFinished = true
        if AnaPanel then
            AnaPanel.Visible = true
        end
        if self.UI.Splash then
            V31Destroy(self.UI.Splash)
        end
        return
    end

    local splash = self.UI.Splash
    local bar = self.UI.SplashBar
    local scanText = self.UI.SplashText

    if not splash or not bar or not scanText then
        self.State.Starting = false
        self.State.StartupFinished = true
        if AnaPanel then
            AnaPanel.Visible = true
        end
        return
    end

    local started = os.clock()

    while self.Config.WorldScan.Enabled
        and (self.State.Scanning or self.State.ScanProgress < 1) do

        local progress = self.State.ScanProgress
        bar.Size = UDim2.new(progress, 0, 1, 0)
        scanText.Text = string.format(
            "Dünya indexleniyor  •  %d%%  •  %d nesne",
            math.floor(progress * 100),
            self.State.CacheCount
        )

        if self.State.ScanComplete then
            break
        end

        if os.clock() - started > 12 then
            break
        end

        task.wait(0.03)
    end

    bar.Size = UDim2.new(1, 0, 1, 0)
    scanText.Text = string.format(
        "Hazır  •  %d nesne indexlendi",
        self.State.CacheCount
    )

    task.wait(0.18)

    if AnaPanel then
        local finalPosition = AnaPanel.Position
        AnaPanel.Position = finalPosition + UDim2.fromOffset(0, 16)
        AnaPanel.Visible = true
        AnaPanel.BackgroundTransparency = 1

        V31Tween:Create(
            AnaPanel,
            TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                Position = finalPosition,
                BackgroundTransparency = 0,
            }
        ):Play()
    end

    V31Tween:Create(
        splash,
        TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {
            BackgroundTransparency = 1,
            Position = splash.Position - UDim2.fromOffset(0, 12),
        }
    ):Play()

    task.wait(0.28)
    V31Destroy(splash)

    self.State.Starting = false
    self.State.StartupFinished = true
    self.State.Initialized = true

    BildirimGoster(
        "AHMET HUB V3.1",
        "Sistem hazır. Cache + Aim + ESP motoru aktif."
    )
end

--============================================================
-- HOTKEYS
--============================================================

function V31:InstallHotkeys()
    table.insert(self.Connections, V31Input.InputBegan:Connect(function(input, processed)
        if processed then
            return
        end

        if input.KeyCode == Enum.KeyCode.F2 then
            if self.UI.Tracker then
                self:RefreshTracker()
                self.UI.Tracker.Visible = not self.UI.Tracker.Visible
            end
        elseif input.KeyCode == Enum.KeyCode.F3 then
            self.Config.Aim.Enabled = not self.Config.Aim.Enabled
            if not self.Config.Aim.Enabled then
                self:ClearTarget()
            end
            BildirimGoster("Aim", self.Config.Aim.Enabled and "AÇIK" or "KAPALI")
        elseif input.KeyCode == Enum.KeyCode.F4 then
            self.Config.ESP.Enabled = not self.Config.ESP.Enabled
            if self.Config.ESP.Enabled then
                self:RefreshESP()
                self:UpdateWorldESP()
            else
                for player in pairs(self.ESP) do
                    self:DestroyPlayerESP(player)
                end
                for instance in pairs(self.WorldVisuals) do
                    self:DestroyWorldVisual(instance)
                end
            end
        elseif input.KeyCode == Enum.KeyCode.F5 then
            local modes = { "Nearest", "Screen", "Low Health", "Smart" }
            local index = table.find(modes, self.Config.Aim.Priority) or 1
            index += 1
            if index > #modes then index = 1 end
            self.Config.Aim.Priority = modes[index]
            self:ClearTarget()
            BildirimGoster("Priority", self.Config.Aim.Priority)
        elseif input.KeyCode == Enum.KeyCode.F6 then
            local parts = { "Head", "Torso", "Root" }
            local index = table.find(parts, self.Config.Aim.Part) or 1
            index += 1
            if index > #parts then index = 1 end
            self.Config.Aim.Part = parts[index]
            self:ClearTarget()
            BildirimGoster("Target Part", self.Config.Aim.Part)
        elseif input.KeyCode == Enum.KeyCode.F7 then
            self:StartScan()
            BildirimGoster("Cache", "Yeniden tarama başladı.")
        elseif input.KeyCode == Enum.KeyCode.F8 then
            if AnaPanel then
                AnaPanel.Visible = not AnaPanel.Visible
            end
        elseif input.KeyCode == Enum.KeyCode.F9 then
            if self.State.Freecam then
                self:StopFreecam()
            else
                self:StartFreecam()
            end
        end
    end))
end

--============================================================
-- RENDER / HEARTBEAT
--============================================================

function V31:InstallRuntime()
    self._fpsTimer = 0
    self._fpsFrames = 0
    self._espTimer = 0
    self._dirtyTimer = 0

    table.insert(self.Connections, V31Run.RenderStepped:Connect(function(dt)
        self._fpsTimer += dt
        self._fpsFrames += 1

        if self._fpsTimer >= 0.5 then
            self.State.RenderFPS = self._fpsFrames / self._fpsTimer
            self._fpsTimer = 0
            self._fpsFrames = 0
        end

        self:AimStep(dt)
        self:UpdateFovRing()
        self:UpdateFreecam(dt)

        if not self.State.Freecam then
            self:ApplyCameraFOV()
        end

        self._espTimer += dt
        local espInterval = 1 / math.max(1, self.Config.ESP.UpdateRate)
        if self._espTimer >= espInterval then
            self._espTimer = 0
            self:UpdateESP()
            self:UpdateWorldESP()
        end
    end))

    table.insert(self.Connections, V31Run.Heartbeat:Connect(function()
        if self.Config.WorldScan.Enabled then
            self:ScanStep()
        end

        self._dirtyTimer += 1
        if self._dirtyTimer >= 2 then
            self._dirtyTimer = 0
            self:ProcessDirty(80)
        end

        self.State.PlayerCount = math.max(0, #V31Players:GetPlayers() - 1)
        self:UpdateStatus()
    end))
end

--============================================================
-- PUBLIC API
--============================================================

function V31:GetCacheCount()
    return self.Cache.Counts.Total
end

function V31:GetCacheProgress()
    return self.State.ScanProgress
end

function V31:GetByType(kind)
    local result = {}
    for instance, meta in pairs(self.Cache.Entries) do
        if instance and instance.Parent and meta.Type == kind then
            table.insert(result, meta)
        end
    end
    return result
end

function V31:GetByTag(tag)
    local result = {}
    for instance in pairs(self.Cache.Entries) do
        if instance and instance.Parent and V31HasTag(instance, tag) then
            table.insert(result, instance)
        end
    end
    return result
end

function V31:Find(query, limit)
    local result = {}
    if type(query) ~= "string" or query == "" then
        return result
    end

    local lower = string.lower(query)
    limit = limit or 100

    for instance, meta in pairs(self.Cache.Entries) do
        if instance
            and instance.Parent
            and string.find(string.lower(meta.Name), lower, 1, true) then

            table.insert(result, meta)

            if #result >= limit then
                break
            end
        end
    end

    return result
end

function V31:GetNearestByType(kind)
    local best = nil
    local bestDistance = math.huge

    for instance, meta in pairs(self.Cache.Entries) do
        if instance and instance.Parent and meta.Type == kind then
            local part = meta.Part or V31GetRoot(instance)
            if part then
                local distance = V31DistanceTo(part.Position)
                if distance < bestDistance then
                    bestDistance = distance
                    best = instance
                end
            end
        end
    end

    return best, bestDistance
end

function V31:GetStats()
    return {
        Version = self.Version,
        Cache = self.Cache.Counts.Total,
        Players = self.State.PlayerCount,
        NPCs = self.Cache.Counts.NPCs,
        Loot = self.Cache.Counts.Loot,
        Objectives = self.Cache.Counts.Objectives,
        FPS = self.State.RenderFPS,
        ScanProgress = self.State.ScanProgress,
        ScanBudget = self.State.ScanBudget,
        Target = self.State.CurrentTarget,
        TargetKind = self.State.CurrentTargetKind,
        TargetDistance = self.State.CurrentTargetDistance,
        TargetSwitches = self.State.TargetSwitches,
    }
end

--============================================================
-- BOOT
--============================================================

function V31:Boot()
    -- V2.1 içindeki eski kamera aim renderını devre dışı bırakıyoruz;
    -- aksi halde iki farklı render step aynı karede kamerayı değiştirebilir.
    pcall(function()
        V31Run:UnbindFromRenderStep("AHMET_HUB_AIM")
    end)

    -- Başlangıçta V2.1 ile çakışmaması için eski paneli bozmaz,
    -- sadece kompakt ölçek ve ek motorları kurar.
    self:BuildUI()
    self:InstallCacheSignals()
    self:InstallPlayerSignals()
    self:InstallCharacterHook()
    self:InstallHotkeys()
    self:InstallRuntime()
    self:ApplyPerformancePreset(self.Config.Performance.Mode)
    self:StartScan()

    task.spawn(function()
        self:Startup()
    end)
end

--============================================================
-- SINGLETON CLEANUP
--============================================================

pcall(function()
    local previous = _G.AHMET_HUB_V31
    if previous and previous.Destroy then
        previous:Destroy()
    end
end)

function V31:Destroy()
    for _, connection in ipairs(self.Connections) do
        V31Safe(function()
            connection:Disconnect()
        end)
    end
    table.clear(self.Connections)

    for _, connection in ipairs(self.Cache.Connections) do
        V31Safe(function()
            connection:Disconnect()
        end)
    end
    table.clear(self.Cache.Connections)

    for player in pairs(self.ESP) do
        self:DestroyPlayerESP(player)
    end

    for instance in pairs(self.WorldVisuals) do
        self:DestroyWorldVisual(instance)
    end

    self:ClearWaypoints()
    self:StopFreecam()
    self:DisableFullbright()

    if self.UI.Overlay then
        V31Destroy(self.UI.Overlay)
    end

    if self.UI.ESPOverlay then
        V31Destroy(self.UI.ESPOverlay)
    end

    self.State.Initialized = false
end

_G.AHMET_HUB_V31 = V31

