--============================================================
-- MOUSE TELEPORT
--============================================================

local function MouseTeleport(
	konum
)

	if not Durum.Teleport then

		return
	end


	if not Karakter
		or not Karakter.Parent then

		return
	end


	if not Govde
		or not Govde.Parent then

		return
	end


	if PanelUzerindeMi(
		konum.X,
		konum.Y
	) then

		return
	end


	local kamera =
		Dunya.CurrentCamera


	if not kamera then

		return
	end


	-- ScreenPointToRay doğrudan ekran
	-- koordinatlarını kullanır ve GUI inset'i
	-- hesaba katar.
	local isin =
		kamera:ScreenPointToRay(
			konum.X,
			konum.Y,
			0
		)


	local parametre =
		RaycastParams.new()


	parametre.FilterType =
		Enum.RaycastFilterType.Exclude


	parametre.FilterDescendantsInstances = {

		Karakter,
	}


	parametre.IgnoreWater =
		true


	local sonuc =
		Dunya:Raycast(
			isin.Origin,
			isin.Direction
			*
			AYAR.TELEPORT_MESAFE,
			parametre
		)


	if not sonuc then

		BildirimGoster(
			"Teleport",
			"Yüzey bulunamadı."
		)

		return
	end


	local hedef =
		sonuc.Position


	if sonuc.Normal.Y >=
		0.6 then


		hedef +=
			Vector3.new(
				0,
				AYAR.TELEPORT_YUKSEKLIK,
				0
			)

	else


		hedef +=
			sonuc.Normal
			*
			math.max(
				AYAR.TELEPORT_YUKSEKLIK,
				1
			)

	end


	local bakis =
		Govde.CFrame.LookVector


	local yatay =
		Vector3.new(
			bakis.X,
			0,
			bakis.Z
		)


	if yatay.Magnitude <
		0.001 then


		yatay =
			Vector3.new(
				0,
				0,
				-1
			)

	else

		yatay =
			yatay.Unit

	end


	Govde.AssemblyLinearVelocity =
		Vector3.zero


	Govde.AssemblyAngularVelocity =
		Vector3.zero


	Karakter:PivotTo(
		CFrame.lookAt(
			hedef,
			hedef + yatay
		)
	)


	Govde.AssemblyLinearVelocity =
		Vector3.zero


	Govde.AssemblyAngularVelocity =
		Vector3.zero


	BildirimGoster(
		"Teleport",
		"Teleport başarılı."
	)

end


