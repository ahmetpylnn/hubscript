local function AksiyonButonu(
	ebeveyn,
	yazi,
	geriCagirma,
	kirmizi
)

	local buton =
		NesneOlustur(
			"TextButton",
			ebeveyn,
			{
				Size =
					UDim2.new(
						1,
						0,
						0,
						39
					),

				BackgroundColor3 =
					kirmizi
					and
					Renk.KirmiziKoyu
					or
					Renk.Kart,

				BorderSizePixel =
					0,

				Text =
					yazi,

				TextColor3 =
					Renk.Beyaz,

				TextSize =
					9,

				Font =
					Enum.Font.GothamBold,

				AutoButtonColor =
					false,
			}
		)


	KoseEkle(
		buton,
		7
	)


	buton.MouseEnter:Connect(
		function()

			buton.BackgroundColor3 =
				kirmizi
				and
				Renk.Kirmizi
				or
				Renk.Kart2

		end
	)


	buton.MouseLeave:Connect(
		function()

			buton.BackgroundColor3 =
				kirmizi
				and
				Renk.KirmiziKoyu
				or
				Renk.Kart

		end
	)


	buton.Activated:Connect(
		function()

			if geriCagirma then

				geriCagirma()

			end

		end
	)


	return buton
end


