local function OyuncuListesiniGuncelle()

	for _, nesne in ipairs(
		OyuncuListesi:GetChildren()
	) do


		if not nesne:IsA(
			"UIListLayout"
		)
		and not nesne:IsA(
			"UIPadding"
		) then


			nesne:Destroy()

		end

	end


	local liste =
		Oyuncular:GetPlayers()


	table.sort(
		liste,
		function(
			a,
			b
		)

			return a.DisplayName:lower()
				<
				b.DisplayName:lower()

		end
	)


	local sayac =
		0


	for _, oyuncu in ipairs(
		liste
	) do


		if oyuncu ~=
			YerelOyuncu then


			sayac +=
				1


			local buton =
				NesneOlustur(
					"TextButton",
					OyuncuListesi,
					{
						Size =
							UDim2.new(
								1,
								0,
								0,
								34
							),

						BackgroundColor3 =
							Renk.Kart2,

						BorderSizePixel =
							0,

						Text =
							"",

						AutoButtonColor =
							false,
					}
				)


			KoseEkle(
				buton,
				6
			)


			local isim =
				YaziOlustur(
					buton,
					oyuncu.DisplayName,
					9,
					Renk.Beyaz,
					Enum.Font.GothamBold
				)


			isim.Position =
				UDim2.fromOffset(
					10,
					0
				)


			isim.Size =
				UDim2.new(
					1,
					-90,
					1,
					0
				)


			local sag =
				YaziOlustur(
					buton,
					"IŞINLAN",
					7,
					Renk.KirmiziAcik,
					Enum.Font.GothamBold
				)


			sag.Position =
				UDim2.new(
					1,
					-72,
					0,
					0
				)


			sag.Size =
				UDim2.fromOffset(
					62,
					34
				)


			sag.TextXAlignment =
				Enum.TextXAlignment.Right


			buton.MouseEnter:Connect(
				function()

					buton.BackgroundColor3 =
						Renk.KirmiziKoyu

				end
			)


			buton.MouseLeave:Connect(
				function()

					buton.BackgroundColor3 =
						Renk.Kart2

				end
			)


			buton.Activated:Connect(
				function()


					local hedefGovde =
						GovdeAl(
							oyuncu
						)


					if not hedefGovde then

						BildirimGoster(
							"Işınlan",
							"Bu oyuncunun karakteri hazır değil."
						)

						return
					end


					if Karakter then


						Karakter:PivotTo(
							CFrame.new(
								hedefGovde.Position
								+
								Vector3.new(
									0,
									3,
									0
								)
							)
						)


						if Govde then

							Govde.AssemblyLinearVelocity =
								Vector3.zero

							Govde.AssemblyAngularVelocity =
								Vector3.zero

						end


						BildirimGoster(
							"Işınlan",
							oyuncu.DisplayName
							..
							" oyuncusuna ışınlandın."
						)

					end

				end
			)

		end

	end


	if sayac ==
		0 then


		local bos =
			YaziOlustur(
				OyuncuListesi,
				"Başka oyuncu yok.",
				9,
				Renk.Gri,
				Enum.Font.GothamMedium
			)


		bos.Size =
			UDim2.new(
				1,
				0,
				0,
				34
			)


		bos.TextXAlignment =
			Enum.TextXAlignment.Center

	end

end


