local function GuvenliSil(nesne)

	if nesne then

		pcall(
			function()

				nesne:Destroy()

			end
		)

	end

end


local function Sinirla(
	deger,
	minimum,
	maksimum
)

	return math.clamp(
		deger,
		minimum,
		maksimum
	)

end


local function Yuvarla(
	deger
)

	return math.floor(
		deger + 0.5
	)

end


local function NesneOlustur(
	tur,
	ebeveyn,
	ayarlar
)

	local nesne =
		Instance.new(
			tur
		)

	for ad, deger in pairs(
		ayarlar or {}
	) do

		nesne[ad] =
			deger

	end

	if ebeveyn then

		nesne.Parent =
			ebeveyn

	end

	return nesne
end


local function KoseEkle(
	nesne,
	yariCap
)

	local kose =
		Instance.new(
			"UICorner"
		)

	kose.CornerRadius =
		UDim.new(
			0,
			yariCap or 8
		)

	kose.Parent =
		nesne

	return kose
end


local function KenarEkle(
	nesne,
	renk,
	kalinlik,
	seffaflik
)

	local kenar =
		Instance.new(
			"UIStroke"
		)

	kenar.Color =
		renk or Renk.Kenar

	kenar.Thickness =
		kalinlik or 1

	kenar.Transparency =
		seffaflik or 0

	kenar.Parent =
		nesne

	return kenar
end


local function YaziOlustur(
	ebeveyn,
	yazi,
	boyut,
	renk,
	font
)

	return NesneOlustur(
		"TextLabel",
		ebeveyn,
		{

			BackgroundTransparency = 1,

			Text =
				yazi or "",

			TextColor3 =
				renk or Renk.Beyaz,

			TextSize =
				boyut or 12,

			Font =
				font or
				Enum.Font.GothamMedium,

			TextXAlignment =
				Enum.TextXAlignment.Left,

			TextYAlignment =
				Enum.TextYAlignment.Center,

			BorderSizePixel = 0,
		}
	)

end


local function TweenUygula(
	nesne,
	sure,
	hedef
)

	if not nesne then
		return
	end

	if not AYAR.ANIMASYON then

		for ad, deger in pairs(
			hedef
		) do

			nesne[ad] =
				deger

		end

		return
	end


	local tween =
		Tween:Create(
			nesne,

			TweenInfo.new(
				sure or 0.15,
				Enum.EasingStyle.Quad,
				Enum.EasingDirection.Out
			),

			hedef
		)

	tween:Play()

	return tween
end


