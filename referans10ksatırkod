			end


			Goster(
				true
			)

		end
	)


	Goster(
		false
	)


	Kontroller[id] = {

		Tur =
			"Secim",

		Set =
			function(
				yeni,
				sessiz
			)

				for i,
					secenek in ipairs(
						secenekler
					) do


					if secenek ==
						yeni then


						indeks =
							i


						Goster(
							not sessiz
						)


						break

					end
				end

			end,

		Get =
			function()

				return secenekler[
					indeks
				]

			end,
	}


	return kart
end


