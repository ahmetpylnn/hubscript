	)


	local deger =
		baslangic


	local surukleniyor =
		false


	local function YuvarlaArtisa(
		sayi
	)

		if artis <= 0 then

			return sayi

		end


		local sonuc =
			math.round(
				sayi / artis
			)
			*
			artis


		return sonuc
	end


	local function DegeriGuncelle(
		yeni,
		cagir
	)

		deger =
			Sinirla(
				yeni,
				minimum,
				maksimum
			)


		deger =
			YuvarlaArtisa(
				deger
			)


		local oran =


			(
				deger -
				minimum
			)
			/
			(
				maksimum -
				minimum
			)


		oran =
			Sinirla(
				oran,
				0,
				1
			)


		dolgu.Size =
			UDim2.new(
				oran,
				0,
				1,
				0
			)


		top.Position =
			UDim2.new(
				oran,
				0,
				0.5,
				0
			)


		if math.abs(
			deger
		) < 0.001 then

			degerYazi.Text =
				"0"

		else

			degerYazi.Text =
				tostring(
					math.floor(
						deger * 100
					) / 100
				)

		end


		if cagir ~= false
			and geriCagirma then

			geriCagirma(
				deger
			)

		end

	end


	local function FareKonumundanDeger(
		x
	)

		local bas =
			bar.AbsolutePosition.X


		local uzunluk =
			bar.AbsoluteSize.X


		if uzunluk <= 0 then

			return
		end


		local oran =
			Sinirla(
				(
					x - bas
				)
				/
				uzunluk,
				0,
				1
			)


		local yeni =
			minimum +
			(
				maksimum -
				minimum
			)
			*
			oran


		DegeriGuncelle(
			yeni,
			true
		)


		if geriCagirma then

			geriCagirma(
				deger
			)

		end

	end


	bar.InputBegan:Connect(
		function(
			girdi
		)

			if
				girdi.UserInputType ==
					Enum.UserInputType.MouseButton1
				or
				girdi.UserInputType ==
					Enum.UserInputType.Touch
			then

				surukleniyor =
					true


				FareKonumundanDeger(
					girdi.Position.X
				)

			end

		end
	)


	Giris.InputChanged:Connect(
		function(
			girdi
		)

			if not surukleniyor then

				return
			end


			if
				girdi.UserInputType ~=
					Enum.UserInputType.MouseMovement
				and
				girdi.UserInputType ~=
					Enum.UserInputType.Touch
			then

				return
			end


			FareKonumundanDeger(
				girdi.Position.X
			)

		end
	)


	Giris.InputEnded:Connect(
		function(
			girdi
		)

			if
				girdi.UserInputType ==
					Enum.UserInputType.MouseButton1
				or
				girdi.UserInputType ==
					Enum.UserInputType.Touch
			then

				surukleniyor =
					false

			end

		end
	)


	DegeriGuncelle(
		deger,
		false
	)


	Kontroller[id] = {

		Tur =
			"Slider",

		Set =
			function(
				yeni,
				sessiz
			)

				DegeriGuncelle(
					yeni,
					not sessiz
				)

			end,

		Get =
			function()

				return deger

			end,
	}


	return kart
end


