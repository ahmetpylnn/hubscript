local function SayfaAc(
	ad
)

	if not Sayfalar[ad] then

		return
	end


	for sayfaAdi,
		sayfa in pairs(
			Sayfalar
		) do

		sayfa.Visible =
			(
				sayfaAdi ==
				ad
			)

	end


	for sekmeAdi,
		veri in pairs(
			Sekmeler
		) do

		local aktif =
			sekmeAdi ==
			ad


		veri.Cizgi.Visible =
			aktif


		TweenUygula(
			veri.Buton,
			0.12,
			{
				BackgroundColor3 =
					aktif
					and
					Renk.Kart
					or
					Renk.Panel
			}
		)


		TweenUygula(
			veri.Ikon,
			0.12,
			{
				TextColor3 =
					aktif
					and
					Renk.Beyaz
					or
					Renk.Gri
			}
		)


		TweenUygula(
			veri.Ad,
			0.12,
			{
				TextColor3 =
					aktif
					and
					Renk.Beyaz
					or
					Renk.Gri
			}
		)

	end


	MevcutSayfa =
		ad
end


