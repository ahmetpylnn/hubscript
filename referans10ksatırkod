			20
		)


	ok.TextXAlignment =
		Enum.TextXAlignment.Center


	local indeks =
		math.clamp(
			baslangic,
			1,
			#secenekler
		)


	local function Goster(
		cagir
	)

		degerYazi.Text =
			tostring(
				secenekler[
					indeks
				]
			)


		if cagir ~= false
			and geriCagirma then

			geriCagirma(
				secenekler[
					indeks
				]
			)

		end

	end


	buton.Activated:Connect(
		function()

			indeks +=
