-- MESAFE
--============================================================

local function MesafeAl(
	pozisyon
)

	if not Govde then
		return math.huge
	end


	return (
		Govde.Position -
		pozisyon
	).Magnitude
end


local function OyuncuMesafesiAl(
	oyuncu
)

	local hedefGovde =
		GovdeAl(
			oyuncu
		)

	if not hedefGovde
		or not Govde then

		return math.huge
	end


	return (
		Govde.Position -
		hedefGovde.Position
	).Magnitude
end


--============================================================
-- EKRAN MESAFESİ
--============================================================

local function EkranMerkeziAl()

	local kamera =
		Dunya.CurrentCamera

	if not kamera then
		return Vector2.zero
	end


	local inset =
		ArayuzHizmeti:GetGuiInset()


	return Vector2.new(
		inset.X +
			kamera.ViewportSize.X / 2,

		inset.Y +
			kamera.ViewportSize.Y / 2
	)
end


local function EkranMesafesiAl(
	parca
)

	local kamera =
		Dunya.CurrentCamera


	if not kamera
		or not parca then

		return math.huge,
			false
	end


	local ekranKonumu,
		ekranda =
		kamera:WorldToScreenPoint(
			parca.Position
		)


	if ekranKonumu.Z <= 0 then

		return math.huge,
			false
	end


	if not ekranda then

		return math.huge,
			false
	end


	local merkez =
		EkranMerkeziAl()


	local fark =
		(
			Vector2.new(
				ekranKonumu.X,
				ekranKonumu.Y
			)
			-
			merkez
		).Magnitude


	return fark,
		true
end


--============================================================
-- GÖRÜŞ KONTROLÜ
--============================================================

local function GorunurMu(
	oyuncu,
	parca
)

	if not AYAR.GORUS_KONTROLU then

		return true
	end


	local kamera =
		Dunya.CurrentCamera


	if not kamera
		or not parca then

		return false
	end


	local hedefKarakter =
		KarakterAl(
			oyuncu
		)


	if not hedefKarakter then

		return false
	end


	local yon =
		parca.Position -
		kamera.CFrame.Position


	if yon.Magnitude <=
		0.001 then

		return true
	end


	local parametre =
		RaycastParams.new()


	parametre.FilterType =
		Enum.RaycastFilterType.Exclude


	-- ÖNEMLİ:
	-- Eski sürümde hedef karakter de filtreleniyordu.
	-- Bu durumda ray hedefe ulaşmadan hedefi yok sayabiliyordu.
	--
	-- Artık yalnızca kendi karakterimizi hariç tutuyoruz.
	parametre.FilterDescendantsInstances = {

		Karakter,
	}


	parametre.IgnoreWater =
		true


	local sonuc =
		Dunya:Raycast(
			kamera.CFrame.Position,
			yon,
			parametre
		)


	if not sonuc then

